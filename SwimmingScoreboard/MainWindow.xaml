                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{DynamicResource Str_RC_PublishResult}" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Row="4" Grid.Column="1" Click="ShowSchedule_Click" Margin="2" BorderThickness="0" Cursor="Hand"
                                            ToolTip="{DynamicResource Str_RC_ShowScheduleTip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#0D9488" CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{DynamicResource Str_RC_ShowSchedule}" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- 图片 / 视频 -->
                                    <!-- Row 5: 图片/视频 / PPT 播放 (2026-06-25 用户要求合一行各占 1 列) -->
                                    <Button Grid.Row="5" Grid.Column="0" Click="ShowMedia_Click" Margin="2" BorderThickness="0" Cursor="Hand"
                                            ToolTip="{DynamicResource Str_RC_ShowMediaTip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#0EA5E9" CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{DynamicResource Str_RC_ShowMedia}" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Row="5" Grid.Column="1" Click="PlayPpt_Click" Margin="2" BorderThickness="0" Cursor="Hand"
                                            ToolTip="{DynamicResource Str_RC_PlayPptTip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#FB923C" CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE786;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{DynamicResource Str_RC_PlayPpt}" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- 2026-06-01 大屏样式远程控制: 底色 / 字号 / 9 处文字颜色字体 -->
                                    <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Click="OpenDisplayStyle_Click" Margin="2" BorderThickness="0" Cursor="Hand"
                                            ToolTip="{DynamicResource Str_RC_DisplayStyleTip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#7C3AED" CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{DynamicResource Str_RC_DisplayStyle}" FontSize="13" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- 2026-06-03 记录显示/隐藏: 切换 display.html 右上角 WR/CR 横条可见性.
                                         用 Button.Content (而不是 ControlTemplate) 装 StackPanel,
                                         这样 x:Name="RecordsHiddenBtnText" 在 code-behind 可访问 -->
                                    <!-- Row 7: 记录显示 / 显反应时 (2026-06-25 用户要求合一行, "备注: 显反应时" 去"备注: ") -->
                                    <Button Grid.Row="7" Grid.Column="0" x:Name="RecordsHiddenBtn" Click="ToggleRecordsHidden_Click" Margin="2" Padding="0" BorderThickness="0" Cursor="Hand" Background="Transparent"
                                            ToolTip="{DynamicResource Str_RC_RecordsHiddenTip}">
                                        <Border Background="#475569" CornerRadius="5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xED1A;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock x:Name="RecordsHiddenBtnText" Text="{DynamicResource Str_RC_RecordsShow}" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <!-- 2026-06-04 备注栏 是否显示 出发反应时 切换 (= display.html lane-row .remark 反应时窗口期内显示) -->
                                    <Button Grid.Row="7" Grid.Column="1" x:Name="RemarkReactionBtn" Click="ToggleRemarkReaction_Click" Margin="2" Padding="0" BorderThickness="0" Cursor="Hand" Background="Transparent"
                                            ToolTip="{DynamicResource Str_RC_RemarkReactionTip}">
                                        <Border Background="#475569" CornerRadius="5">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE91F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="RemarkReactionBtnText" Text="{DynamicResource Str_RC_RemarkReaction}" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2026-06-25 系统硬件区 v2 Card 化 (浅绿底 + Border), 紧凑 (RowDef 28) -->
                            <Border Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="8" Padding="10,8,10,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_RC_SystemHardware}" FontSize="14" FontWeight="Bold" Foreground="#065F46" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>
                                    <!-- 2026-05-14 连接按钮：硬件改走 TCP 网络连接（沿用既有 QuickConnect 控件名，
                                         保持代码绑定不变；按钮显示文字改为"网络连接"，Click 处理走 TCP） -->
                                    <Button x:Name="QuickConnectSerialButton" Grid.Row="0" Grid.Column="0" Content="{DynamicResource Str_RC_NetworkConnect}" Click="QuickConnectSerial_Click"
                                            Margin="2" BorderThickness="0" Cursor="Hand"
                                            ToolTip="{DynamicResource Str_RC_NetworkConnectTip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="QuickConnBorder" Background="#22C55E" CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock x:Name="QuickConnectSerialButtonText" Text="{DynamicResource Str_RC_NetworkConnect}" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- 2026-05-30 IsEnabled=false 时灰化 (Ready/Racing 状态用) -->
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="QuickConnBorder" Property="Background" Value="#94A3B8"/>
                                                        <Setter TargetName="QuickConnBorder" Property="Opacity" Value="0.5"/>
                                                        <Setter Property="Cursor" Value="No"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- 设备测试：触板/出发台/盲表全部打开，硬件来什么数据都接收并显示 -->
                                    <Button x:Name="DeviceTestButton" Grid.Row="0" Grid.Column="1" Content="{DynamicResource Str_RC_DeviceTest}" Click="DeviceTest_Click"
                                            Margin="2" BorderThickness="0" Cursor="Hand"
                                            ToolTip="{DynamicResource Str_RC_DeviceTestTip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="DeviceTestBorder" Background="#0EA5E9" CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock x:Name="DeviceTestButtonText" Text="{DynamicResource Str_RC_DeviceTest}" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- 2026-05-30 IsEnabled=false 时灰化 -->
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="DeviceTestBorder" Property="Background" Value="#94A3B8"/>
                                                        <Setter TargetName="DeviceTestBorder" Property="Opacity" Value="0.5"/>
                                                        <Setter Property="Cursor" Value="No"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                        <!-- 2026-06-19 电池电压已移到顶端状态栏 (内存右 / 硬件计时器左), 此处不再重复 -->
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ 成绩与排名 ═══ -->
            <TabItem Header="{DynamicResource Str_Tab_Results}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 2026-05-24 左侧 赛程导航 (3 级) -->
                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,8,0">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str_Results_NavTitle}" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                            <TextBox DockPanel.Dock="Top" x:Name="NavResultSearchBox" Padding="4" Margin="0,0,0,6"
                                     ToolTip="{DynamicResource Str_Results_NavSearchTip}"
                                     TextChanged="NavResultSearch_TextChanged"/>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button x:Name="NavResultFilterAll" Content="{DynamicResource Str_Results_FilterAll}" Click="NavResultFilter_Click" Tag="all" Padding="6,3" FontSize="11" Background="#1E40AF" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                                <Button Content="{DynamicResource Str_Results_FilterPending}" Click="NavResultFilter_Click" Tag="pending" Padding="6,3" FontSize="11" Background="#94A3B8" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                                <Button Content="{DynamicResource Str_Results_FilterRunning}" Click="NavResultFilter_Click" Tag="running" Padding="6,3" FontSize="11" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                                <Button Content="{DynamicResource Str_Results_FilterDone}" Click="NavResultFilter_Click" Tag="done" Padding="6,3" FontSize="11" Background="#22C55E" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                                <Button Content="{DynamicResource Str_Results_FilterCancelled}" Click="NavResultFilter_Click" Tag="cancelled" Padding="6,3" FontSize="11" Background="#EF4444" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                            </WrapPanel>
                            <TreeView x:Name="NavResultTree" BorderThickness="0" SelectedItemChanged="NavResultTree_Selected"/>
                        </DockPanel>
                    </Border>
                    <!-- 2026-09-29 现场反馈: "晋级处理"起的8个按键跟筛选条件挤在同一行, 右边被裁掉显示不全。
                         拆成独立一行放最上面。
                         2026-09-29(续) 固定 Width=110×8 在较窄屏幕上最后一个"个人排名"按键还是被裁——
                         跟赛程管理页顶部按钮同一个坑(见 bc0f099), 同样改成 UniformGrid 按实际可用宽度
                         平均分配 8 列, 不再猜固定像素数; 原来分隔业务操作/报表查询两组的竖线分隔符
                         删掉(UniformGrid 8 等分列容不下它, 影响不大)。 -->
                    <UniformGrid Grid.Row="0" Grid.Column="1" Rows="1" Columns="8" Margin="0,0,0,8">
                        <Button Content="{DynamicResource Str_Results_Promotion}" Click="Promotion_Click" Padding="6,4" Margin="0,0,6,0"
                                Background="#8B5CF6" Foreground="White" BorderThickness="0"/>
                        <Button Content="{DynamicResource Str_Results_TeamScore}" Click="CalcTeamScore_Click" Padding="6,4" Margin="0,0,6,0"
                                Background="#22C55E" Foreground="White" BorderThickness="0"/>
                        <Button Content="{DynamicResource Str_Results_ViewRawData}" Click="ViewRawData_Click" Padding="6,4" Margin="0,0,6,0"
                                Background="#64748B" Foreground="White" BorderThickness="0"/>
                        <Button Content="{DynamicResource Str_Results_ChiefJudgeOverride}" Click="ChiefJudgeOverride_Click" Padding="6,4" Margin="0,0,6,0"
                                Background="#DC2626" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                ToolTip="{DynamicResource Str_Results_ChiefJudgeOverrideTip}"/>
                        <Button Content="{DynamicResource Str_Results_FinalsStatus}" Click="FinalsStatus_Click" Padding="6,4" Margin="0,0,6,0"
                                Background="#0EA5E9" Foreground="White" BorderThickness="0"
                                ToolTip="{DynamicResource Str_Results_FinalsStatusTip}"/>
                        <Button Content="{DynamicResource Str_Results_EventTop8}" Click="EventTop8_Click" Padding="6,4" Margin="0,0,6,0"
                                Background="#0EA5E9" Foreground="White" BorderThickness="0"
                                ToolTip="{DynamicResource Str_Results_EventTop8Tip}"/>
                        <Button Content="{DynamicResource Str_Results_DeptBulletin}" Click="DepartmentBulletin_Click" Padding="6,4" Margin="0,0,6,0"
                                Background="#0EA5E9" Foreground="White" BorderThickness="0"
                                ToolTip="{DynamicResource Str_Results_DeptBulletinTip}"/>
                        <Button Content="{DynamicResource Str_Results_IndividualRanking}" Click="IndividualRanking_Click" Padding="6,4"
                                Background="#0EA5E9" Foreground="White" BorderThickness="0"
                                ToolTip="{DynamicResource Str_Results_IndividualRankingTip}"/>
                    </UniformGrid>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Str_Results_AgeGroup}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="ResultAgeGroupCombo" Width="90" Margin="0,0,8,0" SelectionChanged="ResultAgeGroup_Changed"
                                  ToolTip="{DynamicResource Str_Results_AgeGroupTip}"/>
                        <TextBlock Text="{DynamicResource Str_Results_Gender}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <!-- 2026-09-21 男/女/混合 不翻译——UpdateResultHeatCombo 等处按这几个字面量做筛选，见 Localization.cs 里的说明 -->
                        <ComboBox x:Name="ResultGenderCombo" Width="70" SelectionChanged="ResultGender_Changed">
                            <ComboBoxItem Tag="男" Content="{DynamicResource Str_Gender_Male}" IsSelected="True"/>
                            <ComboBoxItem Tag="女" Content="{DynamicResource Str_Gender_Female}"/>
                            <ComboBoxItem Tag="混合" Content="{DynamicResource Str_Gender_Mixed}"/>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource Str_Results_Event}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <ComboBox x:Name="ResultEventCombo" Width="200" SelectionChanged="ResultEvent_Changed"/>
                        <TextBlock Text="{DynamicResource Str_Results_Stage}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <!-- 2026-09-21 预赛/半决赛/决赛 同样不翻译，理由同上 -->
                        <ComboBox x:Name="ResultStageCombo" Width="80" SelectionChanged="ResultStage_Changed">
                            <ComboBoxItem Content="预赛" IsSelected="True"/>
                            <ComboBoxItem Content="半决赛"/>
                            <ComboBoxItem Content="决赛"/>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource Str_Results_Heat}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <!-- 2026-09-21 这个初始项一开出来就会被 UpdateResultHeatCombo() 整体重建覆盖掉(含"全部"字样)，
                             C# 里同样拿它的 Content.ToString() 做筛选比较，不翻译 -->
                        <ComboBox x:Name="ResultHeatCombo" Width="60" SelectionChanged="ResultHeat_Changed">
                            <ComboBoxItem Content="{DynamicResource Str_Common_All}" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>
                    <!-- 姓名列 / 反应时间列加宽并允许换行：接力赛"姓名"为 4 名队员（逗号分隔），
                         "反应时间"按棒展开为"第1棒:0.45 第2棒:0.30 ..."；列宽不够时 TextWrapping 自动换行 -->
                    <DataGrid x:Name="ResultGrid" Grid.Row="2" Grid.Column="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" AlternatingRowBackground="#F8FAFC">
                        <!-- 2026-09-02 单元格和表头一律居中。
                             BasedOn 指向主题默认样式 —— 不加它就等于把 DataGridCell 的默认
                             样式整个换掉, 选中高亮、焦点框这些都会跟着没。 -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <!-- 2026-09-03 号码移到组别左边(见下), 列序: 名次 道 姓名 代表队 号码 组别 组数 最终成绩 … -->
                            <!-- 2026-09-21 DataGridColumn.Header 不是 FrameworkElement，不接受活的 DynamicResource
                                 通知，直接 Header="{DynamicResource ...}" 只会在首次构造时解析一次、之后卡死——
                                 全部改成 Header 里塞一个 TextBlock，语言切换才能跟着刷新(384d37d 已踩过这个坑)。 -->
                            <DataGridTextColumn Binding="{Binding Rank}" Width="50" ElementStyle="{StaticResource CellCenter}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColRank}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Lane}" Width="40" ElementStyle="{StaticResource CellCenter}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColLane}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="220">
                                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColName}"/></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- 换行的多行文本还要 TextAlignment, 单靠单元格居中只会把整块文字居中 -->
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Padding="4,3" TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Country}" Width="100" ElementStyle="{StaticResource CellCenter}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColCountry}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <!-- 2026-09-03 号码贴在组别左边(与"项目成绩"同款) -->
                            <DataGridTextColumn Binding="{Binding BibNumber}" Width="60" ElementStyle="{StaticResource CellCenter}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColBib}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <!-- 2026-09-02 组别/组数放最终成绩左边, 成绩差放右边 (与"项目成绩"同款) -->
                            <DataGridTextColumn Binding="{Binding AgeGroup}" Width="70" ElementStyle="{StaticResource CellCenter}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColAgeGroup}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding HeatText}" Width="60" ElementStyle="{StaticResource CellCenter}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColHeatText}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding FinalTime}" Width="80" ElementStyle="{StaticResource CellCenter}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColFinalTime}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Diff}" Width="70" ElementStyle="{StaticResource CellCenter}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColDiff}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TimingSource}" Width="60" ElementStyle="{StaticResource CellCenter}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColSource}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="170">
                                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColReaction}"/></DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ReactionTime}" TextWrapping="Wrap" Padding="4,3" TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Status}" Width="50" ElementStyle="{StaticResource CellCenter}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColStatus}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding RecordNote}" Width="80" ElementStyle="{StaticResource CellCenter}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColRecord}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═══ 文档编辑 / 输出 / 打印 ═══ -->
            <TabItem Header="{DynamicResource Str_Tab_Docs}">
                <TabItem.Resources>
                    <!-- 输出文档卡片中两种统一按钮：编辑 / 输出 -->
                    <Style x:Key="DocActionBtn" TargetType="Button">
                        <Setter Property="Padding" Value="14,7"/>
                        <Setter Property="Margin" Value="6,0,0,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="MinWidth" Value="78"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                    <Style x:Key="DocCardBorder" TargetType="Border">
                        <Setter Property="Background" Value="#FAFBFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="Width" Value="300"/>
                    </Style>
                    <Style x:Key="DocTitle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                    </Style>
                    <Style x:Key="DocSub" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="Margin" Value="0,3,0,8"/>
                    </Style>
                </TabItem.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <!-- 标题 + 说明 -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Str_Docs_PageTitle}" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"
                                       Text="{DynamicResource Str_Docs_Intro}"/>
                        </StackPanel>

                        <!-- ═══ 一、赛前文档 ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_Docs_Section1}" FontSize="15" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_ProgramBook_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_ProgramBook_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnEdit}" Click="EditProgramBook_Click" Background="#7C3AED" Style="{StaticResource DocActionBtn}"/>
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="PrintManual_Click" Background="#2563EB" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_Schedule_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_Schedule_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="PrintSchedule_Click" Background="#3B82F6" Style="{StaticResource DocActionBtn}"/>
                                                <Button Content="{DynamicResource Str_Docs_BtnExportExcel}" Click="ExportScheduleExcel_Click" Background="#16A34A" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- 2026-06-21 分组表卡片: 网格式 (项目 → 组号×道次, cell=姓名+代表队), 参照 2026甘肃群众组-秩序单.xls 同款 -->
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_HeatAssign_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_HeatAssign_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="PrintHeatAssignments_Click" Background="#0EA5E9" Style="{StaticResource DocActionBtn}"/>
                                                <Button Content="{DynamicResource Str_Docs_BtnExportExcel}" Click="ExportHeatAssignmentsGridExcel_Click" Background="#16A34A" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_StartList_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_StartList_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="PrintStartList_Click" Background="#1D4ED8" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 二、比赛成绩 ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_Docs_Section2}" FontSize="15" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_ResultBook_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_ResultBook_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnEdit}" Click="EditResultBook_Click" Background="#B45309" Style="{StaticResource DocActionBtn}"/>
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="PrintFullResultBook_Click" Background="#047857" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- "分组成绩"原"输出/打印"按钮已迁移至"比赛控制"Tab"确认本组成绩"下方的"打印成绩"按钮 -->
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_EventResults_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_EventResults_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="PrintEventResults_Click" Background="#10B981" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- 2026-06-02 按组别批量公布: 选项目+性别+赛次, 一键输出该项目下所有组别的成绩单 (含完整 5+1 操作按钮) -->
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_BatchByAgeGroup_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_BatchByAgeGroup_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="BatchByAgeGroupPrint_Click" Background="#EA580C" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_SplitReport_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_SplitReport_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="PrintSplitTimeReport_Click" Background="#34D399" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- 2026-06-04 成绩 txt 输出: 按 场号-项号-组号.txt 命名, 道次行 (LL final 8段 4反应), 10 道全显示 -->
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_ResultTxt_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_ResultTxt_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnExport}" Click="ExportResultTxt_Click" Background="#0EA5E9" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 三、排名与纪录 ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_Docs_Section3}" FontSize="15" FontWeight="Bold" Foreground="#D97706" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_TeamStandings_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_TeamStandings_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="PrintTeamStandings_Click" Background="#D97706" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_RecordReport_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_RecordReport_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="PrintRecordReport_Click" Background="#F59E0B" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 四、证书与奖状 ═══ -->
                        <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_Docs_Section4}" FontSize="15" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_AwardCert_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_AwardCert_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="PrintAwardCertificate_Click" Background="#DC2626" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DocCardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Docs_RecordCert_Title}" Style="{StaticResource DocTitle}"/>
                                            <TextBlock Style="{StaticResource DocSub}"
                                                       Text="{DynamicResource Str_Docs_RecordCert_Desc}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_Docs_BtnPrint}" Click="PrintRecordCertificate_Click" Background="#E11D48" Style="{StaticResource DocActionBtn}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 帮助提示 -->
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="12" Margin="0,0,0,4" BorderBrush="#BFDBFE" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,4" Text="{DynamicResource Str_Docs_FormatNoteTitle}"/>
                                <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap">
                                    <Run Text="{DynamicResource Str_Docs_FormatNoteIntro}"/>
                                    <LineBreak/>
                                    <Run Text="&#x00B7; "/><Run Text="{DynamicResource Str_Docs_FormatPdfLabel}" FontWeight="Bold"/><Run Text="{DynamicResource Str_Docs_FormatPdfDesc}"/>
                                    <LineBreak/>
                                    <Run Text="&#x00B7; "/><Run Text="{DynamicResource Str_Docs_FormatDocLabel}" FontWeight="Bold"/><Run Text="{DynamicResource Str_Docs_FormatDocDesc}"/>
                                    <LineBreak/>
                                    <Run Text="&#x00B7; "/><Run Text="{DynamicResource Str_Docs_FormatHtmlLabel}" FontWeight="Bold"/><Run Text="{DynamicResource Str_Docs_FormatHtmlDesc}"/>
                                    <LineBreak/>
                                    <Run Text="&#x00B7; "/><Run Text="{DynamicResource Str_Docs_FormatPrintLabel}" FontWeight="Bold"/><Run Text="{DynamicResource Str_Docs_FormatPrintDesc}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ 系统日志与数据 ═══ -->
            <TabItem Header="{DynamicResource Str_Tab_SystemLog}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：运行日志 -->
                    <GroupBox>
                        <GroupBox.Header>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{DynamicResource Str_SysLog_RunLog}" VerticalAlignment="Center"/>
                                <!-- 2026-09-17 用户要"把运行日志存成文件方便拷给你分析"——界面这个列表
                                     只留最近 300 行(带虚拟化), AddLog 早就同步落盘到 Logs\yyyyMMdd.log,
                                     但那个路径藏在安装目录里, 现场遇到问题时没人会去翻。加这个按钮把
                                     最近几天的日志文件直接拼成一份, 弹保存对话框让用户自己选地方存,
                                     不用再教人怎么找安装目录。 -->
                                <Button x:Name="ExportLogBtn" Content="{DynamicResource Str_SysLog_ExportLog}" Click="ExportLog_Click"
                                        DockPanel.Dock="Right" Padding="10,2" Margin="16,0,0,0"/>
                            </DockPanel>
                        </GroupBox.Header>
                        <!-- 2026-09-21 SystemLogListBox 显示的正文是 AddLog(...) 生成的中文日志行，
                             全应用约750+处调用点，是单独一个更大阶段的工作，这次不碰。 -->
                        <ListBox x:Name="SystemLogListBox" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>

                    <!-- 右侧：存档管理 -->
                    <GroupBox Grid.Column="1" Margin="10,0,0,0">
                        <GroupBox.Header>
                            <TextBlock Text="{DynamicResource Str_SysLog_ArchiveMgmt}"/>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ListBox x:Name="BackupListBox" Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#1E40AF"/>
                                            <TextBlock Text="{Binding LastModified}" FontSize="11" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="1">
                                <Button Content="{DynamicResource Str_SysLog_LoadBackup}" Click="LoadBackup_Click" Padding="10" FontSize="14"
                                        Background="#22C55E" Foreground="White" BorderThickness="0" Margin="0,0,0,5"/>
                                <Button Content="{DynamicResource Str_SysLog_DeleteBackup}" Click="DeleteBackup_Click" Padding="10" FontSize="14"
                                        Background="#EF4444" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/>
                                <Button Content="{DynamicResource Str_SysLog_ClearDb}" Click="ClearDatabase_Click" Padding="10" FontSize="14"
                                        Background="#7F1D1D" Foreground="White" BorderThickness="0" Margin="0,0,0,5"/>
                                <Button Content="{DynamicResource Str_SysLog_ClearRecords}" Click="ClearAllRecords_Click" Padding="10" FontSize="14"
                                        Background="#DC2626" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/>
                                <Button Content="{DynamicResource Str_SysLog_ForceSave}" Click="ForceSave_Click" Padding="10" FontSize="14"
                                        Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,0,5"/>
                                <Separator Margin="0,5,0,5"/>
                                <Button Content="{DynamicResource Str_SysLog_ShowIP}" Click="ShowLocalIP_Click" Padding="10" FontSize="14"
                                        Background="#0EA5E9" Foreground="White" BorderThickness="0" Margin="0,0,0,5"/>
                                <Button Content="{DynamicResource Str_SysLog_ChangePassword}" Click="ChangePassword_Click" Padding="10" FontSize="14"
                                        Background="#475569" Foreground="White" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ═══ 设置 ═══ -->
            <TabItem Header="{DynamicResource Str_Tab_Settings}">
                <ScrollViewer Margin="10">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource Str_Settings_TimingHw}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <!-- 2026-10-08 状态行改 Auto 高度: 英文的连接失败提示(例如
                                     "TCP connection failed: No connection could be made
                                     because the target machine actively refused it")比中文
                                     长得多, 固定 36 高 + 不换行会被右边的 Disconnect 按钮截断
                                     看不全(用户截图发现)。配合下面 TimingStatusText 加
                                     TextWrapping="Wrap", 这一行按内容自动撑高。 -->
                                <RowDefinition Height="Auto" MinHeight="36"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Settings_SerialPort}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="ComPortCombo" Width="120" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Str_Settings_BaudRate}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                <ComboBox x:Name="BaudRateCombo" Width="90" VerticalAlignment="Center" SelectionChanged="BaudRate_Changed">
                                    <ComboBoxItem Content="9600" IsSelected="True"/>
                                    <ComboBoxItem Content="19200"/>
                                    <ComboBoxItem Content="38400"/>
                                    <ComboBoxItem Content="57600"/>
                                    <ComboBoxItem Content="115200"/>
                                </ComboBox>
                            </StackPanel>
                            <Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource Str_Settings_ConnectSerial}" Click="ConnectSerial_Click" Padding="12,4" Margin="8,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_Settings_TcpAddr}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TcpHostBox" Grid.Row="1" Grid.Column="1" Text="127.0.0.1:5000" Padding="4" VerticalAlignment="Center"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource Str_Settings_ConnectTcp}" Click="ConnectTcp_Click" Padding="12,4" Margin="8,0,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_Settings_UdpRecvPort}" VerticalAlignment="Center"/>
                            <TextBox x:Name="UdpPortBox" Grid.Row="2" Grid.Column="1" Text="5001" Padding="4" VerticalAlignment="Center"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource Str_Settings_ListenUdp}" Click="ConnectUdp_Click" Padding="12,4" Margin="8,0,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Str_Settings_UdpSend}" VerticalAlignment="Center"/>
                            <TextBox x:Name="UdpSendBox" Grid.Row="3" Grid.Column="1" Text="127.0.0.1:5002" Padding="4" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Str_Settings_Status}" VerticalAlignment="Center" Margin="0,6,0,6"/>
                            <TextBlock x:Name="TimingStatusText" Grid.Row="4" Grid.Column="1" Text="{DynamicResource Str_Settings_NotConnected}" VerticalAlignment="Center" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,6,8,6"/>
                            <Button x:Name="DisconnectTimingButton" Grid.Row="4" Grid.Column="2" Content="{DynamicResource Str_Settings_Disconnect}" Click="DisconnectTiming_Click" Padding="12,4" Margin="8,6,0,6" VerticalAlignment="Top"/>
                        </Grid>

                        <TextBlock Text="{DynamicResource Str_Settings_ChiefJudge}" FontSize="16" FontWeight="Bold" Margin="0,24,0,10"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,8"
                                   Text="{DynamicResource Str_Settings_ChiefJudgeDesc}"/>
                        <Button Content="{DynamicResource Str_Settings_ChiefJudgeBtn}" Click="ChiefJudgePassword_Click" HorizontalAlignment="Left"
                                Padding="16,8" Background="#DC2626" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

                        <TextBlock Text="{DynamicResource Str_Settings_Language}" FontSize="16" FontWeight="Bold" Margin="0,24,0,10"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,8"
                                   Text="{DynamicResource Str_Settings_LanguageDesc}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="中文 / English" Click="LanguageToggle_Click" HorizontalAlignment="Left"
                                    Padding="16,8" Background="#1E40AF" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                            <TextBlock x:Name="LanguageCurrentText" Text="{DynamicResource Str_Settings_LanguageCurrent}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
