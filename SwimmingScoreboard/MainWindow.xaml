                                            <Button x:Name="NavSchedFilterAll" Content="{DynamicResource Str_Common_All}" Click="NavSchedFilter_Click" Tag="all" Padding="6,3" FontSize="11" Background="#1E40AF" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                                            <Button Content="{DynamicResource Str_EM_NavPending}" Click="NavSchedFilter_Click" Tag="pending" Padding="6,3" FontSize="11" Background="#94A3B8" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                                            <Button Content="{DynamicResource Str_EM_NavRunning}" Click="NavSchedFilter_Click" Tag="running" Padding="6,3" FontSize="11" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                                            <Button Content="{DynamicResource Str_EM_NavDone}" Click="NavSchedFilter_Click" Tag="done" Padding="6,3" FontSize="11" Background="#22C55E" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                                            <Button Content="{DynamicResource Str_EM_NavCancelled}" Click="NavSchedFilter_Click" Tag="cancelled" Padding="6,3" FontSize="11" Background="#EF4444" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
