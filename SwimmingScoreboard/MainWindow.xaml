                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,8,0">
                                    <DockPanel Margin="8">
                                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str_EM_ScheduleNav}" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                                        <TextBox DockPanel.Dock="Top" x:Name="NavSchedSearchBox" Padding="4" Margin="0,0,0,6"
