<Window x:Class="SwimmingScoreboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SwimmingScoreboard"
        Title="{DynamicResource Str_AppTitle_Main}" Width="1400" Height="820"
        WindowState="Maximized" Background="#F1F5F9"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 2026-10-05 只读表格里直接展示 Gender 字段的列(SwimmerGrid)——中文模式下这就是
             原文, English模式下用它转成 Men/Women/Mixed。只读态可以用纯 OneWay 转换器
             (不用处理 ConvertBack); 可编辑的表格(如 RecordGrid)暂时没有动这个, 那边改一个
             字段要连带处理双向转换, 风险更大, 留到下一轮单独处理。 -->
        <local:GenderDisplayConverter x:Key="GenderConv"/>
        <!-- 2026-09-03 表格单元格内容居中。
             注意: 光在 DataGrid.CellStyle 上设 HorizontalContentAlignment 是【没用】的 ——
             DataGridCell 的默认模板里那个 ContentPresenter 根本没把对齐绑到
             HorizontalContentAlignment 上。文本列必须走 ElementStyle 才生效。 -->
        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部状态栏 -->
        <Border Grid.Row="0" Background="#1E293B" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Str_Status_ServiceRunning}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 2026-10-06 现场反馈: RTC 模式下这段描述文字 English 比中文原文长不少, 顶部这栏
                     宽度不够时原来直接硬裁("...relays through..."被齐齐切成"...rela"), 跟右边
                     "Memory:" 文字紧贴在一起, 看着像拼接出错。加 TextTrimming 至少裁出省略号,
                     不再是生硬断词。 -->
                <TextBlock x:Name="ServerAddressText" Grid.Column="1" Foreground="#94A3B8" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!--2026-06-08 内存监控显示: Working Set MB + Gen2 GC 次数. 长跑下若 MB 持续涨 = 有泄漏-->
                    <TextBlock Text="{DynamicResource Str_Status_MemoryColon}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MemoryStatusText" Text="-" Foreground="#22C55E" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <!--2026-06-20 释放内存按钮: 强制 GC + LOH 紧凑, 大堆下可能卡 1-2s-->
                    <Button Content="{DynamicResource Str_Btn_ReleaseMemory}" Click="ReleaseMemory_Click" FontSize="11" Foreground="White" Background="#0EA5E9" BorderThickness="0" Padding="6,2" Margin="0,0,16,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="{DynamicResource Str_Tooltip_ReleaseMemory}"/>
                    <!--2026-06-19 电池电压从"比赛控制 → 计时硬件连接"右下角移到顶端 (内存右 / 硬件计时器左)-->
                    <TextBlock x:Name="BatteryLabel" Text="{DynamicResource Str_Status_BatteryColon}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BatteryVoltageText" Text="—" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <!--2026-05-19 顶部右侧加硬件计时器连接状态：红=未连/绿=已连，颜色醒目-->
                    <Ellipse x:Name="HwConnDot" Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HwTimerLabel" Text="{DynamicResource Str_Status_HwTimerColon}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HwConnStatusText" Text="{DynamicResource Str_HwConn_NotConnected}" Foreground="#EF4444" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="ControlModeLabel" Text="{DynamicResource Str_Status_ControlModeColon}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ControlModeText" Text="{DynamicResource Str_ScoringMode_Local}" Foreground="#22C55E" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 标签页 -->
        <TabControl Grid.Row="1" Margin="8" x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">

            <!-- ═══ 系统状态 ═══ -->
            <TabItem Header="{DynamicResource Str_Tab_SystemStatus}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 当前比赛信息 -->
                    <Border Grid.Column="0" Grid.Row="0" CornerRadius="10" Padding="20" Margin="0,0,12,12"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#F0F7FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="#3B82F6" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Str_Status_CurrentEventHeader}" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Status_EventColon}" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CurrentEventText" Grid.Row="0" Grid.Column="1" Text="-" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Str_Status_StageColon}" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CurrentStageText" Grid.Row="0" Grid.Column="3" Text="-" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_Status_HeatColon}" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CurrentHeatText" Grid.Row="1" Grid.Column="1" Text="-" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource Str_Status_StateColon}" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RaceStateText" Grid.Row="1" Grid.Column="3" Text="{DynamicResource Str_RC_StateWaiting}" FontSize="16" FontWeight="Bold" Background="#3B82F6" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="10,3,10,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_Status_ModeColon}" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CompModeText" Grid.Row="2" Grid.Column="1" Text="{DynamicResource Str_CompMode_Domestic}" FontSize="15" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource Str_Status_PoolColon}" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PoolInfoText" Grid.Row="2" Grid.Column="3" Text="50米 10道" FontSize="15" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 连接状态 -->
                    <Border Grid.Column="1" Grid.Row="0" CornerRadius="10" Padding="20" Margin="0,0,0,12"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#F0FFF4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="#059669" CornerRadius="4" Padding="6,3" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Str_Status_ConnStatusHeader}" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Str_Status_ConnDisplay}" FontSize="14" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DisplayConnText" Grid.Row="0" Grid.Column="2" Text="0" FontSize="15" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                <!-- 2026-09-14 显示控制端(control.html / RemoteDisplayControl.exe) 单独一行 ——
                                     它是"遥控大屏放什么"的操作端, 跟上面"大屏显示"(真正在放内容的那块屏)是两码事,
                                     原来俩连上来都不报身份, 混在没人管的连接里, 面板上完全看不出来。
                                     图标沿用大屏显示同款(都是屏幕), 颜色改成"显示控制区"同款紫 #6B21A8 以示区分。 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#6B21A8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Str_Status_ConnDisplayControl}" FontSize="14" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DisplayControlConnText" Grid.Row="1" Grid.Column="2" Text="0" FontSize="15" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#8B5CF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Str_Status_ConnLeaderboard}" FontSize="14" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LeaderboardConnText" Grid.Row="2" Grid.Column="2" Text="0" FontSize="15" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Str_Status_ConnRegister}" FontSize="14" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RegisterConnText" Grid.Row="3" Grid.Column="2" Text="0" FontSize="15" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                <!-- 2026-10-10 检录台(checkin.html) 单独一行计数——2026-09-14 那批补的时候漏了它,
                                     跟信息查询一样早有身份标记(CHECKIN_IDENTITY)，面板上一直看不出检录台连没连 -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#0EA5E9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Str_Status_ConnCheckin}" FontSize="14" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CheckinConnText" Grid.Row="4" Grid.Column="2" Text="0" FontSize="15" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                <!-- 2026-09-14 信息查询终端(query.html) 单独一行计数, 原来混在"编排端"里数不出来 -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#0D9488" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{DynamicResource Str_Status_ConnQuery}" FontSize="14" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QueryConnText" Grid.Row="5" Grid.Column="2" Text="0" FontSize="15" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                <!-- 2026-09-15 编排端(ScheduleEditor.exe, "编排记录及成绩处理")单独一行计数,
                                     原来跟"信息查询"一样混在"编排端"连接里数不出来 -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7C3AED" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{DynamicResource Str_Status_ConnScheduleEditor}" FontSize="14" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScheduleEditorConnText" Grid.Row="6" Grid.Column="2" Text="0" FontSize="15" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{DynamicResource Str_Status_ConnTimingExe}" FontSize="14" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TimingExeConnText" Grid.Row="7" Grid.Column="2" Text="0" FontSize="15" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{DynamicResource Str_Status_ConnTimingWeb}" FontSize="14" Foreground="#475569" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TimingWebConnText" Grid.Row="8" Grid.Column="2" Text="0" FontSize="15" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="&#xE964;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{DynamicResource Str_Status_ConnTimingHw}" FontSize="14" Foreground="#475569" VerticalAlignment="Center"/>
                                <!-- 2026-09-14 字号比其它计数小一档(13): 这一格现在显示"本机/远程 (机器名)",
                                     比单个数字长不少, 字号跟着降一点免得跟左边标签挤在一起 -->
                                <TextBlock x:Name="TimingHwConnText" Grid.Row="9" Grid.Column="2" Text="{DynamicResource Str_HwConn_NotConnected}" FontSize="13" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>
            </TabItem>

            <!-- ═══ 赛事管理与报名 ═══ -->
            <TabItem Header="{DynamicResource Str_Tab_EventMgmt}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- 2026-09-13 右侧"运动员注册"只在 运动员管理 / 接力队管理 两页用得上,
                             其余页(赛事概览/赛程管理/出场编排微调/比赛参数设置管理/记录管理)
                             把它收起来, 宽度一并归零 —— 否则左边表格右侧留一条 400 像素的空白。
                             见 UpdateAthleteRegPanelVisibility()。 -->
                        <ColumnDefinition x:Name="AthleteRegColumn" Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：赛事信息 + 运动员列表 -->
                    <TabControl x:Name="MeetMgmtTabs" Grid.Column="0" Margin="0,0,10,0"
                                SelectionChanged="MeetMgmtTabs_SelectionChanged">
                        <TabItem Header="{DynamicResource Str_EM_Tab_Overview}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16">
                                    <!-- 赛事基本信息卡片 -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource Str_EM_BasicInfo}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- 2026-05-26 加 2 列以便 技术代表/仲裁委员/总裁判长 排同一行 -->
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_EM_EventName}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <TextBox x:Name="CompNameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5" Padding="4" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_EM_CompMode}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <ComboBox x:Name="CompModeCombo" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0">
                                                    <ComboBoxItem Content="{DynamicResource Str_EM_ModeDomestic}"/>
                                                    <ComboBoxItem Content="{DynamicResource Str_EM_ModeIntl}"/>
                                                </ComboBox>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource Str_EM_PoolLength}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <ComboBox x:Name="PoolLengthCombo" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" SelectedIndex="0">
                                                    <ComboBoxItem Content="{DynamicResource Str_EM_Pool50}"/>
                                                    <ComboBoxItem Content="{DynamicResource Str_EM_Pool25}"/>
                                                </ComboBox>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_EM_LaneCount}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <ComboBox x:Name="LaneCountCombo" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0">
                                                    <ComboBoxItem Content="{DynamicResource Str_EM_Lanes10}"/>
                                                    <ComboBoxItem Content="{DynamicResource Str_EM_Lanes8}"/>
                                                    <ComboBoxItem Content="{DynamicResource Str_EM_Lanes6}"/>
                                                </ComboBox>
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Str_EM_StartDate}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <DatePicker x:Name="StartDatePicker" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"
                                                            Language="en-CA" SelectedDateFormat="Short"/>
                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{DynamicResource Str_EM_EndDate}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <DatePicker x:Name="EndDatePicker" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center"
                                                            Language="en-CA" SelectedDateFormat="Short"/>
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Str_EM_Location}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <TextBox x:Name="LocationBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="5" Padding="4" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Str_EM_Organizer}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <TextBox x:Name="OrganizerBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="5" Padding="4" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Str_EM_Host}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <TextBox x:Name="HostBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="5" Padding="4" VerticalAlignment="Center"/>
                                                <!-- 2026-05-26 同一行排 技术代表 / 仲裁委员 / 总裁判长 (原第 8 行 含编排长 整行删除) -->
                                                <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource Str_EM_TechDelegate}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <TextBox x:Name="TechDelegateBox" Grid.Row="7" Grid.Column="1" Padding="4" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="7" Grid.Column="2" Text="{DynamicResource Str_EM_Arbiter}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <TextBox x:Name="ArbiterBox" Grid.Row="7" Grid.Column="3" Padding="4" VerticalAlignment="Center"
                                                         ToolTip="{DynamicResource Str_EM_CommaSepTip}"/>
                                                <TextBlock Grid.Row="7" Grid.Column="4" Text="{DynamicResource Str_EM_ChiefReferee}" VerticalAlignment="Center" Foreground="#475569"/>
                                                <TextBox x:Name="RefereeBox" Grid.Row="7" Grid.Column="5" Padding="4" VerticalAlignment="Center"/>
                                                <!-- 2026-05-26 编排长字段已从 UI 删除. ChiefJudgeBox 保留为隐藏控件以兼容现有 .csproj / .cs 引用 (保存/加载/秩序册/封面签字栏等仍读它); 数据=空字符串 -->
                                                <TextBox x:Name="ChiefJudgeBox" Grid.Row="7" Width="0" Height="0" Visibility="Collapsed"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
