                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Name}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Gender, Converter={StaticResource GenderConv}}" Width="40">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Sex}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding BirthDate}" Width="85">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_DOB}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Age}" Width="35">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Age}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding AgeCategory}" Width="50" IsReadOnly="True">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Group}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Country}" Width="80">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Team}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding CountryShort}" Width="80">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Abbr}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding IDNumber}" Width="130">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_IDNum}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Phone}" Width="100">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Phone}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding EventName}" Width="120">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Event}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <!-- 2026-05-22 接力棒次列：仅接力队员条目有值（如"第3棒"），个人项目空 -->
                                        <DataGridTextColumn Binding="{Binding LegLabel}" Width="50" IsReadOnly="True">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Leg}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding EntryTime}" Width="75">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Entry}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding CurrentStage}" Width="50">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Stage}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Heat}" Width="35">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Heat}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Lane}" Width="35">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Lane}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Status}" Width="45">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Status}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Notes}" Width="80">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Notes}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="{DynamicResource Str_EM_Tab_Relay}">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="180"/>
                                </Grid.RowDefinitions>
                                <!-- 顶部操作栏 -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{DynamicResource Str_EM_AddRelay}" Click="AddRelay_Click" Padding="12,6" FontSize="13" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource Str_EM_EditRelay}" Click="EditRelay_Click" Padding="12,6" FontSize="13" Background="#F59E0B" Foreground="White" BorderThickness="0" Margin="0,0,8,0"
                                            ToolTip="{DynamicResource Str_EM_EditRelayTip}"/>
                                    <Button Content="{DynamicResource Str_EM_DeleteRelay}" Click="DeleteRelay_Click" Padding="12,6" FontSize="13" Background="#EF4444" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource Str_EM_SyncRelayHeat}" Click="SyncRelayHeatInfo_Click" Padding="12,6" FontSize="13" Background="#22C55E" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
                                    <Border Width="1" Background="#CBD5E1" Margin="6,4,6,4"/>
                                    <Button Content="{DynamicResource Str_EM_ImportCSV}" Click="ImportRelayCSV_Click" Padding="12,6" FontSize="13" Background="#8B5CF6" Foreground="White" BorderThickness="0" Margin="0,0,6,0"
                                            ToolTip="{DynamicResource Str_EM_ImportRelayCSVTip}"/>
                                    <Button Content="{DynamicResource Str_EM_ExportCSV}" Click="ExportRelayCSV_Click" Padding="12,6" FontSize="13" Background="#10B981" Foreground="White" BorderThickness="0" Margin="0,0,6,0"
                                            ToolTip="{DynamicResource Str_EM_ExportRelayCSVTip}"/>
                                    <Button Content="{DynamicResource Str_EM_ExportRelayTemplate}" Click="ExportRelayTemplate_Click" Padding="12,6" FontSize="13" Background="#F97316" Foreground="White" BorderThickness="0" Margin="0,0,8,0"
                                            ToolTip="{DynamicResource Str_EM_ExportRelayTemplateTip}"/>
                                    <!-- 2026-08-21 赛前一小时才拿到接力名单, 31 支队手工敲 124 个名字来不及。
                                         这两个按钮配套用: 先导出填报表(队/道次已填好, 只留 4 棒空着),
                                         拿到名单填完, 再一键读入。与「导入CSV」的区别: 那个只新建队伍,
                                         已存在的会跳过; 这个专门给已有队伍补/改棒次姓名。 -->
                                    <Border Width="1" Background="#CBD5E1" Margin="6,4,6,4"/>
                                    <Button Content="{DynamicResource Str_EM_ExportRelayLegSheet}" Click="ExportRelayLegSheet_Click" Padding="12,6" FontSize="13" Background="#0EA5E9" Foreground="White" BorderThickness="0" Margin="0,0,6,0"
                                            ToolTip="{DynamicResource Str_EM_ExportRelayLegSheetTip}"/>
                                    <Button Content="{DynamicResource Str_EM_ImportRelayLegSheet}" Click="ImportRelayLegSheet_Click" Padding="12,6" FontSize="13" Background="#DC2626" Foreground="White" BorderThickness="0"
                                            ToolTip="{DynamicResource Str_EM_ImportRelayLegSheetTip}"/>
                                </StackPanel>
                                <!-- 按项目分组的接力队列表 -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="RelayGroupedPanel"/>
                                </ScrollViewer>
                                <!-- 隐藏的RelayGrid用于数据绑定 -->
                                <DataGrid x:Name="RelayGrid" Visibility="Collapsed" SelectionChanged="RelayGrid_SelectionChanged"/>
                                <!-- 棒次详情标题 + 填写提示 -->
                                <StackPanel Grid.Row="2" Margin="0,8,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="RelayLegTitle" Text="{DynamicResource Str_EM_RelayLegTitleEmpty}" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Content="{DynamicResource Str_EM_RelayLegUp}" Click="RelayLegUp_Click" Padding="10,4" FontSize="12" Background="#475569" Foreground="White" BorderThickness="0" Margin="0,0,4,0"/>
                                        <Button Content="{DynamicResource Str_EM_RelayLegDown}" Click="RelayLegDown_Click" Padding="10,4" FontSize="12" Background="#475569" Foreground="White" BorderThickness="0" Margin="0,0,4,0"/>
                                        <Button Content="{DynamicResource Str_EM_RelayLegReplace}" Click="RelayLegReplace_Click" Padding="10,4" FontSize="12" Background="#F59E0B" Foreground="White" BorderThickness="0" Margin="0,0,4,0"/>
                                        <Button Content="{DynamicResource Str_EM_RelayLegSave}" Click="RelayLegSave_Click" Padding="10,4" FontSize="12" Background="#22C55E" Foreground="White" BorderThickness="0" Margin="0,0,4,0"/>
                                    </StackPanel>
                                    <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                                        <TextBlock Foreground="#92400E" FontSize="12" TextWrapping="Wrap">
                                            <Run FontWeight="Bold" Text="{DynamicResource Str_EM_RelayHintTitle}"/>
                                            <Run Text="{DynamicResource Str_EM_RelayHintLeg}"/><Run Foreground="#B45309" Text="{DynamicResource Str_EM_RelayHintLegNote}"/>
                                            <Run Text="{DynamicResource Str_EM_RelayHintName}"/><Run Foreground="#B45309" Text="{DynamicResource Str_EM_RelayHintNameNote}"/>
                                            <Run Text="{DynamicResource Str_EM_RelayHintID}"/><Run Foreground="#B45309" Text="{DynamicResource Str_EM_RelayHintIDNote}"/>
                                            <Run Text="{DynamicResource Str_EM_RelayHintBib}"/><Run Foreground="#B45309" Text="{DynamicResource Str_EM_RelayHintBibNote}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <!-- 棒次详情表格（列序与HTML报名表一致：棒次 / 姓名 / 身份证号 / 参赛号 / 生日） -->
                                <DataGrid x:Name="RelayLegGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                                          SelectionMode="Single" IsReadOnly="False" AlternatingRowBackground="#F0F7FF">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding LegOrder}" Width="60" IsReadOnly="True">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Leg}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding SwimmerName}" Width="110">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Name}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding SwimmerIDNumber}" Width="190">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_IDNum}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding SwimmerBibNumber}" Width="90">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_BibNo}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding SwimmerBirthDate}" Width="110">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Birthday}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{DynamicResource Str_EM_Tab_Schedule}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="290"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
