                                    <ComboBox x:Name="FilterEventCombo" Width="180" Margin="4,0,8,0" SelectionChanged="FilterEvent_Changed">
                                        <ComboBoxItem Content="{DynamicResource Str_Common_All}" IsSelected="True"/>
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource Str_Common_AgeGroup}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="FilterAgeGroupCombo" Width="90" Margin="4,0,8,0" SelectionChanged="FilterAgeGroup_Changed"/>
                                    <TextBlock Text="{DynamicResource Str_Common_Gender}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="FilterGenderCombo" Width="70" Margin="4,0,8,0" SelectionChanged="FilterGender_Changed">
                                        <ComboBoxItem Tag="全部" Content="{DynamicResource Str_Common_All}" IsSelected="True"/>
                                        <ComboBoxItem Tag="男" Content="{DynamicResource Str_Gender_Male}"/>
                                        <ComboBoxItem Tag="女" Content="{DynamicResource Str_Gender_Female}"/>
                                        <ComboBoxItem Tag="混合" Content="{DynamicResource Str_Gender_Mixed}"/>
