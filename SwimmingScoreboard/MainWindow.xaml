                                                       FontSize="12" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_EM_ScoringConfig}" Click="ScoringConfig_Click" Padding="12,6" Background="#0EA5E9" Foreground="White" BorderThickness="0" Margin="0,0,8,0"
                                                        ToolTip="{DynamicResource Str_EM_ScoringConfigTip}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2026-05-24 项目用时配置（一键秩序册排日程用） -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_EM_EventDuration}" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                                            <TextBlock Text="{DynamicResource Str_EM_EventDurationDesc}"
                                                       FontSize="12" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Str_EM_DurationConfig}" Click="DurationConfig_Click" Padding="12,6" Background="#0EA5E9" Foreground="White" BorderThickness="0" Margin="0,0,8,0"
                                                        ToolTip="{DynamicResource Str_EM_DurationConfigTip}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{DynamicResource Str_EM_Tab_Records}">
                            <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <Button Content="{DynamicResource Str_EM_AddRecord}" Click="AddRecord_Click" Padding="12,6" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
                                            <Button Content="{DynamicResource Str_EM_DeleteSelected}" Click="DeleteRecord_Click" Padding="12,6" Background="#EF4444" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
                                            <!-- 2026-09-12 纪录表是就地编辑的, 原来没有任何"保存"动作 —— 改完只能等
                                                 别的操作顺带落盘, 比赛中那就是整包、会被主服务器拒。这个按钮把改动
                                                 落盘并按条同步给对端。 -->
                                            <Button Content="{DynamicResource Str_EM_SaveRecords}" Click="SaveRecords_Click" Padding="12,6" Background="#22C55E" Foreground="White" BorderThickness="0" Margin="0,0,8,0"
                                                    ToolTip="{DynamicResource Str_EM_SaveRecordsTip}"/>
                                            <Button Content="{DynamicResource Str_EM_ImportDefaultRecords}" Click="ImportDefaultRecords_Click" Padding="12,6" Background="#22C55E" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
                                            <Button Content="{DynamicResource Str_EM_ImportRecordsCSV}" Click="ImportRecordsCSV_Click" Padding="12,6" Background="#8B5CF6" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
                                            <Button Content="{DynamicResource Str_EM_DownloadRecordTemplate}" Click="ExportRecordTemplate_Click" Padding="12,6" Background="#F59E0B" Foreground="White" BorderThickness="0"/>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource Str_EM_DisplayRecordLabel}" VerticalAlignment="Center" Foreground="#475569" FontWeight="Bold" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="DisplayRecordLabelText" Text="WR (World Record)" VerticalAlignment="Center"
                                                       Foreground="#1E40AF" FontWeight="Bold" FontSize="14" Margin="0,0,12,0"/>
                                            <Button Content="{DynamicResource Str_EM_DisplayRecordSetting}" Click="DisplayRecordTypeSetting_Click" Padding="12,6" Background="#0EA5E9" Foreground="White" BorderThickness="0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource Str_EM_RecordQuery}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="RecordFilterAgeGroup" Width="90" Margin="0,0,8,0" SelectionChanged="RecordFilter_Changed"
                                                  ToolTip="{DynamicResource Str_EM_EditGroupTip}"/>
                                        <ComboBox x:Name="RecordFilterGender" Width="60" Margin="0,0,8,0" SelectionChanged="RecordFilter_Changed">
                                            <ComboBoxItem Tag="全部" Content="{DynamicResource Str_Common_All}" IsSelected="True"/>
                                            <ComboBoxItem Tag="男" Content="{DynamicResource Str_Gender_Male}"/>
                                            <ComboBoxItem Tag="女" Content="{DynamicResource Str_Gender_Female}"/>
                                            <ComboBoxItem Tag="混合" Content="{DynamicResource Str_Gender_Mixed}"/>
                                        </ComboBox>
                                        <ComboBox x:Name="RecordFilterEvent" Width="160" Margin="0,0,8,0" SelectionChanged="RecordFilter_Changed"/>
                                        <ComboBox x:Name="RecordFilterType" Width="110" Margin="0,0,8,0" SelectionChanged="RecordFilter_Changed"/>
                                        <TextBox x:Name="RecordFilterKeyword" Width="120" Margin="0,0,8,0" TextChanged="RecordFilter_Changed"
                                                 ToolTip="{DynamicResource Str_EM_RecordKeywordTip}"/>
                                        <Button Content="{DynamicResource Str_EM_ResetShort}" Click="RecordFilterReset_Click" Padding="12,6" Background="#64748B" Foreground="White" BorderThickness="0"/>
                                        <TextBlock x:Name="RecordFilterCount" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#64748B"/>
                                    </StackPanel>
                                    <DataGrid x:Name="RecordGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                              IsReadOnly="False" AlternatingRowBackground="#F8FAFC">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding AgeGroup}" Width="70">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Group}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding Gender}" Width="40">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Sex}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding EventName}" Width="120">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Event}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding RecordType}" Width="80">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_RecordType}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding HolderName}" Width="100">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Holder}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding HolderCountry}" Width="80">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Team}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding TimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="100">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_RecordTime}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                            <DataGridTemplateColumn Width="130">
                                                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Col_Date}"/></DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Date}" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <DatePicker SelectedDate="{Binding DateAsDateTime, Mode=TwoWay}" SelectedDateFormat="Short"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Binding="{Binding Location}" Width="100">
                                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Location}"/></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- 右侧：运动员注册面板 (只在 运动员管理 / 接力队管理 两页显示) -->
                    <Border x:Name="AthleteRegPanel" Grid.Column="1" Background="White" CornerRadius="6" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- 2026-06-25 必填项标红 * + 提交校验 (= 跟 register.html 同款规范) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Str_EM_RegPanelTitle}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#64748B">
                                        <Run Text="{DynamicResource Str_EM_RegRequiredNote}"/><Run Text="*" Foreground="#EF4444" FontWeight="Bold"/><Run Text="{DynamicResource Str_EM_RegRequiredNote2}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" VerticalAlignment="Center"><Run Text="{DynamicResource Str_Common_Name}"/><Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/></TextBlock>
                                    <TextBox x:Name="RegNameBox" Grid.Row="0" Grid.Column="1" Padding="3"/>
                                    <TextBlock Grid.Row="1" VerticalAlignment="Center"><Run Text="{DynamicResource Str_Common_Gender}"/><Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/></TextBlock>
                                    <ComboBox x:Name="RegGenderCombo" Grid.Row="1" Grid.Column="1" SelectedIndex="0">
                                        <ComboBoxItem Tag="男" Content="{DynamicResource Str_Gender_Male}"/><ComboBoxItem Tag="女" Content="{DynamicResource Str_Gender_Female}"/><ComboBoxItem Tag="混合" Content="{DynamicResource Str_Gender_Mixed}"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" VerticalAlignment="Center"><Run Text="{DynamicResource Str_Common_AgeGroup}"/><Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/></TextBlock>
                                    <ComboBox x:Name="RegGroupCombo" Grid.Row="2" Grid.Column="1" IsEditable="True"
                                              ToolTip="{DynamicResource Str_EM_RegGroupTip}"/>
                                    <TextBlock Grid.Row="3" VerticalAlignment="Center"><Run Text="{DynamicResource Str_EM_RegBirthDate}"/><Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/></TextBlock>
                                    <DatePicker x:Name="RegBirthDatePicker" Grid.Row="3" Grid.Column="1"
                                                Language="en-CA" SelectedDateFormat="Short"
                                                ToolTip="{DynamicResource Str_EM_RegBirthDateTip}"/>
                                    <TextBlock Grid.Row="4" VerticalAlignment="Center"><Run Text="{DynamicResource Str_EM_RegIDNumber}"/><Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/></TextBlock>
                                    <TextBox x:Name="RegIDNumberBox" Grid.Row="4" Grid.Column="1" Padding="3"/>
                                    <TextBlock Grid.Row="5" VerticalAlignment="Center"><Run Text="{DynamicResource Str_EM_RegCountry}"/><Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/></TextBlock>
                                    <ComboBox x:Name="RegCountryBox" Grid.Row="5" Grid.Column="1" Padding="3"
                                              IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                              SelectionChanged="RegCountryBox_SelectionChanged"
                                              ToolTip="{DynamicResource Str_EM_RegCountryTip}"/>
                                    <TextBlock Grid.Row="6" Text="{DynamicResource Str_EM_RegCountryShort}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="RegCountryShortBox" Grid.Row="6" Grid.Column="1" Padding="3"
                                             ToolTip="{DynamicResource Str_EM_RegCountryShortTip}"/>
                                    <TextBlock Grid.Row="7" Text="{DynamicResource Str_EM_RegPhone}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="RegPhoneBox" Grid.Row="7" Grid.Column="1" Padding="3"/>
                                    <TextBlock Grid.Row="8" Text="{DynamicResource Str_EM_RegCSA}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="RegCSABox" Grid.Row="8" Grid.Column="1" Padding="3"/>
                                    <TextBlock Grid.Row="9" Text="{DynamicResource Str_EM_RegNotes}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="RegNotesBox" Grid.Row="9" Grid.Column="1" Padding="3"/>
                                </Grid>

                                <!-- 参赛项目列表 -->
                                <TextBlock FontSize="13" FontWeight="Bold" Margin="0,10,0,4"><Run Text="{DynamicResource Str_EM_RegEvents}"/><Run Text=" *" Foreground="#EF4444" FontWeight="Bold"/></TextBlock>
                                <ListBox x:Name="RegEventListBox" Height="80" FontSize="12"/>
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,4,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource Str_EM_RegEventLabel}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="RegEventCombo" Grid.Column="1" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Column="2" Text="{DynamicResource Str_EM_RegEntryTime}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="RegEntryTimeBox" Grid.Column="3" Padding="3"
                                                     ToolTip="{DynamicResource Str_EM_RegEntryTimeTip}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="{DynamicResource Str_EM_RegAddEvent}" Click="RegAddEvent_Click" Padding="8,4"
                                                    Background="#8B5CF6" Foreground="White" BorderThickness="0" Margin="0,0,4,0" FontSize="12"/>
                                            <Button Content="{DynamicResource Str_EM_RegRemoveEvent}" Click="RegRemoveEvent_Click" Padding="8,4"
                                                    Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button Content="{DynamicResource Str_EM_RegSubmitAll}" Click="RegSubmitAll_Click" Margin="0,10,0,0"
                                        Padding="0,8" Background="#22C55E" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0"/>
                                <TextBlock x:Name="RegStatusText" Text="" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ 比赛控制 ═══ -->
            <TabItem x:Name="RaceControlTab" Header="{DynamicResource Str_Tab_RaceControl}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左栏 -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="6*"/>
                            <RowDefinition Height="4*"/>
                        </Grid.RowDefinitions>
                        <!-- 赛程导航（上3/4） -->
                        <Border Grid.Row="0" CornerRadius="10" Padding="12" Margin="0,0,0,6"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#F8FAFC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#8B5CF6" CornerRadius="4" Padding="5,3" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Str_RC_ScheduleNav}" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Button Click="PrevHeat_Click" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#6366F1" CornerRadius="6" Padding="12,5">
                                                    <TextBlock Text="{DynamicResource Str_RC_PrevHeat}" FontSize="12" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Click="NextHeat_Click" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#6366F1" CornerRadius="6" Padding="12,5">
                                                    <TextBlock Text="{DynamicResource Str_RC_NextHeat}" FontSize="12" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                                <TreeView x:Name="ScheduleTree" SelectedItemChanged="ScheduleTree_Selected" BorderThickness="0"/>
                            </DockPanel>
                        </Border>
                        <!-- 计时源对比 + 比赛日志 Tab（下1/4）2026-05-27 加 Tab 切换 -->
                        <Border Grid.Row="1" CornerRadius="10" Padding="6" BorderBrush="#334155" BorderThickness="1" Background="#0F172A">
                            <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                                <TabItem Header="{DynamicResource Str_RC_TabTimingCompare}">
                                    <DockPanel Margin="4">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4">
                                            <TextBlock Text="{DynamicResource Str_RC_SplitLabel}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="SplitSelectCombo" Width="110" FontSize="12" Margin="6,0,0,0"
                                                      BorderBrush="#475569" SelectionChanged="SplitSelect_Changed" SelectedIndex="0">
                                                <ComboBoxItem Content="{DynamicResource Str_RC_SplitFinish}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="TimingSourceInfo" Text="{DynamicResource Str_RC_TimingSourceHint}" Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="{DynamicResource Str_RC_TabRaceLog}">
                                    <DockPanel Margin="4">
                                        <TextBlock DockPanel.Dock="Top" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,4">
                                            <Run Text="{DynamicResource Str_RC_RaceLogHint}"/>
                                        </TextBlock>
                                        <ScrollViewer x:Name="LaneEventLogScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <TextBox x:Name="LaneEventLogText" IsReadOnly="True" Background="Transparent"
                                                     BorderThickness="0" Foreground="#E2E8F0" FontFamily="Consolas"
                                                     FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>

                    <!-- 中：泳道状态 -->
                    <Border Grid.Column="1" CornerRadius="10" Padding="12" Margin="0,0,10,0"
                            BorderBrush="#334155" BorderThickness="1" Background="#0F172A">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Background="#3B82F6" CornerRadius="4" Padding="5,3" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Str_RC_LaneStatus}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- 选定的比赛项目 -->
                                <TextBlock x:Name="PoolCurrentEventText" Grid.Column="1" Text="" FontSize="14" FontWeight="Bold"
                                           Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <!-- WR/CR 纪录 -->
                                <TextBlock x:Name="RecordDisplayText" Grid.Column="2" Text="WR: ---    CR: ---" Width="320" FontSize="18" FontWeight="Bold"
                                           Foreground="#F59E0B" FontFamily="Consolas" Opacity="0.9"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <!-- 滚动时间 -->
                                <TextBlock x:Name="RunningTimeText" Grid.Column="3" Text="0.00" Width="160" FontSize="32" FontWeight="Bold"
                                           Foreground="#F59E0B" FontFamily="Consolas" TextAlignment="Right" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                <!-- 状态 — 整框底色随当前比赛状态变化（等待蓝/就位黄/比赛中红/已完赛灰） -->
                                <Border x:Name="RaceStateBox" Grid.Column="4" Background="#3B82F6" CornerRadius="12" Padding="10,4" MinWidth="90">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse x:Name="RaceStateIndicator" Width="12" Height="12" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RaceStateLabel" Text="{DynamicResource Str_RC_StateWaiting}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- 表头 -->
                            <Grid x:Name="PoolHeader" DockPanel.Dock="Top" Height="38" Margin="0,0,0,4" Background="#1E293B"/>
                            <!-- 计时源对比已移到左栏底部 -->
                            <!-- 泳道行 -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="LanePanel"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- 右：比赛控制 -->
                    <Border Grid.Column="2" CornerRadius="10" Padding="14" Margin="0,0,4,4"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#F8FAFC" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#94A3B8" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                        </Border.Effect>
                        <Border.Resources>
                            <!-- 所有按钮统一添加悬停/按下的交互反馈，不改变其他视觉 -->
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Resources>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- 2026-06-12 标题 + 参数设置: 单行布局, "比赛控制"标题在左, "参数设置"按钮在右上角
                                 (成绩存盘路径/热敏打印 已移入 参数设置 窗口, 标题栏只剩一个按钮, 不再溢出裁切). -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#DC2626" CornerRadius="4" Padding="5,3" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Str_RC_SectionTitle}" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource Str_RC_TimingSettings}" Click="TimingSettings_Click"
                                        Padding="8,2" Background="#475569" Foreground="White" BorderThickness="0"
                                        FontSize="12" VerticalAlignment="Center" Cursor="Hand"/>
