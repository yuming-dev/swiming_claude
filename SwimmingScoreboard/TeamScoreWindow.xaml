<Window x:Class="SwimmingScoreboard.TeamScoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_TeamScore_Title}" Width="800" Height="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource Str_Win_TeamScore_Header}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <DataGrid x:Name="TeamGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" AlternatingRowBackground="#F8FAFC">
            <DataGrid.Columns>
                <DataGridTextColumn Width="50"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColRank}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Rank"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="100"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Team}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="TeamName"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_TeamScore_ColTotal}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="TotalPoints"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_TeamScore_ColIndiv}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="IndividualPoints"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_TeamScore_ColRelay}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="RelayPoints"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="80"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_TeamScore_ColRecordBonus}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="RecordBonusPoints"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="50"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_TeamScore_ColGold}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="GoldCount"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="50"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_TeamScore_ColSilver}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="SilverCount"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="50"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_TeamScore_ColBronze}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="BronzeCount"/></DataGridTextColumn.Binding></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
