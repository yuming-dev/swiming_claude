<Window x:Class="SwimmingScoreboard.StaffManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作人员管理（5 组）" Width="1080" Height="640"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 + 计数 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="工作人员管理" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Text="" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#475569" FontSize="12"/>
        </StackPanel>

        <!-- 5 组切换 + 工具按钮 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="筛选分组:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
                <ComboBox x:Name="GroupFilterCombo" Width="160" VerticalAlignment="Center" SelectionChanged="GroupFilter_Changed">
                    <ComboBoxItem Content="全部" IsSelected="True"/>
                    <ComboBoxItem Content="主席团"/>
                    <ComboBoxItem Content="组织委员会"/>
                    <ComboBoxItem Content="工作机构"/>
                    <ComboBoxItem Content="技术及仲裁"/>
                    <ComboBoxItem Content="裁判员"/>
                </ComboBox>
                <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="14,0,4,0"/>
                <TextBox x:Name="SearchBox" Width="160" Padding="3" VerticalAlignment="Center" TextChanged="Search_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ 新增" Click="Add_Click" Padding="10,4" Margin="0,0,6,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="× 删除" Click="Delete_Click" Padding="10,4" Margin="0,0,6,0"
                        Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="📥 加载默认岗位" Click="LoadDefault_Click" Padding="10,4" Margin="0,0,6,0"
                        Background="#0EA5E9" Foreground="White" BorderThickness="0"
                        ToolTip="把当前组的常见岗位（如 总裁判长 / 发令主裁判 / ...）填进表格，姓名留空"/>
                <Button Content="📤 导出 CSV" Click="ExportCsv_Click" Padding="10,4" Margin="0,0,6,0"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
                <Button Content="📥 导入 CSV" Click="ImportCsv_Click" Padding="10,4"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <!-- 工作人员表格 -->
        <DataGrid x:Name="StaffGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridComboBoxColumn x:Name="GroupColumn" Header="分组" SelectedItemBinding="{Binding Group}" Width="110">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <sys:String>主席团</sys:String>
                            <sys:String>组织委员会</sys:String>
                            <sys:String>工作机构</sys:String>
                            <sys:String>技术及仲裁</sys:String>
                            <sys:String>裁判员</sys:String>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="工作岗位" Binding="{Binding Title}" Width="180"/>
                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="100"/>
                <DataGridComboBoxColumn Header="性别" SelectedItemBinding="{Binding Gender}" Width="60">
                    <DataGridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <sys:String>男</sys:String>
                            <sys:String>女</sys:String>
                        </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="裁判等级" Binding="{Binding RefereeLevel}" Width="90"/>
                <DataGridTextColumn Header="工作单位" Binding="{Binding Country}" Width="160"/>
                <DataGridTextColumn Header="电话" Binding="{Binding Phone}" Width="110"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部：样式 + 按钮 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="样式:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold" FontSize="12"/>
                <RadioButton x:Name="StylePerPage4" Content="4 张/页" GroupName="StyleGrp" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                <RadioButton x:Name="StylePerPage6" Content="6 张/页" GroupName="StyleGrp" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                <RadioButton x:Name="StylePerPage8" Content="8 张/页" GroupName="StyleGrp" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" Margin="12,0,0,0" TextWrapping="Wrap"
                       Text="说明: 5 组 主席团/组织委员会/工作机构/技术及仲裁/裁判员; 裁判员组用 裁判等级 字段, 其他组用 工作单位; 秩序册 header 自动拉本表"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="📊 导出花名册" Click="ExportRoster_Click" Padding="12,6" Margin="0,0,8,0"
                        Background="#16A34A" Foreground="White" BorderThickness="0"
                        ToolTip="按当前 样式 (4/6/8 张/页) 导出花名册 Excel"/>
                <Button Content="✓ 保存" Click="Save_Click" Padding="14,6" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="取消" Click="Cancel_Click" Padding="14,6"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
