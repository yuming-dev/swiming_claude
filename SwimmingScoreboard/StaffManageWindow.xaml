<Window x:Class="SwimmingScoreboard.StaffManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SwimmingScoreboard"
        x:Name="RootWin"
        Title="{DynamicResource Str_Win_StaffMgmt_Title}" Width="1080" Height="640"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Window.Resources>
        <!-- 2026-10-05 DataGridComboBoxColumn 的 SelectedValueBinding+SelectedValuePath/
             DisplayMemberPath 组合在非编辑态(只读文本)下有已知渲染缺陷——实测会显示空白。
             改用 DataGridTemplateColumn: 只读态用转换器直接把中文哨兵值转成展示文字, 编辑态
             用普通 ComboBox(SelectedValuePath/DisplayMemberPath 在普通 ComboBox 上没有这个问题)。 -->
        <local:StaffGroupDisplayConverter x:Key="StaffGroupConv"/>
        <local:GenderDisplayConverter x:Key="GenderConv"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 + 计数 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Str_Win_StaffMgmt_Header}" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Text="" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#475569" FontSize="12"/>
        </StackPanel>

        <!-- 5 组切换 + 工具按钮; 分组名(主席团/组织委员会/...)是与 StaffMember.Group 比对的数据哨兵值,
             存在 Tag 里不翻译, Content 走 DynamicResource 展示层翻译(2026-10-05 现场反馈"Filter Group
             下拉没翻译"才发现——下拉值之前直接当 Content 用, 导致比对值=展示值绑死成中文) -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Str_Win_StaffMgmt_FilterGroupLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
                <ComboBox x:Name="GroupFilterCombo" Width="160" VerticalAlignment="Center" SelectionChanged="GroupFilter_Changed">
                    <ComboBoxItem Tag="全部" Content="{DynamicResource Str_Common_All}" IsSelected="True"/>
                    <ComboBoxItem Tag="主席团" Content="{DynamicResource Str_StaffGroup_Presidium}"/>
                    <ComboBoxItem Tag="组织委员会" Content="{DynamicResource Str_StaffGroup_OrgCommittee}"/>
                    <ComboBoxItem Tag="工作机构" Content="{DynamicResource Str_StaffGroup_WorkOrg}"/>
                    <ComboBoxItem Tag="技术及仲裁" Content="{DynamicResource Str_StaffGroup_TechArbitration}"/>
                    <ComboBoxItem Tag="裁判员" Content="{DynamicResource Str_StaffGroup_Referees}"/>
                </ComboBox>
                <TextBlock Text="{DynamicResource Str_Win_StaffMgmt_SearchLabel}" VerticalAlignment="Center" Margin="14,0,4,0"/>
                <TextBox x:Name="SearchBox" Width="160" Padding="3" VerticalAlignment="Center" TextChanged="Search_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Str_Win_StaffMgmt_AddBtn}" Click="Add_Click" Padding="10,4" Margin="0,0,6,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Win_StaffMgmt_DeleteBtn}" Click="Delete_Click" Padding="10,4" Margin="0,0,6,0"
                        Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Win_StaffMgmt_LoadDefaultBtn}" Click="LoadDefault_Click" Padding="10,4" Margin="0,0,6,0"
                        Background="#0EA5E9" Foreground="White" BorderThickness="0"
                        ToolTip="{DynamicResource Str_Win_StaffMgmt_LoadDefaultTip}"/>
                <Button Content="{DynamicResource Str_Win_StaffMgmt_ExportCsvBtn}" Click="ExportCsv_Click" Padding="10,4" Margin="0,0,6,0"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Win_StaffMgmt_ImportCsvBtn}" Click="ImportCsv_Click" Padding="10,4"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <!-- 工作人员表格; Group/Gender 列存的仍是数据哨兵值(StaffMember.Group/Gender), 下拉展示文字
             2026-10-05 改成 SelectedValueBinding+SelectedValuePath/DisplayMemberPath 分离——
             ItemsSource(Value=中文哨兵, Display=当前语言展示名)在代码后置里按语言现建, 见构造函数 -->
        <DataGrid x:Name="StaffGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="110" SortMemberPath="Group">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Col_Group}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Group, Converter={StaticResource StaffGroupConv}}" Padding="6,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ElementName=RootWin, Path=GroupOptions}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display"
                                      SelectedValue="{Binding Group, Mode=TwoWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="180"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_StaffMgmt_ColTitle}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Title"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="100"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Name}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Name"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTemplateColumn Width="60" SortMemberPath="Gender">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Col_Sex}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Gender, Converter={StaticResource GenderConv}}" Padding="6,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ElementName=RootWin, Path=GenderOptions}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display"
                                      SelectedValue="{Binding Gender, Mode=TwoWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="90"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_StaffMgmt_ColRefLevel}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="RefereeLevel"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="160"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_StaffMgmt_ColWorkUnit}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Country"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Phone}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Phone"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Notes}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Note"/></DataGridTextColumn.Binding></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部：样式 + 按钮 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Str_Win_StaffMgmt_StyleLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold" FontSize="12"/>
                <RadioButton x:Name="StylePerPage4" Content="{DynamicResource Str_Win_StaffMgmt_PerPage4}" GroupName="StyleGrp" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                <RadioButton x:Name="StylePerPage6" Content="{DynamicResource Str_Win_StaffMgmt_PerPage6}" GroupName="StyleGrp" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                <RadioButton x:Name="StylePerPage8" Content="{DynamicResource Str_Win_StaffMgmt_PerPage8}" GroupName="StyleGrp" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" Margin="12,0,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource Str_Win_StaffMgmt_FooterNote}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{DynamicResource Str_Win_StaffMgmt_ExportRosterBtn}" Click="ExportRoster_Click" Padding="12,6" Margin="0,0,8,0"
                        Background="#16A34A" Foreground="White" BorderThickness="0"
                        ToolTip="{DynamicResource Str_Win_StaffMgmt_ExportRosterTip}"/>
                <Button Content="{DynamicResource Str_Win_EvtDur_SaveBtn}" Click="Save_Click" Padding="14,6" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" Padding="14,6"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
