<Window x:Class="SwimmingScoreboard.FinalsStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_FinalsStatus_Title}" Width="900" Height="600"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource Str_Win_FinalsStatus_Header}" FontSize="15" FontWeight="Bold"
                       Foreground="#1E40AF" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock x:Name="SummaryText" Text="" VerticalAlignment="Center" Foreground="#475569"/>
            <Button Content="{DynamicResource Str_Win_FinalsStatus_RefreshBtn}" Click="Refresh_Click" Padding="10,4" Margin="16,0,0,0"
                    Background="#3B82F6" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <DataGrid x:Name="StatusGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Width="80"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_FinalsStatus_ColAgeGroup}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="AgeGroup"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="50"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Sex}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Gender"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="160"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_FinalsStatus_ColEvent}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="EventName"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="75"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_FinalsStatus_ColParticipants}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="ParticipantLabel"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="75"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_FinalsStatus_ColFinalHeats}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="FinalHeats"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="100"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_FinalsStatus_ColInputStatus}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="InputStatusText"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="80"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_FinalsStatus_ColScoringStatus}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="ScoringStatusText"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="90"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_FinalsStatus_ColConfirmedStatus}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="ConfirmedStatusText"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Notes}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Note"/></DataGridTextColumn.Binding></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"
                       Text="{DynamicResource Str_Win_FinalsStatus_FooterNote}"
                       TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="{DynamicResource Str_Btn_Close}" Click="Close_Click" Padding="20,6"
                    Background="#475569" Foreground="White" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
