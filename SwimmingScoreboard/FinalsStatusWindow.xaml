<Window x:Class="SwimmingScoreboard.FinalsStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="决赛项目状态总览" Width="900" Height="600"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="决赛项目录入/加分/确认状态总览" FontSize="15" FontWeight="Bold"
                       Foreground="#1E40AF" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock x:Name="SummaryText" Text="" VerticalAlignment="Center" Foreground="#475569"/>
            <Button Content="🔄 刷新" Click="Refresh_Click" Padding="10,4" Margin="16,0,0,0"
                    Background="#3B82F6" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <DataGrid x:Name="StatusGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="比赛组别" Binding="{Binding AgeGroup}" Width="80"/>
                <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="50"/>
                <DataGridTextColumn Header="比赛项目" Binding="{Binding EventName}" Width="160"/>
                <DataGridTextColumn Header="参赛人数" Binding="{Binding ParticipantLabel}" Width="75"/>
                <DataGridTextColumn Header="决赛组数" Binding="{Binding FinalHeats}" Width="75"/>
                <DataGridTextColumn Header="录入状态" Binding="{Binding InputStatusText}" Width="100"/>
                <DataGridTextColumn Header="加分状态" Binding="{Binding ScoringStatusText}" Width="80"/>
                <DataGridTextColumn Header="确认状态" Binding="{Binding ConfirmedStatusText}" Width="90"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"
                       Text="说明：录入=该项目所有有报名选手是否都有最终成绩；加分=团体计分时是否已纳入；确认=裁判是否按过'确认本组成绩'"
                       TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="关闭" Click="Close_Click" Padding="20,6"
                    Background="#475569" Foreground="White" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
