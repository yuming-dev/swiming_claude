<Window x:Class="SwimmingScoreboard.AwardCertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="奖状生成" Width="860" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#1E293B">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择要生成奖状的获奖者（决赛前 3 名）" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="项目筛选：" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="EventFilterBox" Width="280" SelectionChanged="EventFilterBox_SelectionChanged"/>
            <Button Content="全选" Click="SelectAll_Click" Margin="20,0,0,0" Padding="12,5"/>
            <Button Content="全不选" Click="SelectNone_Click" Margin="8,0,0,0" Padding="12,5"/>
            <TextBlock x:Name="CountText" Foreground="#94A3B8" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="13"/>
        </StackPanel>

        <DataGrid x:Name="Grid1" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32"
                  Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                  RowBackground="#0F172A" AlternatingRowBackground="#16213A" AlternationCount="2">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Binding="{Binding Selected, Mode=TwoWay}" Width="55"/>
                <DataGridTextColumn Header="项目" Binding="{Binding EventLabel}" Width="240" IsReadOnly="True"/>
                <DataGridTextColumn Header="名次" Binding="{Binding RankLabel}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="姓名/代表队" Binding="{Binding DisplayName}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="代表队" Binding="{Binding Country}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="生成 / 预览" Click="Generate_Click" Padding="18,8" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="关闭" Click="Close_Click" Padding="18,8"/>
        </StackPanel>
    </Grid>
</Window>
