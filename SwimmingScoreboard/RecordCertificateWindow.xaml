<Window x:Class="SwimmingScoreboard.RecordCertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_RecordCert_Title}" Width="1180" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#1E293B">
    <Window.Resources>
        <!-- 2026-09-17 数据列内容跟表头一样居中显示, 不再左对齐。 -->
        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Str_Win_RecordCert_Header}" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Str_Win_AwardCert_TemplateLabel}" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="TemplateBox" Width="260">
                <ComboBoxItem Content="{DynamicResource Str_Win_RecordCert_TplFull}" Tag="full" IsSelected="True"/>
                <ComboBoxItem Content="{DynamicResource Str_Win_AwardCert_TplFullGansu}" Tag="full_gansu"/>
            </ComboBox>
            <Button Content="{DynamicResource Str_Win_AwardCert_CertSettingsBtn}" Click="CertSettings_Click" Margin="20,0,0,0" Padding="12,5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Str_Win_AwardCert_AgeGroupFilterLabel}" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="AgeGroupFilterBox" Width="140" SelectionChanged="AgeGroupFilterBox_SelectionChanged"/>
            <TextBlock Text="{DynamicResource Str_Win_AwardCert_EventFilterLabel}" Foreground="#94A3B8" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="EventFilterBox" Width="280" SelectionChanged="EventFilterBox_SelectionChanged"/>
            <Button Content="{DynamicResource Str_Win_AwardCert_SelectAllBtn}" Click="SelectAll_Click" Margin="20,0,0,0" Padding="12,5"/>
            <Button Content="{DynamicResource Str_Win_AwardCert_SelectNoneBtn}" Click="SelectNone_Click" Margin="8,0,0,0" Padding="12,5"/>
            <TextBlock x:Name="CountText" Foreground="#94A3B8" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="13"/>
        </StackPanel>

        <!-- 2026-09-17 原来深色背景配深色文字, 数据行基本看不见(用户实拍)。
             改浅色卡片: 白底深字, 表头深蓝底白字, 对比度够、跟窗口深色外框
             也算协调(深色窗体里嵌一张白纸型表格, 常见的深浅搭配)。 -->
        <DataGrid x:Name="Grid1" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                  Background="White" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                  RowBackground="White" AlternatingRowBackground="#EFF6FF" AlternationCount="2"
                  HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0"
                  RowHeaderWidth="0">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="#1E3A8A"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#BFDBFE"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Selected, Mode=TwoWay}" Width="55"><DataGridCheckBoxColumn.Header><TextBlock Text="{DynamicResource Str_Win_AwardCert_ColSelect}"/></DataGridCheckBoxColumn.Header></DataGridCheckBoxColumn>
                <DataGridTextColumn Width="100" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Date}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Date"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="80" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Group}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="AgeGroup"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="200" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_AwardCert_ColEvent}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="EventLabel"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="160" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_RecordCert_ColAthlete}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Athlete"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="120" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Team}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Country"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="90" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_RecordTime}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Time"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="90" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_RecordCert_ColCompRank}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="CompRankLabel"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="160" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_RecordType}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="RecordType"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="140" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Holder}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="OldHolder"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="90" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_RecordCert_ColOldTime}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="OldTime"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="*" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_RecordCert_ColOldDate}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="OldDate"/></DataGridTextColumn.Binding></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Str_Win_AwardCert_GenerateBtn}" Click="Generate_Click" Padding="18,8" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="{DynamicResource Str_Btn_Close}" Click="Close_Click" Padding="18,8"/>
        </StackPanel>
    </Grid>
</Window>
