<Window x:Class="SwimmingScoreboard.RecordCertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="纪录证书生成" Width="1180" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#1E293B">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择要生成纪录证书的破纪录记录" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="证书模板：" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="TemplateBox" Width="260">
                <ComboBoxItem Content="完整证书（自画，原有风格）" Tag="full" IsSelected="True"/>
                <ComboBoxItem Content="完整证书－甘肃省运动会风格（自画）" Tag="full_gansu"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="项目筛选：" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="EventFilterBox" Width="280" SelectionChanged="EventFilterBox_SelectionChanged"/>
            <Button Content="全选" Click="SelectAll_Click" Margin="20,0,0,0" Padding="12,5"/>
            <Button Content="全不选" Click="SelectNone_Click" Margin="8,0,0,0" Padding="12,5"/>
            <TextBlock x:Name="CountText" Foreground="#94A3B8" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="13"/>
        </StackPanel>

        <DataGrid x:Name="Grid1" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="32"
                  Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                  RowBackground="#0F172A" AlternatingRowBackground="#16213A" AlternationCount="2">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Binding="{Binding Selected, Mode=TwoWay}" Width="55"/>
                <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="项目" Binding="{Binding EventLabel}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="运动员/代表队" Binding="{Binding Athlete}" Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="代表队" Binding="{Binding Country}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="成绩" Binding="{Binding Time}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="运动会名次" Binding="{Binding CompRankLabel}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="纪录类型" Binding="{Binding RecordType}" Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="原记录保持者" Binding="{Binding OldHolder}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="原记录成绩" Binding="{Binding OldTime}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="原记录时间" Binding="{Binding OldDate}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="生成 / 预览" Click="Generate_Click" Padding="18,8" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="关闭" Click="Close_Click" Padding="18,8"/>
        </StackPanel>
    </Grid>
</Window>
