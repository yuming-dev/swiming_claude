<Window x:Class="SwimmingScoreboard.EventResultPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目成绩打印" Width="1400" Height="620"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Window.Resources>
        <!-- 2026-09-03 表格单元格内容居中。
             注意: 光在 DataGrid.CellStyle 上设 HorizontalContentAlignment 是【没用】的 ——
             DataGridCell 的默认模板里那个 ContentPresenter 根本没把对齐绑到
             HorizontalContentAlignment 上。文本列必须走 ElementStyle 才生效。 -->
        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 2026-09-02 左侧赛程导航: 跟"成绩与排名"那棵是同一份(MainWindow.RebuildNavTree 填),
             点项目节点 = 组次"全部", 点组节点 = 对应"第X组" -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="6" Background="White" Margin="0,0,8,0">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="🧭 赛程导航" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                <TextBox DockPanel.Dock="Top" x:Name="NavSearchBox" Padding="4" Margin="0,0,0,6"
                         ToolTip="输入项目/组别/赛次关键字,自动展开匹配分支并高亮"
                         TextChanged="NavSearch_TextChanged"/>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button Content="全部" Click="NavFilter_Click" Tag="all" Padding="6,3" FontSize="11" Background="#1E40AF" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                    <Button Content="未开始" Click="NavFilter_Click" Tag="pending" Padding="6,3" FontSize="11" Background="#94A3B8" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                    <Button Content="进行中" Click="NavFilter_Click" Tag="running" Padding="6,3" FontSize="11" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                    <Button Content="已结束" Click="NavFilter_Click" Tag="done" Padding="6,3" FontSize="11" Background="#22C55E" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                    <Button Content="已取消" Click="NavFilter_Click" Tag="cancelled" Padding="6,3" FontSize="11" Background="#EF4444" Foreground="White" BorderThickness="0" Margin="0,0,4,4"/>
                </WrapPanel>
                <TreeView x:Name="NavTree" BorderThickness="0" SelectedItemChanged="NavTree_Selected"/>
            </DockPanel>
        </Border>

        <!-- 选择条件 -->
        <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="组别:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="AgeGroupCombo" Width="110" SelectionChanged="Filter_Changed" Margin="0,0,12,0"
                          ToolTip="选择&quot;全部&quot;表示不按组别过滤"/>
                <TextBlock Text="性别:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="GenderCombo" Width="70" SelectionChanged="Filter_Changed" Margin="0,0,12,0">
                    <!-- 2026-08-21 改由 MainWindow.FillGenderCombo 按比赛档案的性别表填 -->
                    <ComboBoxItem Content="男女"/>
                </ComboBox>
                <TextBlock Text="项目:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="EventCombo" Width="180" SelectionChanged="Filter_Changed" Margin="0,0,12,0"/>
                <TextBlock Text="赛次:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <!-- 2026-09-03 赛次改由 MainWindow.FillStageCombo 按【比赛参数设置管理 → 赛次】填, 不再写死 -->
                <ComboBox x:Name="StageCombo" Width="90" SelectionChanged="Filter_Changed" Margin="0,0,12,0"/>
                <TextBlock Text="组:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="HeatCombo" Width="80" SelectionChanged="Heat_Changed" Margin="0,0,12,0">
                    <ComboBoxItem Content="全部" IsSelected="True"/>
                </ComboBox>
                <Button Content="查询" Click="Query_Click" Padding="16,6"
                        Background="#3B82F6" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- 状态提示 -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Text="请选择条件后点击查询" Foreground="#64748B" FontSize="13"/>
        </Border>

        <!-- 预览表格 -->
        <!-- 接力赛"姓名"列 4 名队员逗号分隔，需较宽；反应时列 4 棒分行展示 -->
        <DataGrid x:Name="PreviewGrid" Grid.Row="2" Grid.Column="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" AlternatingRowBackground="#F8FAFC" Margin="0,0,0,8">
            <!-- 2026-09-02 单元格和表头一律居中。
                 BasedOn 指向主题默认样式 —— 不加它就等于把 DataGridCell 的默认样式
                 整个换掉, 选中高亮、焦点框这些都会跟着没。 -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <!-- 2026-09-02 列序: 名次 / 姓名 / 代表队 / 号码 / 组别 / 组数 / 道次 / 最终成绩 …
                     接力时"代表队"和"姓名"对调 (代码里按 DisplayIndex 换, 见 ApplyPreviewColumnOrder) -->
                <DataGridTextColumn Header="名次" Binding="{Binding Rank}" Width="50" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTemplateColumn x:Name="NameCol" Header="姓名" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Padding="4,3" TextAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="TeamCol" Header="代表队" Binding="{Binding Country}" Width="100" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="号码" Binding="{Binding BibNumber}" Width="60" ElementStyle="{StaticResource CellCenter}"/>
                <!-- 2026-08-31 补组别/组数(第几组/总组数): 一张项目成绩单跨多组时看不出行属于哪一组 -->
                <DataGridTextColumn Header="组别" Binding="{Binding AgeGroup}" Width="70" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="组数" Binding="{Binding HeatText}" Width="60" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="道次" Binding="{Binding Lane}" Width="45" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="最终成绩" Binding="{Binding FinalTime}" Width="80" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="成绩差" Binding="{Binding Diff}" Width="70" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTemplateColumn Header="反应时间" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ReactionTime}" TextWrapping="Wrap" Padding="4,3" TextAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="50" ElementStyle="{StaticResource CellCenter}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 操作按钮 (与"成绩册/分段计时报告"预览窗一致的 5 个功能键 + 关闭) -->
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="在浏览器中打开" Click="OpenBrowser_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#0EA5E9" Foreground="White" BorderThickness="0" x:Name="OpenBrowserButton" IsEnabled="False"
                    ToolTip="在系统默认浏览器中打开当前文档（可在浏览器中按 Ctrl+P 打印或另存为 PDF）"/>
            <Button Content="导出 PDF" Click="ExportPdf_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#DC2626" Foreground="White" BorderThickness="0" x:Name="ExportPdfButton" IsEnabled="False"
                    ToolTip="在浏览器中打开后选择 Microsoft Print to PDF 打印机即可保存为 PDF"/>
            <Button Content="导出 DOC" Click="ExportDoc_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0" x:Name="ExportDocButton" IsEnabled="False"
                    ToolTip="保存为 Microsoft Word 兼容的 .doc 文件"/>
            <Button Content="导出 HTML" Click="ExportHtml_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#7C3AED" Foreground="White" BorderThickness="0" x:Name="ExportHtmlButton" IsEnabled="False"
                    ToolTip="保存为 .html 文件"/>
            <Button Content="打印" Click="Print_Click" Padding="14,8" Margin="0,0,8,0"
                    Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0" x:Name="PrintButton" IsEnabled="False"
                    ToolTip="打开预览窗口并调用系统打印机"/>
            <Button Content="关闭" Click="Close_Click" Padding="20,8"
                    Background="#475569" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
