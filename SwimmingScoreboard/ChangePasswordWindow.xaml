<Window x:Class="SwimmingScoreboard.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_ChangePwd_Title}" Height="370" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E293B">
    <!-- 2026-10-10 4 行标签列原来固定 80px, 是按中文(3~4字)量的, 英文("Current Password"等)
         塞不下被截断("Current Passw"...)——改用 Grid.IsSharedSizeScope + SharedSizeGroup,
         4 行自动按"当前语言里最宽的那条标签"统一撑开, 两种语言都不截断、也保持对齐。 -->
    <Grid Margin="40,28" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Str_Win_ChangePwd_Title}" FontSize="18" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="PwdLabelCol"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_Win_ChangePwd_Current}" Foreground="#CBD5E1" VerticalAlignment="Center"/>
            <PasswordBox x:Name="CurrentPasswordBox" Grid.Column="1" Padding="8,6" FontSize="13"
                         Background="#334155" Foreground="White" BorderBrush="#475569" BorderThickness="1"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="PwdLabelCol"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_Win_ChangePwd_NewUsername}" Foreground="#CBD5E1" VerticalAlignment="Center"/>
            <TextBox x:Name="NewUsernameBox" Grid.Column="1" Padding="8,6" FontSize="13"
                     Background="#334155" Foreground="White" BorderBrush="#475569" BorderThickness="1"
                     CaretBrush="White"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="PwdLabelCol"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_Win_ChangePwd_New}" Foreground="#CBD5E1" VerticalAlignment="Center"/>
            <PasswordBox x:Name="NewPasswordBox" Grid.Column="1" Padding="8,6" FontSize="13"
                         Background="#334155" Foreground="White" BorderBrush="#475569" BorderThickness="1"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="PwdLabelCol"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_Win_ChangePwd_Confirm}" Foreground="#CBD5E1" VerticalAlignment="Center"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="1" Padding="8,6" FontSize="13"
                         Background="#334155" Foreground="White" BorderBrush="#475569" BorderThickness="1"/>
        </Grid>

        <TextBlock x:Name="MessageText" Grid.Row="7" Text="" HorizontalAlignment="Center"
                   FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="{DynamicResource Str_Win_ChangePwd_SaveBtn}" Click="Save_Click" Width="100" Padding="0,8"
                    Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,15,0"/>
            <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" Width="80" Padding="0,8"
                    Background="#475569" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
