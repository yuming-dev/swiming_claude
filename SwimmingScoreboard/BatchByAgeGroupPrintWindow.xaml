<Window x:Class="SwimmingScoreboard.BatchByAgeGroupPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="按组别批量公布成绩" Width="1100" Height="600"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 选择条件 -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="性别:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="GenderCombo" Width="80" SelectionChanged="Filter_Changed" Margin="0,0,12,0">
                    <ComboBoxItem Content="全部" IsSelected="True"/>
                    <ComboBoxItem Content="男"/>
                    <ComboBoxItem Content="女"/>
                    <ComboBoxItem Content="混合"/>
                </ComboBox>
                <TextBlock Text="项目:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="EventCombo" Width="200" SelectionChanged="Filter_Changed" Margin="0,0,12,0"/>
                <TextBlock Text="赛次:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="StageCombo" Width="80" SelectionChanged="Filter_Changed" Margin="0,0,12,0">
                    <ComboBoxItem Content="预赛"/>
                    <ComboBoxItem Content="半决赛"/>
                    <ComboBoxItem Content="决赛" IsSelected="True"/>
                </ComboBox>
                <Button Content="查询" Click="Query_Click" Padding="16,6"
                        Background="#3B82F6" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- 状态提示 -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Text="请选择性别+项目+赛次后点击查询" Foreground="#64748B" FontSize="13"/>
        </Border>

        <!-- 各组别预览 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel x:Name="PreviewPanel" Margin="10"/>
        </ScrollViewer>

        <!-- 5 操作按钮 + 关闭 (与 EventResultPrintWindow / DocumentPreviewWindow 一致) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="在浏览器中打开" Click="OpenBrowser_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#0EA5E9" Foreground="White" BorderThickness="0" x:Name="OpenBrowserButton" IsEnabled="False"
                    ToolTip="在系统默认浏览器中打开当前文档"/>
            <Button Content="导出 PDF" Click="ExportPdf_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#DC2626" Foreground="White" BorderThickness="0" x:Name="ExportPdfButton" IsEnabled="False"
                    ToolTip="在浏览器中打开后选 Microsoft Print to PDF 另存为 PDF"/>
            <Button Content="导出 DOC" Click="ExportDoc_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0" x:Name="ExportDocButton" IsEnabled="False"
                    ToolTip="保存为 Word 兼容的 .doc 文件"/>
            <Button Content="导出 HTML" Click="ExportHtml_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#7C3AED" Foreground="White" BorderThickness="0" x:Name="ExportHtmlButton" IsEnabled="False"
                    ToolTip="保存为 .html 文件"/>
            <Button Content="打印" Click="Print_Click" Padding="14,8" Margin="0,0,8,0"
                    Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0" x:Name="PrintButton" IsEnabled="False"
                    ToolTip="打开预览窗口并调用系统打印机"/>
            <Button Content="关闭" Click="Close_Click" Padding="20,8"
                    Background="#475569" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
