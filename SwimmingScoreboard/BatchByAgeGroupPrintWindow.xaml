<Window x:Class="SwimmingScoreboard.BatchByAgeGroupPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_BatchAge_Title}" Width="1400" Height="640"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Window.Resources>
        <!-- 2026-09-03 表格内容居中。文本列必须走 ElementStyle ——
             DataGridCell 的默认模板没把对齐绑到 HorizontalContentAlignment, 只设 CellStyle 不生效。 -->
        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 选择条件 -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <!-- 2026-09-03 每个下拉都带"全部": 组别全部 = 各组别各出一张子表;
                     项目/赛次全部 = 挨个跑一遍, 一次生成整本 -->
                <TextBlock Text="{DynamicResource Str_Win_BatchAge_AgeGroupLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="AgeGroupCombo" Width="110" SelectionChanged="Filter_Changed" Margin="0,0,12,0"
                          ToolTip="{DynamicResource Str_Win_BatchAge_AgeGroupTip}"/>
                <TextBlock Text="{DynamicResource Str_Win_BatchAge_GenderLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="GenderCombo" Width="80" SelectionChanged="Filter_Changed" Margin="0,0,12,0">
                    <ComboBoxItem Content="全部" IsSelected="True"/>
                    <!-- 2026-08-21 改由 MainWindow.FillGenderCombo 按比赛档案的性别表填 -->
                </ComboBox>
                <TextBlock Text="{DynamicResource Str_Win_BatchAge_EventLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="EventCombo" Width="200" SelectionChanged="Filter_Changed" Margin="0,0,12,0"/>
                <TextBlock Text="{DynamicResource Str_Win_BatchAge_StageLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <!-- 2026-09-03 赛次只保留"全部", 其余由 MainWindow.FillStageCombo 按参数设置填 -->
                <ComboBox x:Name="StageCombo" Width="90" SelectionChanged="Filter_Changed" Margin="0,0,12,0">
                    <ComboBoxItem Content="全部"/>
                </ComboBox>
                <Button Content="{DynamicResource Str_Win_BatchAge_QueryBtn}" Click="Query_Click" Padding="16,6"
                        Background="#3B82F6" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- 状态提示 -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Text="{DynamicResource Str_Win_BatchAge_InitialStatus}" Foreground="#64748B" FontSize="13"/>
        </Border>

        <!-- 各组别预览 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel x:Name="PreviewPanel" Margin="10"/>
        </ScrollViewer>

        <!-- 5 操作按钮 + 关闭 (与 EventResultPrintWindow / DocumentPreviewWindow 一致) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource Str_Win_DocPreview_OpenBrowserBtn}" Click="OpenBrowser_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#0EA5E9" Foreground="White" BorderThickness="0" x:Name="OpenBrowserButton" IsEnabled="False"
                    ToolTip="{DynamicResource Str_Win_BatchAge_OpenBrowserTip}"/>
            <Button Content="{DynamicResource Str_Win_DocPreview_ExportPdfBtn}" Click="ExportPdf_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#DC2626" Foreground="White" BorderThickness="0" x:Name="ExportPdfButton" IsEnabled="False"
                    ToolTip="{DynamicResource Str_Win_BatchAge_ExportPdfTip}"/>
            <Button Content="{DynamicResource Str_Win_DocPreview_ExportDocBtn}" Click="ExportDoc_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0" x:Name="ExportDocButton" IsEnabled="False"
                    ToolTip="{DynamicResource Str_Win_BatchAge_ExportDocTip}"/>
            <Button Content="{DynamicResource Str_Win_DocPreview_ExportHtmlBtn}" Click="ExportHtml_Click" Padding="14,8" Margin="0,0,4,0"
                    Background="#7C3AED" Foreground="White" BorderThickness="0" x:Name="ExportHtmlButton" IsEnabled="False"
                    ToolTip="{DynamicResource Str_Win_DocPreview_ExportHtmlTip}"/>
            <Button Content="{DynamicResource Str_Win_DocPreview_PrintBtn}" Click="Print_Click" Padding="14,8" Margin="0,0,8,0"
                    Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0" x:Name="PrintButton" IsEnabled="False"
                    ToolTip="{DynamicResource Str_Win_BatchAge_PrintTip}"/>
            <Button Content="{DynamicResource Str_Btn_Close}" Click="Close_Click" Padding="20,8"
                    Background="#475569" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
