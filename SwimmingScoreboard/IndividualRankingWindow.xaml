<Window x:Class="SwimmingScoreboard.IndividualRankingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_IndiRank_Title}" Width="900" Height="620"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource Str_Win_IndiRank_AgeGroupLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="AgeGroupCombo" Width="120" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Str_Win_StaffMgmt_FilterGroupLabel}" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="GenderCombo" Width="70" VerticalAlignment="Center">
                <ComboBoxItem Content="全部" IsSelected="True"/>
                <!-- 2026-08-21 改由 MainWindow.FillGenderCombo 按比赛档案的性别表填 -->
            </ComboBox>
            <TextBlock Text="Top N:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox x:Name="TopNBox" Width="50" Text="25" Padding="3" VerticalAlignment="Center"/>
            <Button Content="{DynamicResource Str_Win_IndiRank_ComputeBtn}" Click="Compute_Click" Padding="12,4" Margin="12,0,0,0"
                    Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <TextBlock x:Name="SummaryText" Text="" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#475569"/>
        </StackPanel>

        <DataGrid x:Name="RankGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" AlternatingRowBackground="#F8FAFC">
            <DataGrid.Columns>
                <DataGridTextColumn Width="50"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColRank}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Rank"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_BibNo}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="BibNumber"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="90"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Name}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Name"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="45"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Sex}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Gender"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="100"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Team}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Country"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="60"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Group}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="AgeCategory"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_IndiRank_ColTotalPoints}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="TotalPointsText"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_IndiRank_ColIndiCount}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="IndividualCount"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_IndiRank_ColDetail}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="ScoreDetail"/></DataGridTextColumn.Binding></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"
                       Text="{DynamicResource Str_Win_IndiRank_FooterNote}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Str_Win_StaffMgmt_ExportCsvBtn}" Click="ExportCsv_Click" Padding="12,4" Margin="0,0,8,0"
                        Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Win_IndiRank_PrintHtmlBtn}" Click="PrintHtml_Click" Padding="12,4" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Btn_Close}" Click="Close_Click" Padding="16,4"
                        Background="#475569" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
