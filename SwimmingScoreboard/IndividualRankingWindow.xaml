<Window x:Class="SwimmingScoreboard.IndividualRankingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运动员个人总分排名" Width="900" Height="620"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="比赛组别:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="AgeGroupCombo" Width="120" VerticalAlignment="Center"/>
            <TextBlock Text="性别:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="GenderCombo" Width="70" VerticalAlignment="Center">
                <ComboBoxItem Content="全部" IsSelected="True"/>
                <ComboBoxItem Content="男"/>
                <ComboBoxItem Content="女"/>
            </ComboBox>
            <TextBlock Text="Top N:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <TextBox x:Name="TopNBox" Width="50" Text="25" Padding="3" VerticalAlignment="Center"/>
            <Button Content="🔍 统计" Click="Compute_Click" Padding="12,4" Margin="12,0,0,0"
                    Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <TextBlock x:Name="SummaryText" Text="" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#475569"/>
        </StackPanel>

        <DataGrid x:Name="RankGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" AlternatingRowBackground="#F8FAFC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名次" Binding="{Binding Rank}" Width="50"/>
                <DataGridTextColumn Header="号码" Binding="{Binding BibNumber}" Width="70"/>
                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="90"/>
                <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="45"/>
                <DataGridTextColumn Header="代表队" Binding="{Binding Country}" Width="100"/>
                <DataGridTextColumn Header="组别" Binding="{Binding AgeCategory}" Width="60"/>
                <DataGridTextColumn Header="总积分" Binding="{Binding TotalPointsText}" Width="70"/>
                <DataGridTextColumn Header="个人项目" Binding="{Binding IndividualCount}" Width="70"/>
                <DataGridTextColumn Header="接力项目" Binding="{Binding RelayCount}" Width="70"/>
                <DataGridTextColumn Header="项目-名次明细" Binding="{Binding ScoreDetail}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"
                       Text="说明: 积分按 名次分设置 配置计算 (个人名次分 + 接力名次分 + 组别系数)；仅决赛阶段计入；DSQ/DNS/DNF 不计分"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📤 导出 CSV" Click="ExportCsv_Click" Padding="12,4" Margin="0,0,8,0"
                        Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="🖨 打印 HTML" Click="PrintHtml_Click" Padding="12,4" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="关闭" Click="Close_Click" Padding="16,4"
                        Background="#475569" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
