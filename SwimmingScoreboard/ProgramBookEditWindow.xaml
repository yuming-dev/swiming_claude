<Window x:Class="SwimmingScoreboard.ProgramBookEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_ProgBook_Title}"
        Width="980" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MultiBox" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei,SimSun"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="AlternatingRowBackground" Value="#F1F5F9"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="LblStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部说明栏 -->
        <Border DockPanel.Dock="Top" Background="#1E40AF" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Win_ProgBook_Title}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{DynamicResource Str_Win_ProgBook_HeaderDesc}"
                           Foreground="#DBEAFE" Margin="0,4,0,0" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- 底部按钮栏 -->
        <Border DockPanel.Dock="Bottom" Background="#E2E8F0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str_Win_ProgBook_PreviewBtn}" Click="Preview_Click" Background="#0EA5E9"/>
                <Button Content="{DynamicResource Str_Win_ProgBook_ResetBtn}" Click="Reset_Click" Background="#94A3B8"/>
                <Button Content="{DynamicResource Str_Win_ProgBook_SaveBtn}" Click="Save_Click" Background="#22C55E"/>
                <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" Background="#EF4444"/>
            </StackPanel>
        </Border>

        <TabControl Margin="10">
            <!-- 1. 封面 -->
            <TabItem Header="{DynamicResource Str_Win_ProgBook_TabCover}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_Win_ProgBook_CoverTitleLabel}" Style="{StaticResource LblStyle}" Grid.Row="0" Grid.Column="0" Margin="0,8"/>
                    <TextBox x:Name="CoverTitleBox" Grid.Row="0" Grid.Column="1" Margin="0,8"/>
                    <TextBlock Text="{DynamicResource Str_Win_ProgBook_CoverSubtitleLabel}" Style="{StaticResource LblStyle}" Grid.Row="1" Grid.Column="0" Margin="0,8"/>
                    <TextBox x:Name="CoverSubtitleBox" Grid.Row="1" Grid.Column="1" Margin="0,8"/>
                    <TextBlock Text="{DynamicResource Str_Win_ProgBook_VenueImageLabel}" Style="{StaticResource LblStyle}" Grid.Row="2" Grid.Column="0" Margin="0,8"/>
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,8">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Str_Win_ProgBook_PickImageBtn}" Click="PickVenueImage_Click" Background="#3B82F6"/>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Str_Win_ProgBook_ClearBtn}" Click="ClearVenueImage_Click" Background="#94A3B8"/>
                        <TextBox x:Name="VenueImagePathBox" IsReadOnly="True" Background="#F1F5F9"/>
                    </DockPanel>
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,4"
                               Text="{DynamicResource Str_Win_ProgBook_CoverHint}"
                               Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>

            <!-- 2. 前言 / 规程 / 通知 -->
            <TabItem Header="{DynamicResource Str_Win_ProgBook_TabForeword}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Str_Win_ProgBook_ForewordHeader}" FontWeight="Bold" Foreground="#1E40AF" FontSize="14" Margin="0,0,0,4"/>
                    <TextBox x:Name="ForewordBox" Grid.Row="1" Style="{StaticResource MultiBox}" Margin="0,0,0,12" MinHeight="100"/>
                    <TextBlock Grid.Row="2" Text="{DynamicResource Str_Win_ProgBook_RegulationsHeader}" FontWeight="Bold" Foreground="#1E40AF" FontSize="14" Margin="0,0,0,4"/>
                    <TextBox x:Name="RegulationsBox" Grid.Row="3" Style="{StaticResource MultiBox}" Margin="0,0,0,12" MinHeight="120"/>
                    <TextBlock Grid.Row="4" Text="{DynamicResource Str_Win_ProgBook_NoticeHeader}" FontWeight="Bold" Foreground="#1E40AF" FontSize="14" Margin="0,0,0,4"/>
                    <TextBox x:Name="NoticeBox" Grid.Row="5" Style="{StaticResource MultiBox}" MinHeight="100"/>
                </Grid>
            </TabItem>

            <!-- 3. 重要活动日程 -->
            <TabItem Header="{DynamicResource Str_Win_ProgBook_TabActivities}">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#475569"
                               Text="{DynamicResource Str_Win_ProgBook_ActivitiesDesc}"/>
                    <DataGrid x:Name="ActivitiesGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="120"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Date}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Date"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="120"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_ProgBook_ColTime}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Time"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="200"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_ProgBook_ColActivity}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Activity"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="160"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_ProgBook_ColParticipants}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Participants"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Location}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Venue"/></DataGridTextColumn.Binding></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 4. 训练日程 -->
            <TabItem Header="{DynamicResource Str_Win_ProgBook_TabTraining}">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#475569"
                               Text="{DynamicResource Str_Win_ProgBook_TrainingDesc}"/>
                    <DataGrid x:Name="TrainingGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="160"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Date}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Date"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="200"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_ProgBook_ColTime}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Time"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Location}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Venue"/></DataGridTextColumn.Binding></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 5. 竞赛人员 -->
            <TabItem Header="{DynamicResource Str_Win_ProgBook_TabOfficials}">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#475569"
                               Text="{DynamicResource Str_Win_ProgBook_OfficialsDesc}"/>
                    <DataGrid x:Name="OfficialsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="200"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_ProgBook_ColOfficialTitle}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Title"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Name}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Name"/></DataGridTextColumn.Binding></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 6. 运动队人员 -->
            <TabItem Header="{DynamicResource Str_Win_ProgBook_TabTeamStaff}">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Foreground="#475569"
                                   Text="{DynamicResource Str_Win_ProgBook_TeamStaffDesc}"/>
                        <Button HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,5"
                                Content="{DynamicResource Str_Win_ProgBook_AutoFillBtn}" Click="AutoFillTeamStaff_Click" Background="#0EA5E9"/>
                    </StackPanel>
                    <DataGrid x:Name="TeamStaffGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="140"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Team}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="TeamName"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="160"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_UnitMgmt_ColLeader}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Leader"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="200"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_ProgBook_ColCoaches}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Coaches"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="160"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_ProgBook_ColDoctors}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Doctors"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_ProgBook_ColStaff}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Staff"/></DataGridTextColumn.Binding></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 7. 附注 -->
            <TabItem Header="{DynamicResource Str_Win_ProgBook_TabClosing}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Str_Win_ProgBook_ClosingHeader}"
                               FontWeight="Bold" Foreground="#1E40AF" FontSize="14" Margin="0,0,0,4"/>
                    <TextBox x:Name="ClosingBox" Grid.Row="1" Style="{StaticResource MultiBox}"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
