<Window x:Class="SwimmingScoreboard.ResultBookEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_ResultBook_Title}"
        Width="1020" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style x:Key="MultiBox" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei,SimSun"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="AlternatingRowBackground" Value="#F1F5F9"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,18,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#B45309" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Win_ResultBook_Title}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Foreground="#FEF3C7" Margin="0,4,0,0" FontSize="12"
                           Text="{DynamicResource Str_Win_ResultBook_HeaderDesc}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#E2E8F0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str_Win_ProgBook_PreviewBtn}" Click="Preview_Click" Background="#0EA5E9"/>
                <Button Content="{DynamicResource Str_Win_ResultBook_SavePrintBtn}" Click="SavePrint_Click" Background="#22C55E"
                        ToolTip="{DynamicResource Str_Win_ResultBook_SavePrintTip}"/>
                <Button Content="{DynamicResource Str_Win_ResultBook_ExportDocBtn}" Click="ExportDoc_Click" Background="#0284C7"
                        ToolTip="{DynamicResource Str_Win_ResultBook_ExportDocTip}"/>
                <Button Content="{DynamicResource Str_Win_ProgBook_ResetBtn}" Click="Reset_Click" Background="#94A3B8"/>
                <Button Content="{DynamicResource Str_Btn_Save}" Click="Save_Click" Background="#3B82F6"/>
                <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" Background="#EF4444"/>
            </StackPanel>
        </Border>

        <TabControl Margin="10">
            <!-- 1. 封面 / 前言 / 尾页 -->
            <TabItem Header="{DynamicResource Str_Win_ResultBook_TabCover}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_Win_ProgBook_CoverTitleLabel}" Foreground="#475569" Grid.Row="0" Grid.Column="0" Margin="0,8" VerticalAlignment="Center"/>
                    <TextBox x:Name="CoverTitleBox" Grid.Row="0" Grid.Column="1" Margin="0,8"/>
                    <TextBlock Text="{DynamicResource Str_Win_ProgBook_CoverSubtitleLabel}" Foreground="#475569" Grid.Row="1" Grid.Column="0" Margin="0,8" VerticalAlignment="Center"/>
                    <TextBox x:Name="CoverSubtitleBox" Grid.Row="1" Grid.Column="1" Margin="0,8"/>
                    <TextBlock Text="{DynamicResource Str_Win_ProgBook_VenueImageLabel}" Foreground="#475569" Grid.Row="2" Grid.Column="0" Margin="0,8" VerticalAlignment="Center"/>
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,8">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Str_Win_ResultBook_PickBtn}" Click="PickVenueImage_Click" Background="#3B82F6"/>
                        <Button DockPanel.Dock="Right" Content="{DynamicResource Str_Win_ProgBook_ClearBtn}" Click="ClearVenueImage_Click" Background="#94A3B8"/>
                        <TextBox x:Name="VenueImagePathBox" IsReadOnly="True" Background="#F1F5F9"/>
                    </DockPanel>
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{DynamicResource Str_Win_ResultBook_ForewordHeader}" FontWeight="Bold" Foreground="#B45309" Margin="0,12,0,4"/>
                    <TextBox x:Name="ForewordBox" Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource MultiBox}" MinHeight="120"/>
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{DynamicResource Str_Win_ResultBook_ClosingHeader}" FontWeight="Bold" Foreground="#B45309" Margin="0,12,0,4"/>
                    <TextBox x:Name="ClosingBox" Grid.Row="6" Grid.ColumnSpan="2" Style="{StaticResource MultiBox}" MinHeight="100"/>
                </Grid>
            </TabItem>

            <!-- 2. 体育道德风尚奖 -->
            <TabItem Header="{DynamicResource Str_Win_ResultBook_TabSportsmanship}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Foreground="#475569" Margin="0,0,0,10"
                               Text="{DynamicResource Str_Win_ResultBook_SportsmanshipDesc}"/>
                    <TextBlock Grid.Row="1" Text="{DynamicResource Str_Win_ResultBook_SportsTeamsLabel}" FontWeight="Bold" Foreground="#B45309" Margin="0,4,0,4"/>
                    <TextBox x:Name="SportsTeamsBox" Grid.Row="2" Style="{StaticResource MultiBox}" MinHeight="80"/>
                    <TextBlock Grid.Row="3" Text="{DynamicResource Str_Win_ResultBook_SportsAthletesLabel}" FontWeight="Bold" Foreground="#B45309" Margin="0,12,0,4"/>
                    <TextBox x:Name="SportsAthletesBox" Grid.Row="4" Style="{StaticResource MultiBox}" MinHeight="120"/>
                    <TextBlock Grid.Row="5" Text="{DynamicResource Str_Win_ResultBook_SportsJudgesLabel}" FontWeight="Bold" Foreground="#B45309" Margin="0,12,0,4"/>
                    <TextBox x:Name="SportsJudgesBox" Grid.Row="6" Style="{StaticResource MultiBox}" MinHeight="80"/>
                </Grid>
            </TabItem>

            <!-- 3. 教练员 / 联合培养单位 -->
            <TabItem Header="{DynamicResource Str_Win_ResultBook_TabCoach}">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Foreground="#475569"
                                   Text="{DynamicResource Str_Win_ResultBook_CoachDesc}"/>
                        <Button HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,5"
                                Content="{DynamicResource Str_Win_ResultBook_AutoFillBtn}" Click="AutoFillSwimmers_Click" Background="#0EA5E9"/>
                    </StackPanel>
                    <DataGrid x:Name="SwimmerInfoGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="80"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_BibNo}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="BibNumber"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="140"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Name}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Name"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="140"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Team}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Country"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="200"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_ResultBook_ColCoach}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Coach"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_ResultBook_ColJointTraining}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="JointTrainingUnit"/></DataGridTextColumn.Binding></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 4. 显示选项 -->
            <TabItem Header="{DynamicResource Str_Win_ResultBook_TabDisplayOpts}">
                <StackPanel Margin="20">
                    <TextBlock Text="{DynamicResource Str_Win_ResultBook_DisplayOptsHeader}" FontWeight="Bold" Foreground="#B45309" FontSize="14" Margin="0,0,0,12"/>
                    <CheckBox x:Name="OptMedalCount" Content="{DynamicResource Str_Win_ResultBook_OptMedalCount}"/>
                    <CheckBox x:Name="OptSportsAwards" Content="{DynamicResource Str_Win_ResultBook_TabSportsmanship}"/>
                    <CheckBox x:Name="OptRecordStats" Content="{DynamicResource Str_Win_ResultBook_OptRecordStats}"/>
                    <CheckBox x:Name="OptFinalRanking" Content="{DynamicResource Str_Win_ResultBook_OptFinalRanking}"/>
                    <CheckBox x:Name="OptFullResults" Content="{DynamicResource Str_Win_ResultBook_OptFullResults}"/>

                    <TextBlock Text="{DynamicResource Str_Win_ResultBook_FullResultsOptsHeader}" FontWeight="Bold" Foreground="#B45309" FontSize="14" Margin="0,18,0,8"/>
                    <CheckBox x:Name="OptShowSplits" Content="{DynamicResource Str_Win_ResultBook_OptShowSplits}"/>
                    <CheckBox x:Name="OptShowDiff" Content="{DynamicResource Str_Win_ResultBook_OptShowDiff}"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
