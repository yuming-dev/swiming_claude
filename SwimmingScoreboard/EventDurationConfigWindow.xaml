<Window x:Class="SwimmingScoreboard.EventDurationConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目用时设置" Width="660" Height="560"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="项目用时设置（分钟/组）" FontSize="15" FontWeight="Bold" Foreground="#1E40AF"/>
            <TextBlock Text="一键秩序册排日程时按这张表估算每组用时；Tab 3 「分/组」列可对单条手动覆盖" Foreground="#475569" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：个人项目 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="个人项目（按距离）" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <DataGrid x:Name="IndividualGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"
                              CanUserDeleteRows="True" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="距离 (米)" Binding="{Binding Distance}" Width="*"/>
                            <DataGridTextColumn Header="分钟/组" Binding="{Binding Minutes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 右：接力项目 -->
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="接力项目（按总距离）" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <DataGrid x:Name="RelayGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"
                              CanUserDeleteRows="True" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="总距离 (米)" Binding="{Binding Distance}" Width="*"/>
                            <DataGridTextColumn Header="分钟/组" Binding="{Binding Minutes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="项目间空隙 (分钟):" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="GapMinBox" Width="50" Margin="6,0,12,0" Padding="3" VerticalAlignment="Center"/>
                <TextBlock Text="兜底个人:" VerticalAlignment="Center"/>
                <TextBox x:Name="DefaultIndiBox" Width="40" Margin="4,0,12,0" Padding="3" VerticalAlignment="Center"/>
                <TextBlock Text="兜底接力:" VerticalAlignment="Center"/>
                <TextBox x:Name="DefaultRelayBox" Width="40" Margin="4,0,0,0" Padding="3" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="↻ 恢复默认" Click="ResetDefaults_Click" Padding="12,6"
                        Background="#F59E0B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="✓ 保存" Click="Save_Click" Padding="14,6" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="取消" Click="Cancel_Click" Padding="14,6"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
