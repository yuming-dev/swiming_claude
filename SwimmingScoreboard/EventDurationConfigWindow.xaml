<Window x:Class="SwimmingScoreboard.EventDurationConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_EvtDur_Title}" Width="660" Height="560"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource Str_Win_EvtDur_Title}" FontSize="15" FontWeight="Bold" Foreground="#1E40AF"/>
            <TextBlock Text="{DynamicResource Str_Win_EvtDur_Desc}" Foreground="#475569" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：个人项目 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Str_Win_EvtDur_Individual}" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <DataGrid x:Name="IndividualGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"
                              CanUserDeleteRows="True" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EvtDur_ColDistance}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Distance"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EvtDur_ColMinutes}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Minutes"/></DataGridTextColumn.Binding></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 右：接力项目 -->
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Str_Win_EvtDur_Relay}" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                    <DataGrid x:Name="RelayGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"
                              CanUserDeleteRows="True" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EvtDur_ColTotalDistance}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Distance"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EvtDur_ColMinutes}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Minutes"/></DataGridTextColumn.Binding></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Str_Win_EvtDur_GapLabel}" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="GapMinBox" Width="50" Margin="6,0,12,0" Padding="3" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Str_Win_EvtDur_DefaultIndi}" VerticalAlignment="Center"/>
                <TextBox x:Name="DefaultIndiBox" Width="40" Margin="4,0,12,0" Padding="3" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Str_Win_EvtDur_DefaultRelay}" VerticalAlignment="Center"/>
                <TextBox x:Name="DefaultRelayBox" Width="40" Margin="4,0,0,0" Padding="3" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="{DynamicResource Str_Win_EvtDur_ResetBtn}" Click="ResetDefaults_Click" Padding="12,6"
                        Background="#F59E0B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Str_Win_EvtDur_SaveBtn}" Click="Save_Click" Padding="14,6" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" Padding="14,6"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
