<Window x:Class="SwimmingScoreboard.DepartmentBulletinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_DeptBulletin_Title}" Width="900" Height="600"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{DynamicResource Str_Win_DeptBulletin_Header}"
                   FontSize="15" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,10"/>

        <!-- 左侧单位列表（多选）-->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource Str_Win_DeptBulletin_UnitListLabel}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UnitSummaryText" Text="" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#475569" FontSize="11"/>
                    <Button Content="{DynamicResource Str_Win_AwardCert_SelectAllBtn}" Click="SelectAll_Click" Padding="8,2" Margin="16,0,4,0" FontSize="11" Background="#64748B" Foreground="White" BorderThickness="0"/>
                    <Button Content="{DynamicResource Str_Win_AwardCert_SelectNoneBtn}" Click="SelectNone_Click" Padding="8,2" FontSize="11" Background="#94A3B8" Foreground="White" BorderThickness="0"/>
                </StackPanel>
                <ListBox x:Name="UnitListBox" Grid.Row="1" SelectionMode="Multiple"/>
            </Grid>
        </Border>

        <!-- 右侧筛选 -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Win_DeptBulletin_FilterHeader}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <RadioButton x:Name="FilterAllAthletes" Content="{DynamicResource Str_Win_DeptBulletin_FilterAll}" IsChecked="True" Margin="0,3,0,3" GroupName="Filter"/>
                    <RadioButton x:Name="FilterScoredOnly" Content="{DynamicResource Str_Win_DeptBulletin_FilterScoredOnly}" Margin="0,3,0,3" GroupName="Filter"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Win_DeptBulletin_ScopeHeader}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <RadioButton x:Name="ScopeAll" Content="{DynamicResource Str_Win_DeptBulletin_ScopeAll}" IsChecked="True" Margin="0,3,0,3" GroupName="Scope"/>
                    <RadioButton x:Name="ScopeByAgeGroup" Content="{DynamicResource Str_Win_DeptBulletin_ScopeByAgeGroup}" Margin="0,3,0,3" GroupName="Scope"/>
                </StackPanel>
            </Border>
            <Border Background="#DBEAFE" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="10,6">
                <TextBlock Foreground="#1E3A8A" FontSize="11" TextWrapping="Wrap">
                    <Run FontWeight="Bold" Text="{DynamicResource Str_Win_DeptBulletin_TipLabel}"/>
                    <Run Text="{DynamicResource Str_Win_DeptBulletin_TipBody1}"/><LineBreak/>
                    <Run Text="{DynamicResource Str_Win_DeptBulletin_TipBody2}"/>
                </TextBlock>
            </Border>
        </StackPanel>

        <!-- 底部按钮 -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="GenStatusText" VerticalAlignment="Center" Foreground="#22C55E" FontWeight="Bold"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Str_Win_DeptBulletin_GenerateBtn}" Click="Generate_Click" Padding="14,6" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Btn_Close}" Click="Close_Click" Padding="16,6"
                        Background="#475569" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
