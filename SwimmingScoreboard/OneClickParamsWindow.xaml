<Window x:Class="SwimmingScoreboard.OneClickParamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一键全自动 — 比赛日程参数" Width="540" Height="500"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="比赛日程参数" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="时间范围" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="比赛开始日期:" Width="120" VerticalAlignment="Center"/>
                            <TextBox x:Name="StartDateBox" Width="120" Padding="4" VerticalAlignment="Center"/>
                            <TextBlock Text=" (yyyy-MM-dd)" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="比赛天数:" Width="120" VerticalAlignment="Center"/>
                            <ComboBox x:Name="DaysCombo" Width="80" VerticalAlignment="Center">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3" IsSelected="True"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="每日时段起始时间" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="上午开始:" Width="80" VerticalAlignment="Center"/>
                            <TextBox x:Name="MorningBox" Text="08:30" Width="70" Padding="4" VerticalAlignment="Center"/>
                            <TextBlock Text=" 下午开始:" Width="80" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <TextBox x:Name="AfternoonBox" Text="13:30" Width="70" Padding="4" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="晚上开始:" Width="80" VerticalAlignment="Center"/>
                            <TextBox x:Name="EveningBox" Text="19:00" Width="70" Padding="4" VerticalAlignment="Center"/>
                            <TextBlock Text=" 每场最长(分):" Width="100" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <TextBox x:Name="MaxSessionMinBox" Text="240" Width="60" Padding="4" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="编排策略" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                        <RadioButton x:Name="StrategyAuto" Content="自动区分预赛/半决赛/决赛 (推荐)" IsChecked="True" Margin="0,3,0,3" GroupName="Strat"
                                     ToolTip="预赛/次复赛→上午、半决赛→下午、决赛→晚上"/>
                        <RadioButton x:Name="StrategyFinalOnly" Content="全部按决赛 (无预赛流程)" Margin="0,3,0,3" GroupName="Strat"/>
                        <CheckBox x:Name="FirstDayMorningSkip" Content="第一天上午不安排比赛（用于报到/技术会议）" Margin="0,8,0,3"/>
                        <CheckBox x:Name="LastDayAfternoonSkip" Content="最后一天下午不安排比赛" Margin="0,3,0,3"/>
                    </StackPanel>
                </Border>

                <Border Background="#DBEAFE" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <TextBlock Foreground="#1E3A8A" FontSize="11" TextWrapping="Wrap">
                        <Run FontWeight="Bold">说明：</Run>
                        点确定后，自动跑「统计赛次 → 派生待分配 → 多天分配时段 → 写回赛程」全流程。完成后可在 Tab 3 微调每条的「分/组」用时，或直接进 Tab 4 生成 .xlsx 秩序册。
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="✓ 开始生成" Click="Ok_Click" Padding="18,8" Margin="0,0,8,0"
                        Background="#7C3AED" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="取消" Click="Cancel_Click" Padding="16,8"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
