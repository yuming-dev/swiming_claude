<Window x:Class="SwimmingScoreboard.OneClickParamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_OneClick_Title}" Width="540" Height="500"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Str_Win_OneClick_Header}" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Win_OneClick_TimeRange}" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="{DynamicResource Str_Win_OneClick_StartDate}" Width="120" VerticalAlignment="Center"/>
                            <TextBox x:Name="StartDateBox" Width="120" Padding="4" VerticalAlignment="Center"/>
                            <TextBlock Text=" (yyyy-MM-dd)" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="{DynamicResource Str_Win_OneClick_Days}" Width="120" VerticalAlignment="Center"/>
                            <ComboBox x:Name="DaysCombo" Width="80" VerticalAlignment="Center">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3" IsSelected="True"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Win_OneClick_SessionStart}" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="{DynamicResource Str_Win_OneClick_Morning}" Width="80" VerticalAlignment="Center"/>
                            <TextBox x:Name="MorningBox" Text="08:30" Width="70" Padding="4" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_Win_OneClick_Afternoon}" Width="80" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <TextBox x:Name="AfternoonBox" Text="13:30" Width="70" Padding="4" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="{DynamicResource Str_Win_OneClick_Evening}" Width="80" VerticalAlignment="Center"/>
                            <TextBox x:Name="EveningBox" Text="19:00" Width="70" Padding="4" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_Win_OneClick_MaxSession}" Width="100" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <TextBox x:Name="MaxSessionMinBox" Text="240" Width="60" Padding="4" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Win_OneClick_Strategy}" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                        <RadioButton x:Name="StrategyAuto" Content="{DynamicResource Str_Win_OneClick_StrategyAuto}" IsChecked="True" Margin="0,3,0,3" GroupName="Strat"
                                     ToolTip="{DynamicResource Str_Win_OneClick_StrategyAutoTip}"/>
                        <RadioButton x:Name="StrategyFinalOnly" Content="{DynamicResource Str_Win_OneClick_StrategyFinalOnly}" Margin="0,3,0,3" GroupName="Strat"/>
                        <CheckBox x:Name="FirstDayMorningSkip" Content="{DynamicResource Str_Win_OneClick_SkipFirstMorning}" Margin="0,8,0,3"/>
                        <CheckBox x:Name="LastDayAfternoonSkip" Content="{DynamicResource Str_Win_OneClick_SkipLastAfternoon}" Margin="0,3,0,3"/>
                    </StackPanel>
                </Border>

                <Border Background="#DBEAFE" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <TextBlock Foreground="#1E3A8A" FontSize="11" TextWrapping="Wrap">
                        <Run FontWeight="Bold" Text="{DynamicResource Str_Win_OneClick_NoteLabel}"/>
                        <Run Text="{DynamicResource Str_Win_OneClick_NoteBody}"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Str_Win_OneClick_StartBtn}" Click="Ok_Click" Padding="18,8" Margin="0,0,8,0"
                        Background="#7C3AED" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" Padding="16,8"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
