<Window x:Class="SwimmingScoreboard.SchedulingWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_SchedWizard_Title}" Width="1340" Height="680" MinWidth="1100" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航树 — 5 步流程 -->
        <Border Grid.Column="0" Background="#1E40AF" BorderBrush="#1E3A8A" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="{DynamicResource Str_Win_SchedWizard_Title}" Foreground="White" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         Foreground="White" FontSize="13" SelectionChanged="NavList_SelectionChanged">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem Content="{DynamicResource Str_Win_SchedWizard_NavStep1}"/>
                    <ListBoxItem Content="{DynamicResource Str_Win_SchedWizard_NavStep2}"/>
                    <ListBoxItem Content="{DynamicResource Str_Win_SchedWizard_NavStep3}"/>
                    <ListBoxItem Content="{DynamicResource Str_Win_SchedWizard_NavStep4}"/>
                    <ListBoxItem Content="{DynamicResource Str_Win_SchedWizard_NavStep5}"/>
                </ListBox>
                <Border Background="#1E3A8A" Margin="8,24,8,8" Padding="10" CornerRadius="4">
                    <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="11">
                        <Run FontWeight="Bold" Foreground="White" Text="{DynamicResource Str_Win_SchedWizard_TipHeader}"/><LineBreak/>
                        <Run Text="{DynamicResource Str_Win_SchedWizard_TipStep1}"/><LineBreak/>
                        <Run Text="{DynamicResource Str_Win_SchedWizard_TipStep2}"/><LineBreak/>
                        <Run Text="{DynamicResource Str_Win_SchedWizard_TipStep3}"/><LineBreak/>
                        <Run Text="{DynamicResource Str_Win_SchedWizard_TipStep4}"/><LineBreak/>
                        <Run Text="{DynamicResource Str_Win_SchedWizard_TipStep5}"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- 右侧主区 — 按导航切换 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                <TextBlock x:Name="TitleText" Text="{DynamicResource Str_Win_SchedWizard_TitleTextDefault}" FontSize="20" FontWeight="Bold" Foreground="#1E40AF"/>
            </Border>

            <!-- 内容区：5 个面板按 Visibility 切换 -->
            <Grid Grid.Row="1">

                <!-- ═══ Tab 1: 赛次开设计划 ═══ -->
                <Grid x:Name="Tab1Panel" Visibility="Visible" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Str_Win_SchedWizard_StagePlanLabel}" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Tab1CountText" Text="{DynamicResource Str_Win_SchedWizard_CountDefault}" Margin="8,0,16,0" VerticalAlignment="Center" Foreground="#475569"/>
                        <Button x:Name="AutoComputeBtn" Content="{DynamicResource Str_Win_SchedWizard_AutoComputeBtn}" Click="AutoComputeStages_Click"
                                Padding="14,6" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                ToolTip="{DynamicResource Str_Win_SchedWizard_AutoComputeTip}"/>
                        <Button x:Name="ResetEditsBtn" Content="{DynamicResource Str_Win_SchedWizard_ResetEditsBtn}" Click="ResetEdits_Click"
                                Padding="10,6" Margin="8,0,0,0" Background="#64748B" Foreground="White" BorderThickness="0"
                                ToolTip="{DynamicResource Str_Win_SchedWizard_ResetEditsTip}"/>
                        <Border Width="1" Background="#94A3B8" Margin="14,2,14,2"/>
                        <Button x:Name="OneClickBtn" Content="{DynamicResource Str_Win_SchedWizard_OneClickBtn}" Click="OneClickGenerate_Click"
                                Padding="16,7" Background="#7C3AED" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0"
                                ToolTip="{DynamicResource Str_Win_SchedWizard_OneClickTip}"/>
                    </StackPanel>

                    <DataGrid x:Name="StagePlanGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column"
                              CellEditEnding="StagePlanGrid_CellEditEnding">
                        <!-- 2026-05-25 列宽缩小+颜色分组：预赛=蓝/次复赛=橙/决赛=绿；醒目区分易于修改 -->
                        <DataGrid.Resources>
                            <Style x:Key="PrelimCellStyle" TargetType="DataGridCell">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="QuarterCellStyle" TargetType="DataGridCell">
                                <Setter Property="Background" Value="#FED7AA"/>
                                <Setter Property="Foreground" Value="#9A3412"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="SemiCellStyle" TargetType="DataGridCell">
                                <Setter Property="Background" Value="#E9D5FF"/>
                                <Setter Property="Foreground" Value="#6B21A8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="FinalCellStyle" TargetType="DataGridCell">
                                <Setter Property="Background" Value="#BBF7D0"/>
                                <Setter Property="Foreground" Value="#15803D"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="PrelimHdrStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                            <Style x:Key="QuarterHdrStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F97316"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                            <Style x:Key="SemiHdrStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#A855F7"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                            <Style x:Key="FinalHdrStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#22C55E"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="75" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColAgeGroup}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="AgeGroup"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="45" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Sex}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Gender"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="160" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColEvent}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="EventName"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="65" IsReadOnly="True">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColParticipants}"/></DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding><Binding Path="ParticipantsLabel"/></DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- 预赛 (蓝) -->
                            <DataGridTextColumn Width="55"
                                                CellStyle="{StaticResource PrelimCellStyle}" HeaderStyle="{StaticResource PrelimHdrStyle}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColPrelimHeats}"/></DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding><Binding Path="PrelimHeats"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="55"
                                                CellStyle="{StaticResource PrelimCellStyle}" HeaderStyle="{StaticResource PrelimHdrStyle}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColPrelimCutoff}"/></DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding><Binding Path="PrelimCutoff"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <!-- 次/复赛 (橙) -->
                            <DataGridTextColumn Width="60"
                                                CellStyle="{StaticResource QuarterCellStyle}" HeaderStyle="{StaticResource QuarterHdrStyle}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColQuarterHeats}"/></DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding><Binding Path="QuarterHeats"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="60"
                                                CellStyle="{StaticResource QuarterCellStyle}" HeaderStyle="{StaticResource QuarterHdrStyle}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColQuarterCutoff}"/></DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding><Binding Path="QuarterCutoff"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <!-- 半决赛 (紫) -->
                            <DataGridTextColumn Width="55"
                                                CellStyle="{StaticResource SemiCellStyle}" HeaderStyle="{StaticResource SemiHdrStyle}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColSemiHeats}"/></DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding><Binding Path="SemiHeats"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="55"
                                                CellStyle="{StaticResource SemiCellStyle}" HeaderStyle="{StaticResource SemiHdrStyle}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColSemiCutoff}"/></DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding><Binding Path="SemiCutoff"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <!-- 决赛 (绿) -->
                            <DataGridTextColumn Width="55"
                                                CellStyle="{StaticResource FinalCellStyle}" HeaderStyle="{StaticResource FinalHdrStyle}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColFinalHeats}"/></DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding><Binding Path="FinalHeats"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="55"
                                                CellStyle="{StaticResource FinalCellStyle}" HeaderStyle="{StaticResource FinalHdrStyle}">
                                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColFinalCutoff}"/></DataGridTextColumn.Header>
                                <DataGridTextColumn.Binding><Binding Path="FinalCutoff"/></DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                            CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <TextBlock Foreground="#92400E" FontSize="12" TextWrapping="Wrap">
                            <Run FontWeight="Bold">提示：</Run>
                            1. 点击 「自动统计赛次」 按报名人数自动算每项目的轮次结构与组数。
                            2. 4 个赛次的「组数 / 录取」单元格可手动修改覆盖自动结果。
                            3. 取消开设某赛次：将该赛次的组数和录取都清 0 或留空即可。
                            4. 调整完点击右下「下一步」进入日程编排。
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- ═══ Tab 2: 赛次设置方法 ═══ -->
                <Grid x:Name="Tab2Panel" Visibility="Collapsed" Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="800">
                            <TextBlock Text="{DynamicResource Str_Win_SchedWizard_MethodHeader}" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,12"/>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#22C55E" Text="{DynamicResource Str_Win_SchedWizard_Method1Title}"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{DynamicResource Str_Win_SchedWizard_Method1Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#3B82F6" Text="{DynamicResource Str_Win_SchedWizard_Method2Title}"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{DynamicResource Str_Win_SchedWizard_Method2Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Text="{DynamicResource Str_Win_SchedWizard_Method3Title}"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{DynamicResource Str_Win_SchedWizard_Method3Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#8B5CF6" Text="{DynamicResource Str_Win_SchedWizard_Method4Title}"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{DynamicResource Str_Win_SchedWizard_Method4Body}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,8,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#991B1B" Text="{DynamicResource Str_Win_SchedWizard_CancelEventTitle}"/>
                                    <TextBlock FontSize="12" Foreground="#7F1D1D" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{DynamicResource Str_Win_SchedWizard_CancelEventBody}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#DBEAFE" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,8,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Text="{DynamicResource Str_Win_SchedWizard_LongDistTitle}"/>
                                    <TextBlock FontSize="12" Foreground="#1E3A8A" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{DynamicResource Str_Win_SchedWizard_LongDistBody}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ═══ Tab 3: 双面板日程编排器 ═══ -->
                <Grid x:Name="Tab3Panel" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部状态行 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str_Win_SchedWizard_PendingLabel}" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock x:Name="DistPendingText" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#EF4444" Margin="2,0,12,0"/>
                            <TextBlock Text="{DynamicResource Str_Win_SchedWizard_SortByLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="DistSortCombo" Width="120" VerticalAlignment="Center" SelectionChanged="DistSort_Changed">
                                <ComboBoxItem Content="按比赛项目" IsSelected="True"/>
                                <ComboBoxItem Content="按比赛组别"/>
                                <ComboBoxItem Content="按赛次"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str_Win_SchedWizard_AssignedLabel}" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock x:Name="DistAssignedText" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#22C55E" Margin="2,0,12,0"/>
                            <TextBlock Text="{DynamicResource Str_Col_Date}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="DistDayCombo" Width="120" VerticalAlignment="Center" SelectionChanged="DistDay_Changed"/>
                            <TextBlock Text="{DynamicResource Str_Win_SchedWizard_SessionLabel}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox x:Name="DistSessionCombo" Width="80" VerticalAlignment="Center" SelectionChanged="DistSession_Changed">
                                <ComboBoxItem Content="上午" IsSelected="True"/>
                                <ComboBoxItem Content="下午"/>
                                <ComboBoxItem Content="晚上"/>
                            </ComboBox>
                            <!-- 2026-05-25 开始时间输入 — 输入完按回车 / 失焦即重算右侧表的所有比赛时间 -->
                            <TextBlock Text="{DynamicResource Str_Win_SchedWizard_StartTimeLabel}" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="DistStartTimeBox" Width="80" VerticalAlignment="Center" Padding="3"
                                     ToolTip="{DynamicResource Str_Win_SchedWizard_StartTimeTip}"
                                     KeyDown="DistStartTime_KeyDown" LostFocus="DistStartTime_LostFocus"/>
                        </StackPanel>
                    </Grid>

                    <!-- 主区：左面板 + 中间按钮 + 右面板 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左面板：待分配 -->
                        <DataGrid x:Name="DistPendingGrid" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" SelectionMode="Extended" AlternatingRowBackground="#F8FAFC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="60"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Group}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="AgeGroup"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <DataGridTextColumn Width="40"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Sex}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Gender"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColEvent}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="EventName"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <DataGridTextColumn Width="55"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColCount}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="ParticipantsLabel"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <DataGridTextColumn Width="40"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_BatchAge_ColHeatCount}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Heats"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <DataGridTextColumn Width="80"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColStage}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="StageDisplay"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 中间按钮组 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                            <Button Content="▲" Click="DistMoveUp_Click" Margin="0,4" Padding="0,8"
                                    Background="#22C55E" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                    ToolTip="{DynamicResource Str_Win_SchedWizard_MoveUpTip}"/>
                            <Button Content="▼" Click="DistMoveDown_Click" Margin="0,4" Padding="0,8"
                                    Background="#22C55E" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                    ToolTip="{DynamicResource Str_Win_SchedWizard_MoveDownTip}"/>
                            <Button Content="{DynamicResource Str_Win_SchedWizard_AutoBtn}" Click="DistAuto_Click" Margin="0,12,0,4" Padding="0,8"
                                    Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                    ToolTip="{DynamicResource Str_Win_SchedWizard_AutoBtnTip}"/>
                            <Button Content="←" Click="DistMoveBack_Click" Margin="0,12,0,4" Padding="0,8"
                                    Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                    ToolTip="{DynamicResource Str_Win_SchedWizard_MoveBackTip}"/>
                            <Button Content="←←" Click="DistMoveBackAll_Click" Margin="0,4" Padding="0,8"
                                    Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                    ToolTip="{DynamicResource Str_Win_SchedWizard_MoveBackAllTip}"/>
                        </StackPanel>

                        <!-- 右面板：已分配（当前日期+时段内的项目） -->
                        <DataGrid x:Name="DistAssignedGrid" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="False" SelectionMode="Extended" AlternatingRowBackground="#F8FAFC"
                                  CellEditEnding="DistAssignedGrid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="40" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColSeq}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="SeqInSession"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <DataGridTextColumn Width="60" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Group}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="AgeGroup"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <DataGridTextColumn Width="40" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Sex}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Gender"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <DataGridTextColumn Width="*" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColEvent}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="EventName"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <DataGridTextColumn Width="55" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColCount}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="ParticipantsLabel"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <DataGridTextColumn Width="40" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_BatchAge_ColHeatCount}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Heats"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <DataGridTextColumn Width="80" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColStage}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="StageDisplay"/></DataGridTextColumn.Binding></DataGridTextColumn>
                                <!-- 2026-05-25 分/组红字加粗，便于一眼定位修改 -->
                                <DataGridTextColumn Width="55">
                                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColMinPerHeat}"/></DataGridTextColumn.Header>
                                    <DataGridTextColumn.Binding><Binding Path="MinPerHeat"/></DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- 2026-05-25 比赛时间可手改, 回车后该时段后续项目时间联动重算 -->
                                <DataGridTextColumn Width="80">
                                    <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColAssignedTime}"/></DataGridTextColumn.Header>
                                    <DataGridTextColumn.Binding><Binding Path="AssignedTime" UpdateSourceTrigger="PropertyChanged"/></DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1E40AF"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- 底部模式选择 + 生成秩序册 -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str_Win_SchedWizard_ModeLabel}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                            <RadioButton x:Name="DistModeAuto" Content="{DynamicResource Str_Win_SchedWizard_ModeAuto}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                                         ToolTip="{DynamicResource Str_Win_SchedWizard_ModeAutoTip}"/>
                            <RadioButton x:Name="DistModeStrictTime" Content="{DynamicResource Str_Win_SchedWizard_ModeStrictTime}" VerticalAlignment="Center" Margin="0,0,12,0"
                                         ToolTip="{DynamicResource Str_Win_SchedWizard_ModeStrictTimeTip}"/>
                            <RadioButton x:Name="DistModeFinalOnly" Content="{DynamicResource Str_Win_SchedWizard_ModeFinalOnly}" VerticalAlignment="Center"
                                         ToolTip="{DynamicResource Str_Win_SchedWizard_ModeFinalOnlyTip}"/>
                        </StackPanel>
                        <Button x:Name="DistApplyBtn" Grid.Column="1" Content="{DynamicResource Str_Win_SchedWizard_ApplyBtn}" Click="DistApply_Click"
                                Padding="14,8" Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                ToolTip="{DynamicResource Str_Win_SchedWizard_ApplyBtnTip}"/>
                    </Grid>
                </Grid>

                <!-- ═══ Tab 4: 秩序册可选文档 15 项 ═══ -->
                <Grid x:Name="Tab4Panel" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Str_Win_SchedWizard_DocSectionsHeader}" FontSize="13" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DocSectionsPanel">
                            <!-- 15 CheckBoxes 由 .cs 在构造时填充 -->
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="{DynamicResource Str_Win_SchedWizard_DocEditPrintBtn}" Click="DocEditPrint_Click" Padding="10,5" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0"
                                    ToolTip="{DynamicResource Str_Win_SchedWizard_DocEditPrintTip}"/>
                            <Button Content="{DynamicResource Str_Win_SchedWizard_DocForceRegenBtn}" Click="DocForceRegen_Click" Padding="10,5" Background="#DC2626" Foreground="White" BorderThickness="0"
                                    ToolTip="{DynamicResource Str_Win_SchedWizard_DocForceRegenTip}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource Str_Win_SchedWizard_DocGenerateBtn}" Click="DocGenerate_Click"
                                Padding="14,8" Background="#7C3AED" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                ToolTip="{DynamicResource Str_Win_SchedWizard_DocGenerateTip}"/>
                    </Grid>
                </Grid>

                <!-- ═══ Tab 5: 运动员兼项统计 ═══ -->
                <Grid x:Name="Tab5Panel" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Str_Win_Promotion_AgeGroupLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="MultiEventAgeCombo" Width="120" VerticalAlignment="Center"/>
                        <Button Content="{DynamicResource Str_Win_SchedWizard_MultiEventComputeBtn}" Click="MultiEventCompute_Click"
                                Padding="14,6" Margin="12,0,0,0" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                        <TextBlock x:Name="MultiEventSummaryText" Text="" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#475569"/>
                    </StackPanel>
                    <DataGrid x:Name="MultiEventGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_BibNo}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="BibNumber"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="100"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Name}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Name"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="50"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Sex}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Gender"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="100"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Team}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Country"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="80"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColIndiCount}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="IndividualCount"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="80"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColRelayCount}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="RelayCount"/></DataGridTextColumn.Binding></DataGridTextColumn>
                            <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_SchedWizard_ColEventList}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="EventList"/></DataGridTextColumn.Binding></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="{DynamicResource Str_Win_StaffMgmt_ExportCsvBtn}" Click="MultiEventExport_Click"
                                Padding="14,6" Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </Grid>
                </Grid>

            </Grid>

            <!-- 底部按钮栏 -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StatusText" Text="" VerticalAlignment="Center"
                               Foreground="#475569" FontSize="12"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PrevBtn" Content="{DynamicResource Str_Win_SchedWizard_PrevBtn}" Click="Prev_Click" Padding="14,8" Margin="0,0,8,0"
                                Background="#94A3B8" Foreground="White" BorderThickness="0" IsEnabled="False"/>
                        <Button x:Name="NextBtn" Content="{DynamicResource Str_Win_SchedWizard_NextBtn}" Click="Next_Click" Padding="14,8" Margin="0,0,8,0"
                                Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                        <Button x:Name="CloseBtn" Content="{DynamicResource Str_Btn_Close}" Click="Close_Click" Padding="14,8"
                                Background="#475569" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
