<Window x:Class="SwimmingScoreboard.SchedulingWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="秩序册生成向导" Width="1100" Height="680"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航树 — 5 步流程 -->
        <Border Grid.Column="0" Background="#1E40AF" BorderBrush="#1E3A8A" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="秩序册生成向导" Foreground="White" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         Foreground="White" FontSize="13" SelectionChanged="NavList_SelectionChanged">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem Content="1.&#160;赛次开设计划"/>
                    <ListBoxItem Content="2.&#160;赛次设置方法"/>
                    <ListBoxItem Content="3.&#160;编排比赛日程表"/>
                    <ListBoxItem Content="4.&#160;秩序册可选文档"/>
                    <ListBoxItem Content="5.&#160;运动员兼项统计"/>
                </ListBox>
                <Border Background="#1E3A8A" Margin="8,24,8,8" Padding="10" CornerRadius="4">
                    <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="11">
                        <Run FontWeight="Bold" Foreground="White">操作提示</Run><LineBreak/>
                        ① 自动统计赛次<LineBreak/>
                        ② 阅读赛次设置方法<LineBreak/>
                        ③ 编排日程<LineBreak/>
                        ④ 选可选文档<LineBreak/>
                        ⑤ 生成秩序册
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- 右侧主区 — 按导航切换 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                <TextBlock x:Name="TitleText" Text="秩序册 &lt; 一键生成 &gt;" FontSize="20" FontWeight="Bold" Foreground="#1E40AF"/>
            </Border>

            <!-- 内容区：5 个面板按 Visibility 切换 -->
            <Grid Grid.Row="1">

                <!-- ═══ Tab 1: 赛次开设计划 ═══ -->
                <Grid x:Name="Tab1Panel" Visibility="Visible" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="赛次开设计划：" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Tab1CountText" Text="共 0 单项" Margin="8,0,16,0" VerticalAlignment="Center" Foreground="#475569"/>
                        <Button x:Name="AutoComputeBtn" Content="🔄 自动统计赛次" Click="AutoComputeStages_Click"
                                Padding="14,6" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                ToolTip="按报名人数 + FINA SW 3.1.1 规则自动计算每个 组别×性别×项目 的轮次结构 + 组数 + 录取数"/>
                        <Button x:Name="ResetEditsBtn" Content="撤销手动改动" Click="ResetEdits_Click"
                                Padding="10,6" Margin="8,0,0,0" Background="#64748B" Foreground="White" BorderThickness="0"
                                ToolTip="恢复到自动统计后的原始值"/>
                    </StackPanel>

                    <DataGrid x:Name="StagePlanGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column"
                              CellEditEnding="StagePlanGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="比赛组别" Binding="{Binding AgeGroup}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="项目" Binding="{Binding EventName}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="参赛人数" Binding="{Binding Participants}" Width="70" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="预赛-组数" Binding="{Binding PrelimHeats}" Width="75"/>
                            <DataGridTextColumn Header="预赛-录取" Binding="{Binding PrelimCutoff}" Width="75"/>
                            <DataGridTextColumn Header="次复赛-组数" Binding="{Binding QuarterHeats}" Width="80"/>
                            <DataGridTextColumn Header="次复赛-录取" Binding="{Binding QuarterCutoff}" Width="80"/>
                            <DataGridTextColumn Header="半决赛-组数" Binding="{Binding SemiHeats}" Width="80"/>
                            <DataGridTextColumn Header="半决赛-录取" Binding="{Binding SemiCutoff}" Width="80"/>
                            <DataGridTextColumn Header="决赛-组数" Binding="{Binding FinalHeats}" Width="75"/>
                            <DataGridTextColumn Header="决赛-录取" Binding="{Binding FinalCutoff}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                            CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <TextBlock Foreground="#92400E" FontSize="12" TextWrapping="Wrap">
                            <Run FontWeight="Bold">提示：</Run>
                            1. 点击 「自动统计赛次」 按报名人数自动算每项目的轮次结构与组数。
                            2. 4 个赛次的「组数 / 录取」单元格可手动修改覆盖自动结果。
                            3. 取消开设某赛次：将该赛次的组数和录取都清 0 或留空即可。
                            4. 调整完点击右下「下一步」进入日程编排。
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- ═══ Tab 2: 赛次设置方法 ═══ -->
                <Grid x:Name="Tab2Panel" Visibility="Collapsed" Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="800">
                            <TextBlock Text="赛次设置方法（按 World Aquatics SW 3.1.1）" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,12"/>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#22C55E" Text="① 开设 1 个轮次（决赛）"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0">
                                        ≤ 8 人或不需要预赛的项目，直接决赛。仅填「决赛-组数」和「决赛-录取」。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#3B82F6" Text="② 开设 2 个轮次（预赛 + 决赛）"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0">
                                        9-16 人 短距离 + 中长距离 / 接力 标准流程。预赛取前 8 名 → A 组决赛（可勾选 B 组决赛取 9-16 名）。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Text="③ 开设 3 个轮次（预赛 + 半决赛 + 决赛）"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0">
                                        ≥ 17 人 短距离项目（50/100/200 米）标准流程。预赛取前 16 → 半决赛 2 组取前 8 → 决赛 1 组。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#8B5CF6" Text="④ 开设 4 个轮次（预赛 + 次复赛 + 半决赛 + 决赛）"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0">
                                        大型赛事（如奥运 / 世锦赛）级别使用，超过 32 人时启用。中小赛事很少用到。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,8,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#991B1B" Text="🚫 取消开设某个项目"/>
                                    <TextBlock FontSize="12" Foreground="#7F1D1D" TextWrapping="Wrap" Margin="0,4,0,0">
                                        删除该项目所有赛次的「组数」和「录取」即可（清 0 或留空）。
                                        Tab 1 自动统计时该项目会被跳过，不进入秩序册。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="#DBEAFE" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,8,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Text="🏊 长距离 800 / 1500 米自由泳"/>
                                    <TextBlock FontSize="12" Foreground="#1E3A8A" TextWrapping="Wrap" Margin="0,4,0,0">
                                        FINA SW 3.1.1.6 ─ 不设预赛，所有报名者直接决赛阶段，按成绩切「快组（晚间）」+ 「慢组（白天）」，
                                        成绩合并排名。Tab 1 会自动识别这两项目并只填决赛组数 / 录取，预赛留空。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ═══ Tab 3-5: 占位 ═══ -->
                <Grid x:Name="Tab3Panel" Visibility="Collapsed" Margin="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🚧 编排比赛日程表" FontSize="20" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="(待实现 — 双面板可视化日程编排器，下个冲刺交付)" FontSize="13" Foreground="#94A3B8" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="Tab4Panel" Visibility="Collapsed" Margin="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📑 秩序册可选文档" FontSize="20" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="(待实现 — 15 项可选文档清单 + 输出 .xlsx 6-Sheet 模板，下个冲刺交付)" FontSize="13" Foreground="#94A3B8" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="Tab5Panel" Visibility="Collapsed" Margin="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📊 运动员兼项统计" FontSize="20" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="(待实现 — 按比赛组分析兼项分布，下个冲刺交付)" FontSize="13" Foreground="#94A3B8" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

            </Grid>

            <!-- 底部按钮栏 -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StatusText" Text="" VerticalAlignment="Center"
                               Foreground="#475569" FontSize="12"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PrevBtn" Content="◀ 上一步" Click="Prev_Click" Padding="14,8" Margin="0,0,8,0"
                                Background="#94A3B8" Foreground="White" BorderThickness="0" IsEnabled="False"/>
                        <Button x:Name="NextBtn" Content="下一步 ▶" Click="Next_Click" Padding="14,8" Margin="0,0,8,0"
                                Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                        <Button x:Name="CloseBtn" Content="关闭" Click="Close_Click" Padding="14,8"
                                Background="#475569" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
