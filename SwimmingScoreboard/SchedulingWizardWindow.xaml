<Window x:Class="SwimmingScoreboard.SchedulingWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="秩序册生成向导" Width="1340" Height="680" MinWidth="1100" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航树 — 5 步流程 -->
        <Border Grid.Column="0" Background="#1E40AF" BorderBrush="#1E3A8A" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="秩序册生成向导" Foreground="White" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         Foreground="White" FontSize="13" SelectionChanged="NavList_SelectionChanged">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem Content="1.&#160;赛次开设计划"/>
                    <ListBoxItem Content="2.&#160;赛次设置方法"/>
                    <ListBoxItem Content="3.&#160;编排比赛日程表"/>
                    <ListBoxItem Content="4.&#160;秩序册制作 &lt; 可选文档 &gt;"/>
                    <ListBoxItem Content="5.&#160;运动员兼项统计"/>
                </ListBox>
                <Border Background="#1E3A8A" Margin="8,24,8,8" Padding="10" CornerRadius="4">
                    <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="11">
                        <Run FontWeight="Bold" Foreground="White">操作提示</Run><LineBreak/>
                        ① 自动统计赛次<LineBreak/>
                        ② 阅读赛次设置方法<LineBreak/>
                        ③ 编排日程<LineBreak/>
                        ④ 选可选文档<LineBreak/>
                        ⑤ 生成秩序册
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- 右侧主区 — 按导航切换 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                <TextBlock x:Name="TitleText" Text="秩序册 &lt; 一键生成 &gt;" FontSize="20" FontWeight="Bold" Foreground="#1E40AF"/>
            </Border>

            <!-- 内容区：5 个面板按 Visibility 切换 -->
            <Grid Grid.Row="1">

                <!-- ═══ Tab 1: 赛次开设计划 ═══ -->
                <Grid x:Name="Tab1Panel" Visibility="Visible" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="赛次开设计划：" FontSize="14" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Tab1CountText" Text="共 0 单项" Margin="8,0,16,0" VerticalAlignment="Center" Foreground="#475569"/>
                        <Button x:Name="AutoComputeBtn" Content="🔄 自动统计赛次" Click="AutoComputeStages_Click"
                                Padding="14,6" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                ToolTip="按报名人数 + FINA SW 3.1.1 规则自动计算每个 组别×性别×项目 的轮次结构 + 组数 + 录取数"/>
                        <Button x:Name="ResetEditsBtn" Content="撤销手动改动" Click="ResetEdits_Click"
                                Padding="10,6" Margin="8,0,0,0" Background="#64748B" Foreground="White" BorderThickness="0"
                                ToolTip="恢复到自动统计后的原始值"/>
                        <Border Width="1" Background="#94A3B8" Margin="14,2,14,2"/>
                        <Button x:Name="OneClickBtn" Content="⚡ 一键全自动生成秩序册" Click="OneClickGenerate_Click"
                                Padding="16,7" Background="#7C3AED" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0"
                                ToolTip="自动统计赛次 → 多天时段编排 → 写回主程序赛程 → 跳转到生成 xlsx"/>
                    </StackPanel>

                    <DataGrid x:Name="StagePlanGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column"
                              CellEditEnding="StagePlanGrid_CellEditEnding">
                        <!-- 2026-05-25 列宽缩小+颜色分组：预赛=蓝/次复赛=橙/决赛=绿；醒目区分易于修改 -->
                        <DataGrid.Resources>
                            <Style x:Key="PrelimCellStyle" TargetType="DataGridCell">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="QuarterCellStyle" TargetType="DataGridCell">
                                <Setter Property="Background" Value="#FED7AA"/>
                                <Setter Property="Foreground" Value="#9A3412"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="SemiCellStyle" TargetType="DataGridCell">
                                <Setter Property="Background" Value="#E9D5FF"/>
                                <Setter Property="Foreground" Value="#6B21A8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="FinalCellStyle" TargetType="DataGridCell">
                                <Setter Property="Background" Value="#BBF7D0"/>
                                <Setter Property="Foreground" Value="#15803D"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="PrelimHdrStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                            <Style x:Key="QuarterHdrStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F97316"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                            <Style x:Key="SemiHdrStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#A855F7"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                            <Style x:Key="FinalHdrStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#22C55E"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="比赛组别" Binding="{Binding AgeGroup}" Width="75" IsReadOnly="True"/>
                            <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="45" IsReadOnly="True"/>
                            <DataGridTextColumn Header="比赛项目" Binding="{Binding EventName}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="参赛人数" Binding="{Binding ParticipantsLabel}" Width="65" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- 预赛 (蓝) -->
                            <DataGridTextColumn Header="预赛&#10;组数" Binding="{Binding PrelimHeats}" Width="55"
                                                CellStyle="{StaticResource PrelimCellStyle}" HeaderStyle="{StaticResource PrelimHdrStyle}"/>
                            <DataGridTextColumn Header="预赛&#10;录取" Binding="{Binding PrelimCutoff}" Width="55"
                                                CellStyle="{StaticResource PrelimCellStyle}" HeaderStyle="{StaticResource PrelimHdrStyle}"/>
                            <!-- 次/复赛 (橙) -->
                            <DataGridTextColumn Header="次/复赛&#10;组数" Binding="{Binding QuarterHeats}" Width="60"
                                                CellStyle="{StaticResource QuarterCellStyle}" HeaderStyle="{StaticResource QuarterHdrStyle}"/>
                            <DataGridTextColumn Header="次/复赛&#10;录取" Binding="{Binding QuarterCutoff}" Width="60"
                                                CellStyle="{StaticResource QuarterCellStyle}" HeaderStyle="{StaticResource QuarterHdrStyle}"/>
                            <!-- 半决赛 (紫) -->
                            <DataGridTextColumn Header="半决赛&#10;组数" Binding="{Binding SemiHeats}" Width="55"
                                                CellStyle="{StaticResource SemiCellStyle}" HeaderStyle="{StaticResource SemiHdrStyle}"/>
                            <DataGridTextColumn Header="半决赛&#10;录取" Binding="{Binding SemiCutoff}" Width="55"
                                                CellStyle="{StaticResource SemiCellStyle}" HeaderStyle="{StaticResource SemiHdrStyle}"/>
                            <!-- 决赛 (绿) -->
                            <DataGridTextColumn Header="决赛&#10;组数" Binding="{Binding FinalHeats}" Width="55"
                                                CellStyle="{StaticResource FinalCellStyle}" HeaderStyle="{StaticResource FinalHdrStyle}"/>
                            <DataGridTextColumn Header="决赛&#10;录取" Binding="{Binding FinalCutoff}" Width="55"
                                                CellStyle="{StaticResource FinalCellStyle}" HeaderStyle="{StaticResource FinalHdrStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                            CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <TextBlock Foreground="#92400E" FontSize="12" TextWrapping="Wrap">
                            <Run FontWeight="Bold">提示：</Run>
                            1. 点击 「自动统计赛次」 按报名人数自动算每项目的轮次结构与组数。
                            2. 4 个赛次的「组数 / 录取」单元格可手动修改覆盖自动结果。
                            3. 取消开设某赛次：将该赛次的组数和录取都清 0 或留空即可。
                            4. 调整完点击右下「下一步」进入日程编排。
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- ═══ Tab 2: 赛次设置方法 ═══ -->
                <Grid x:Name="Tab2Panel" Visibility="Collapsed" Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="800">
                            <TextBlock Text="赛次设置方法（按 World Aquatics SW 3.1.1）" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,12"/>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#22C55E" Text="① 开设 1 个轮次（决赛）"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0">
                                        ≤ 8 人或不需要预赛的项目，直接决赛。仅填「决赛-组数」和「决赛-录取」。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#3B82F6" Text="② 开设 2 个轮次（预赛 + 决赛）"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0">
                                        9-16 人 短距离 + 中长距离 / 接力 标准流程。预赛取前 8 名 → A 组决赛（可勾选 B 组决赛取 9-16 名）。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Text="③ 开设 3 个轮次（预赛 + 半决赛 + 决赛）"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0">
                                        ≥ 17 人 短距离项目（50/100/200 米）标准流程。预赛取前 16 → 半决赛 2 组取前 8 → 决赛 1 组。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#8B5CF6" Text="④ 开设 4 个轮次（预赛 + 次复赛 + 半决赛 + 决赛）"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0">
                                        大型赛事（如奥运 / 世锦赛）级别使用，超过 32 人时启用。中小赛事很少用到。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,8,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#991B1B" Text="🚫 取消开设某个项目"/>
                                    <TextBlock FontSize="12" Foreground="#7F1D1D" TextWrapping="Wrap" Margin="0,4,0,0">
                                        删除该项目所有赛次的「组数」和「录取」即可（清 0 或留空）。
                                        Tab 1 自动统计时该项目会被跳过，不进入秩序册。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="#DBEAFE" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,8,0,10">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#1E40AF" Text="🏊 长距离 800 / 1500 米自由泳"/>
                                    <TextBlock FontSize="12" Foreground="#1E3A8A" TextWrapping="Wrap" Margin="0,4,0,0">
                                        FINA SW 3.1.1.6 ─ 不设预赛，所有报名者直接决赛阶段，按成绩切「快组（晚间）」+ 「慢组（白天）」，
                                        成绩合并排名。Tab 1 会自动识别这两项目并只填决赛组数 / 录取，预赛留空。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ═══ Tab 3: 双面板日程编排器 ═══ -->
                <Grid x:Name="Tab3Panel" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部状态行 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="待分配项目: " VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock x:Name="DistPendingText" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#EF4444" Margin="2,0,12,0"/>
                            <TextBlock Text="排序方式:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="DistSortCombo" Width="120" VerticalAlignment="Center" SelectionChanged="DistSort_Changed">
                                <ComboBoxItem Content="按比赛项目" IsSelected="True"/>
                                <ComboBoxItem Content="按比赛组别"/>
                                <ComboBoxItem Content="按赛次"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="已分配项目: " VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock x:Name="DistAssignedText" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#22C55E" Margin="2,0,12,0"/>
                            <TextBlock Text="日期:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="DistDayCombo" Width="120" VerticalAlignment="Center" SelectionChanged="DistDay_Changed"/>
                            <TextBlock Text="时段:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox x:Name="DistSessionCombo" Width="80" VerticalAlignment="Center" SelectionChanged="DistSession_Changed">
                                <ComboBoxItem Content="上午" IsSelected="True"/>
                                <ComboBoxItem Content="下午"/>
                                <ComboBoxItem Content="晚上"/>
                            </ComboBox>
                            <!-- 2026-05-25 开始时间输入 — 输入完按回车 / 失焦即重算右侧表的所有比赛时间 -->
                            <TextBlock Text="开始时间:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="DistStartTimeBox" Width="80" VerticalAlignment="Center" Padding="3"
                                     ToolTip="如 08:30 / 13:00 / 19:00；输入后按回车自动重算该时段全部比赛时间"
                                     KeyDown="DistStartTime_KeyDown" LostFocus="DistStartTime_LostFocus"/>
                        </StackPanel>
                    </Grid>

                    <!-- 主区：左面板 + 中间按钮 + 右面板 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左面板：待分配 -->
                        <DataGrid x:Name="DistPendingGrid" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" SelectionMode="Extended" AlternatingRowBackground="#F8FAFC">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="组别" Binding="{Binding AgeGroup}" Width="60"/>
                                <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="40"/>
                                <DataGridTextColumn Header="项目" Binding="{Binding EventName}" Width="*"/>
                                <DataGridTextColumn Header="人数" Binding="{Binding ParticipantsLabel}" Width="55"/>
                                <DataGridTextColumn Header="组数" Binding="{Binding Heats}" Width="40"/>
                                <DataGridTextColumn Header="赛次" Binding="{Binding StageDisplay}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 中间按钮组 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                            <Button Content="▲" Click="DistMoveUp_Click" Margin="0,4" Padding="0,8"
                                    Background="#22C55E" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                    ToolTip="添加左边选中项目至右表选中行的上一行"/>
                            <Button Content="▼" Click="DistMoveDown_Click" Margin="0,4" Padding="0,8"
                                    Background="#22C55E" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                    ToolTip="添加左边选中项目至右表选中行的下一行（或追加到末尾）"/>
                            <Button Content="自动" Click="DistAuto_Click" Margin="0,12,0,4" Padding="0,8"
                                    Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                    ToolTip="按默认时段/用时一次性自动分配全部待分配项目"/>
                            <Button Content="←" Click="DistMoveBack_Click" Margin="0,12,0,4" Padding="0,8"
                                    Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                    ToolTip="删除右表选中行的已分配项目（移回待分配）"/>
                            <Button Content="←←" Click="DistMoveBackAll_Click" Margin="0,4" Padding="0,8"
                                    Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                    ToolTip="清空全部已分配项目（移回待分配）"/>
                        </StackPanel>

                        <!-- 右面板：已分配（当前日期+时段内的项目） -->
                        <DataGrid x:Name="DistAssignedGrid" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="False" SelectionMode="Extended" AlternatingRowBackground="#F8FAFC"
                                  CellEditEnding="DistAssignedGrid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding SeqInSession}" Width="40" IsReadOnly="True"/>
                                <DataGridTextColumn Header="组别" Binding="{Binding AgeGroup}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="40" IsReadOnly="True"/>
                                <DataGridTextColumn Header="项目" Binding="{Binding EventName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="人数" Binding="{Binding ParticipantsLabel}" Width="55" IsReadOnly="True"/>
                                <DataGridTextColumn Header="组数" Binding="{Binding Heats}" Width="40" IsReadOnly="True"/>
                                <DataGridTextColumn Header="赛次" Binding="{Binding StageDisplay}" Width="80" IsReadOnly="True"/>
                                <!-- 2026-05-25 分/组红字加粗，便于一眼定位修改 -->
                                <DataGridTextColumn Header="分/组" Binding="{Binding MinPerHeat}" Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- 2026-05-25 比赛时间可手改, 回车后该时段后续项目时间联动重算 -->
                                <DataGridTextColumn Header="比赛时间" Binding="{Binding AssignedTime, UpdateSourceTrigger=PropertyChanged}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1E40AF"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- 底部模式选择 + 生成秩序册 -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="编排模式:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                            <RadioButton x:Name="DistModeAuto" Content="自动区分快决赛" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                                         ToolTip="预赛上午、半决赛下午、决赛晚上（推荐）"/>
                            <RadioButton x:Name="DistModeStrictTime" Content="强制时段模式" VerticalAlignment="Center" Margin="0,0,12,0"
                                         ToolTip="按手动指定的时段强制排列，不区分赛次"/>
                            <RadioButton x:Name="DistModeFinalOnly" Content="强制直接决赛(无预赛)" VerticalAlignment="Center"
                                         ToolTip="把所有项目统一按决赛处理，跳过预赛/半决赛"/>
                        </StackPanel>
                        <Button x:Name="DistApplyBtn" Grid.Column="1" Content="✓ 确认赛程存盘" Click="DistApply_Click"
                                Padding="14,8" Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                ToolTip="把当前编排写回主程序赛程并存盘；若已存在赛程会弹窗确认覆盖"/>
                    </Grid>
                </Grid>

                <!-- ═══ Tab 4: 秩序册可选文档 15 项 ═══ -->
                <Grid x:Name="Tab4Panel" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="勾选要生成的秩序册章节（参考 World Aquatics + 中国体育竞赛传统格式）：" FontSize="13" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DocSectionsPanel">
                            <!-- 15 CheckBoxes 由 .cs 在构造时填充 -->
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="📝 编辑/打印 当前章节" Click="DocEditPrint_Click" Padding="10,5" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0"
                                    ToolTip="生成/重生当前章节文件到 MyDocuments\swim_orderbook\ 持久文件夹，并用 WPS/Office 打开。注意：每次点都会覆盖手工编辑！"/>
                            <Button Content="♻ 强制重生" Click="DocForceRegen_Click" Padding="10,5" Background="#DC2626" Foreground="White" BorderThickness="0"
                                    ToolTip="同样是重生当前章节，但会再次明确确认（适用于已知道会覆盖手工编辑时）"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="📁 全本秩序册（文件夹）" Click="DocGenerate_Click"
                                Padding="14,8" Background="#7C3AED" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                ToolTip="确保 15 个章节文件全部存在（缺的自动生成，已存在的保留用户编辑），然后打开 MyDocuments\swim_orderbook 文件夹便于逐章编辑/打印"/>
                    </Grid>
                </Grid>

                <!-- ═══ Tab 5: 运动员兼项统计 ═══ -->
                <Grid x:Name="Tab5Panel" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="比赛组别:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="MultiEventAgeCombo" Width="120" VerticalAlignment="Center"/>
                        <Button Content="🔍 统计兼项分布" Click="MultiEventCompute_Click"
                                Padding="14,6" Margin="12,0,0,0" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                        <TextBlock x:Name="MultiEventSummaryText" Text="" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#475569"/>
                    </StackPanel>
                    <DataGrid x:Name="MultiEventGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="号码" Binding="{Binding BibNumber}" Width="70"/>
                            <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="100"/>
                            <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="50"/>
                            <DataGridTextColumn Header="代表队" Binding="{Binding Country}" Width="100"/>
                            <DataGridTextColumn Header="个人项目数" Binding="{Binding IndividualCount}" Width="80"/>
                            <DataGridTextColumn Header="接力项目数" Binding="{Binding RelayCount}" Width="80"/>
                            <DataGridTextColumn Header="兼项详情" Binding="{Binding EventList}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="📤 导出 CSV" Click="MultiEventExport_Click"
                                Padding="14,6" Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </Grid>
                </Grid>

            </Grid>

            <!-- 底部按钮栏 -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StatusText" Text="" VerticalAlignment="Center"
                               Foreground="#475569" FontSize="12"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PrevBtn" Content="◀ 上一步" Click="Prev_Click" Padding="14,8" Margin="0,0,8,0"
                                Background="#94A3B8" Foreground="White" BorderThickness="0" IsEnabled="False"/>
                        <Button x:Name="NextBtn" Content="下一步 ▶" Click="Next_Click" Padding="14,8" Margin="0,0,8,0"
                                Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                        <Button x:Name="CloseBtn" Content="关闭" Click="Close_Click" Padding="14,8"
                                Background="#475569" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
