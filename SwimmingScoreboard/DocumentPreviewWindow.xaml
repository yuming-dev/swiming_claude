<Window x:Class="SwimmingScoreboard.DocumentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_DocPreview_Title}"
        Width="1100" Height="780"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E40AF" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText" Text="{DynamicResource Str_Win_DocPreview_Title}" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#E2E8F0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str_Win_DocPreview_OpenBrowserBtn}" Click="OpenBrowser_Click" Background="#0EA5E9"
                        ToolTip="{DynamicResource Str_Win_DocPreview_OpenBrowserTip}"/>
                <Button Content="{DynamicResource Str_Win_DocPreview_ExportPdfBtn}" Click="ExportPdf_Click" Background="#DC2626"
                        ToolTip="{DynamicResource Str_Win_DocPreview_ExportPdfTip}"/>
                <Button Content="{DynamicResource Str_Win_DocPreview_ExportDocBtn}" Click="ExportDoc_Click" Background="#2563EB"
                        ToolTip="{DynamicResource Str_Win_DocPreview_ExportDocTip}"/>
                <Button Content="{DynamicResource Str_Win_DocPreview_ExportHtmlBtn}" Click="ExportHtml_Click" Background="#7C3AED"
                        ToolTip="{DynamicResource Str_Win_DocPreview_ExportHtmlTip}"/>
                <Button Content="{DynamicResource Str_Win_DocPreview_PrintBtn}" Click="Print_Click" Background="#22C55E"
                        ToolTip="{DynamicResource Str_Win_DocPreview_PrintTip}"/>
                <Button Content="{DynamicResource Str_Btn_Close}" Click="Close_Click" Background="#475569"/>
            </StackPanel>
        </Border>

        <!-- 2026-05-25 取消「编辑源码 (HTML)」Tab; HtmlEditor 保留为隐藏控件以便 code-behind 取 HTML 内容 -->
        <Grid Margin="10">
            <WebBrowser x:Name="Preview" />
            <TextBox x:Name="HtmlEditor" Visibility="Collapsed" Width="0" Height="0"/>
        </Grid>
    </DockPanel>
</Window>
