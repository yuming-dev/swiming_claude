<Window x:Class="SwimmingScoreboard.HeatImportPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_HeatImport_Title}"
        Width="520" Height="260"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        ResizeMode="NoResize">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Background="#0EA5E9" Padding="14,10" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Str_Win_HeatImport_Header}" Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" Padding="20,7" Margin="6,0,0,0" Background="#94A3B8" Foreground="White" BorderThickness="0"/>
            <Button Content="{DynamicResource Str_Win_HeatImport_Start}" Click="Ok_Click" Padding="20,7" Margin="6,0,0,0" Background="#22C55E" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#475569" FontSize="13" Margin="0,0,0,12">
                <Run Text="{DynamicResource Str_Win_HeatImport_Intro1}"/><LineBreak/>
                <Run Text="{DynamicResource Str_Win_HeatImport_Intro2}"/>
            </TextBlock>
            <CheckBox x:Name="AutoRegisterBox" IsChecked="True" FontSize="13" Margin="0,4,0,0">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{DynamicResource Str_Win_HeatImport_AutoRegTitle}" FontWeight="Bold"/>
                    <LineBreak/>
                    <Run Text="{DynamicResource Str_Win_HeatImport_AutoRegDesc}"
                         Foreground="#64748B" FontSize="11"/>
                </TextBlock>
            </CheckBox>
        </StackPanel>
    </DockPanel>
</Window>
