<Window x:Class="SwimmingScoreboard.EditRelayTeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_EditRelay_Title}" Width="540" Height="600"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{DynamicResource Str_Win_EditRelay_Title}" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,12"/>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Win_EditRelay_TeamNameLabel}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TeamNameBox" Padding="4" Margin="0,4,0,4"
                                 TextChanged="ValidateAll" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_Win_EditRelay_UnitLabel}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CountryBox" Padding="4" Margin="0,4,0,4"
                                  IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  ToolTip="{DynamicResource Str_Win_EditRelay_UnitTip}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_Win_EditRelay_EventLabel}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EventBox" Padding="4" Margin="0,4,0,4"
                                  SelectionChanged="ValidateAll"
                                  ToolTip="{DynamicResource Str_Win_EditRelay_EventTip}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Str_Win_EditRelay_AgeGroupLabel}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="AgeGroupBox" Padding="4" Margin="0,4,0,4"
                                  SelectionChanged="ValidateAll"
                                  ToolTip="{DynamicResource Str_Win_EditRelay_AgeGroupTip}"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Str_Win_EditRelay_GenderLabel}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        <!-- 2026-08-21 性别项改由构造函数按比赛档案的"性别"表填充。
                             原来写死 男/女/混合 三项，本届"男女"接力队打开后一项都选不中，
                             会被兜底逻辑 SelectedIndex=0 默默改成"男"，一保存数据就坏了。 -->
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="GenderBox" Padding="4" Margin="0,4,0,4"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Str_Win_EditRelay_EntryTimeLabel}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="EntryTimeBox" Padding="4" Margin="0,4,0,4"
                                 ToolTip="{DynamicResource Str_Win_EditRelay_EntryTimeTip}"/>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Win_EditRelay_LegsHeader}" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Win_EditRelay_Leg1Label}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="Leg1Box" Padding="4" Margin="0,4,0,4" TextChanged="ValidateAll"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_Win_EditRelay_Leg2Label}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="Leg2Box" Padding="4" Margin="0,4,0,4" TextChanged="ValidateAll"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_Win_EditRelay_Leg3Label}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="Leg3Box" Padding="4" Margin="0,4,0,4" TextChanged="ValidateAll"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Str_Win_EditRelay_Leg4Label}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="Leg4Box" Padding="4" Margin="0,4,0,4" TextChanged="ValidateAll"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 校验提示条 -->
        <Border Grid.Row="2" x:Name="ValidationBar" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,4,0,8" Visibility="Collapsed">
            <TextBlock x:Name="ValidationText" Foreground="#991B1B" FontSize="12"/>
        </Border>

        <!-- 双按钮 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"
                       Text="{DynamicResource Str_Win_EditRelay_FooterNote}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SaveBtn" Content="{DynamicResource Str_Win_EditRelay_SaveBtn}" Click="Save_Click" Padding="16,7" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0" IsEnabled="False"/>
                <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" Padding="16,7"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
