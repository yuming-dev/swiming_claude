<Window x:Class="SwimmingScoreboard.EditRelayTeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑接力队信息" Width="540" Height="600"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="编辑接力队信息" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,12"/>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="队名 *:" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TeamNameBox" Padding="4" Margin="0,4,0,4"
                                 TextChanged="ValidateAll" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="单位 *:" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CountryBox" Padding="4" Margin="0,4,0,4"
                                  IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                  ToolTip="可输入新单位；与队名可同可不同"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="项目 *:" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EventBox" Padding="4" Margin="0,4,0,4"
                                  SelectionChanged="ValidateAll"
                                  ToolTip="只列出含「接力」的赛事项目"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="性别:" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="GenderBox" Padding="4" Margin="0,4,0,4">
                            <ComboBoxItem Content="男"/>
                            <ComboBoxItem Content="女"/>
                            <ComboBoxItem Content="混合"/>
                        </ComboBox>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="报名成绩:" VerticalAlignment="Center" Margin="0,4,0,4"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="EntryTimeBox" Padding="4" Margin="0,4,0,4"
                                 ToolTip="如 3:42.50 或 222.50"/>
                    </Grid>
                </Border>

                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="4 棒队员姓名" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="第 1 棒 *:" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="Leg1Box" Padding="4" Margin="0,4,0,4" TextChanged="ValidateAll"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="第 2 棒 *:" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="Leg2Box" Padding="4" Margin="0,4,0,4" TextChanged="ValidateAll"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="第 3 棒 *:" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="Leg3Box" Padding="4" Margin="0,4,0,4" TextChanged="ValidateAll"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="第 4 棒 *:" VerticalAlignment="Center" Margin="0,4,0,4"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="Leg4Box" Padding="4" Margin="0,4,0,4" TextChanged="ValidateAll"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 校验提示条 -->
        <Border Grid.Row="2" x:Name="ValidationBar" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,4,0,8" Visibility="Collapsed">
            <TextBlock x:Name="ValidationText" Foreground="#991B1B" FontSize="12"/>
        </Border>

        <!-- 双按钮 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"
                       Text="* 必填字段；保存前会弹出二次确认"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SaveBtn" Content="✓ 保存修改" Click="Save_Click" Padding="16,7" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0" IsEnabled="False"/>
                <Button Content="取消" Click="Cancel_Click" Padding="16,7"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
