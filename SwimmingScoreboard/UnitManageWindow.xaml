<Window x:Class="SwimmingScoreboard.UnitManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="参赛单位管理" Width="980" Height="600"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="参赛单位管理" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Text="" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#475569" FontSize="12"/>
            <Button Content="+ 新增" Click="Add_Click" Padding="10,4" Margin="20,0,0,0"
                    Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Content="× 删除" Click="Delete_Click" Padding="10,4" Margin="6,0,0,0"
                    Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Content="🔄 从报名表自动补全" Click="AutoFill_Click" Padding="10,4" Margin="6,0,0,0"
                    Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    ToolTip="扫描运动员的代表队字段，没有 Unit 条目的自动补一条空白记录"/>
            <Button Content="📤 导出 CSV" Click="ExportCsv_Click" Padding="10,4" Margin="6,0,0,0"
                    Background="#64748B" Foreground="White" BorderThickness="0"/>
            <Button Content="📥 导入 CSV" Click="ImportCsv_Click" Padding="10,4" Margin="6,0,0,0"
                    Background="#64748B" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <DataGrid x:Name="UnitGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="单位名称" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="简称" Binding="{Binding ShortName}" Width="70"/>
                <DataGridTextColumn Header="领队" Binding="{Binding Leader}" Width="70"/>
                <DataGridTextColumn Header="教练" Binding="{Binding Coach}" Width="70"/>
                <DataGridTextColumn Header="队医" Binding="{Binding Doctor}" Width="70"/>
                <DataGridTextColumn Header="基础分" Binding="{Binding BasePoints}" Width="55"/>
                <DataGridTextColumn Header="联系电话" Binding="{Binding Phone}" Width="100"/>
                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="150"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"
                       Text="说明: 单位名称要与运动员资料里的「代表队」字段保持一致，元信息会被报告窗口拉取（公告 / 秩序册 header）"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="✓ 保存" Click="Save_Click" Padding="14,6" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="取消" Click="Cancel_Click" Padding="14,6"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
