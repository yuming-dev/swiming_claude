<Window x:Class="SwimmingScoreboard.UnitManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_UnitMgmt_Title}" Width="980" Height="600"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Str_Win_UnitMgmt_Title}" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Text="" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#475569" FontSize="12"/>
            <Button Content="{DynamicResource Str_Win_UnitMgmt_AddBtn}" Click="Add_Click" Padding="10,4" Margin="20,0,0,0"
                    Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Content="{DynamicResource Str_Win_UnitMgmt_DeleteBtn}" Click="Delete_Click" Padding="10,4" Margin="6,0,0,0"
                    Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Content="{DynamicResource Str_Win_UnitMgmt_AutoFillBtn}" Click="AutoFill_Click" Padding="10,4" Margin="6,0,0,0"
                    Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    ToolTip="{DynamicResource Str_Win_UnitMgmt_AutoFillTip}"/>
            <Button Content="{DynamicResource Str_Btn_ExportCsv}" Click="ExportCsv_Click" Padding="10,4" Margin="6,0,0,0"
                    Background="#64748B" Foreground="White" BorderThickness="0"/>
            <Button Content="{DynamicResource Str_Btn_ImportCsv}" Click="ImportCsv_Click" Padding="10,4" Margin="6,0,0,0"
                    Background="#64748B" Foreground="White" BorderThickness="0"/>
            <Button Content="{DynamicResource Str_Btn_EditInExcel}" Click="EditInExcel_Click" Padding="10,4" Margin="14,0,0,0"
                    Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    ToolTip="{DynamicResource Str_Win_UnitMgmt_EditInExcelTip}"/>
        </StackPanel>

        <DataGrid x:Name="UnitGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Width="150"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_UnitMgmt_ColName}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Name"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Abbr}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="ShortName"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_UnitMgmt_ColLeader}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Leader"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_UnitMgmt_ColCoach}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Coach"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_UnitMgmt_ColDoctor}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Doctor"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="55"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_UnitMgmt_ColBasePoints}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="BasePoints"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="100"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Phone}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Phone"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="150"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_UnitMgmt_ColAddress}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Address"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Notes}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Note"/></DataGridTextColumn.Binding></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"
                       Text="{DynamicResource Str_Win_UnitMgmt_FooterNote}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Str_Win_EvtDur_SaveBtn}" Click="Save_Click" Padding="14,6" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" Padding="14,6"
                        Background="#64748B" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
