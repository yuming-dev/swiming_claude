<Window x:Class="SwimmingScoreboard.EventTop8Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_EventTop8_Title}" Width="1280" Height="640"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource Str_Win_IndiRank_AgeGroupLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="AgeGroupCombo" Width="120" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Str_Win_StaffMgmt_FilterGroupLabel}" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="GenderCombo" Width="70" VerticalAlignment="Center">
                <ComboBoxItem Content="全部" IsSelected="True"/>
                <!-- 2026-08-21 改由 MainWindow.FillGenderCombo 按比赛档案的性别表填 -->
            </ComboBox>
            <TextBlock Text="{DynamicResource Str_Win_EventTop8_DisplayLabel}" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="DisplayCombo" Width="160" VerticalAlignment="Center">
                <ComboBoxItem Content="{DynamicResource Str_Win_EventTop8_DisplayNameTeam}" IsSelected="True"/>
                <ComboBoxItem Content="{DynamicResource Str_Col_Team}"/>
                <ComboBoxItem Content="{DynamicResource Str_Col_Name}"/>
                <ComboBoxItem Content="{DynamicResource Str_Win_EventTop8_DisplayNameTime}"/>
            </ComboBox>
            <Button Content="{DynamicResource Str_Win_IndiRank_ComputeBtn}" Click="Compute_Click" Padding="12,4" Margin="12,0,0,0"
                    Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <TextBlock x:Name="SummaryText" Text="" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#475569"/>
        </StackPanel>

        <DataGrid x:Name="Top8Grid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Width="65"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Group}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="AgeGroup"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="40"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Sex}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Gender"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="140"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_AwardCert_ColEvent}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="EventName"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EventTop8_ColRank1}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="R1"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EventTop8_ColRank2}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="R2"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EventTop8_ColRank3}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="R3"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EventTop8_ColRank4}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="R4"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EventTop8_ColRank5}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="R5"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EventTop8_ColRank6}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="R6"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EventTop8_ColRank7}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="R7"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="110"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_EventTop8_ColRank8}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="R8"/></DataGridTextColumn.Binding></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"
                       Text="{DynamicResource Str_Win_EventTop8_FooterNote}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Str_Win_StaffMgmt_ExportCsvBtn}" Click="ExportCsv_Click" Padding="12,4" Margin="0,0,8,0"
                        Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Win_IndiRank_PrintHtmlBtn}" Click="PrintHtml_Click" Padding="12,4" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="{DynamicResource Str_Btn_Close}" Click="Close_Click" Padding="16,4"
                        Background="#475569" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
