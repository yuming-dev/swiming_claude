<Window x:Class="SwimmingScoreboard.EventTop8Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目成绩统计 — 各项第 1-8 名" Width="1280" Height="640"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="比赛组别:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="AgeGroupCombo" Width="120" VerticalAlignment="Center"/>
            <TextBlock Text="性别:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="GenderCombo" Width="70" VerticalAlignment="Center">
                <ComboBoxItem Content="全部" IsSelected="True"/>
                <ComboBoxItem Content="男"/>
                <ComboBoxItem Content="女"/>
            </ComboBox>
            <TextBlock Text="统计内容:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <ComboBox x:Name="DisplayCombo" Width="160" VerticalAlignment="Center">
                <ComboBoxItem Content="姓名 (代表队)" IsSelected="True"/>
                <ComboBoxItem Content="代表队"/>
                <ComboBoxItem Content="姓名"/>
                <ComboBoxItem Content="姓名 + 成绩"/>
            </ComboBox>
            <Button Content="🔍 统计" Click="Compute_Click" Padding="12,4" Margin="12,0,0,0"
                    Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <TextBlock x:Name="SummaryText" Text="" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#475569"/>
        </StackPanel>

        <DataGrid x:Name="Top8Grid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" AlternatingRowBackground="#F8FAFC" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="组别" Binding="{Binding AgeGroup}" Width="65"/>
                <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="40"/>
                <DataGridTextColumn Header="项目" Binding="{Binding EventName}" Width="140"/>
                <DataGridTextColumn Header="第1名" Binding="{Binding R1}" Width="110"/>
                <DataGridTextColumn Header="第2名" Binding="{Binding R2}" Width="110"/>
                <DataGridTextColumn Header="第3名" Binding="{Binding R3}" Width="110"/>
                <DataGridTextColumn Header="第4名" Binding="{Binding R4}" Width="110"/>
                <DataGridTextColumn Header="第5名" Binding="{Binding R5}" Width="110"/>
                <DataGridTextColumn Header="第6名" Binding="{Binding R6}" Width="110"/>
                <DataGridTextColumn Header="第7名" Binding="{Binding R7}" Width="110"/>
                <DataGridTextColumn Header="第8名" Binding="{Binding R8}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"
                       Text="说明：以决赛阶段名次为准；DSQ/DNS/DNF 不入榜；并列名次在同一格"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📤 导出 CSV" Click="ExportCsv_Click" Padding="12,4" Margin="0,0,8,0"
                        Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="🖨 打印 HTML" Click="PrintHtml_Click" Padding="12,4" Margin="0,0,8,0"
                        Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="关闭" Click="Close_Click" Padding="16,4"
                        Background="#475569" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
