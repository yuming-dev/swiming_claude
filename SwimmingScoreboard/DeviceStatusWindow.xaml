<Window x:Class="SwimmingScoreboard.DeviceStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="设备状态管理" Width="1100" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <x:Array x:Key="StatusOptions" Type="{x:Type sys:String}">
            <sys:String>安装</sys:String>
            <sys:String>未安装</sys:String>
            <sys:String>好</sys:String>
            <sys:String>坏</sys:String>
        </x:Array>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="泳道设备状态管理 (4 态: 安装 / 未安装 / 好 / 坏)" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="灰底列受 比赛泳池(单/双端) 与 盲表数量 配置控制, 此处不可编辑." FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>

        <DataGrid x:Name="DeviceGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False" FontSize="13" RowHeight="36"
                  AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="道次" Binding="{Binding Lane}" Width="50" IsReadOnly="True"/>

                <DataGridTemplateColumn Header="左触板" Width="88">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding LeftTouchpad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LeftEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="左出发台" Width="88">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding LeftStartBlock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LeftEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="左盲1" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding LeftBlindWatch1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LeftEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="左盲2" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding LeftBlindWatch2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LeftEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="左盲3" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding LeftBlindWatch3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LeftEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="右触板" Width="88">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding RightTouchpad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding RightEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="右出发台" Width="88">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding RightStartBlock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding RightEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="右盲1" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding RightBlindWatch1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding RightEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="右盲2" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding RightBlindWatch2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding RightEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="右盲3" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding RightBlindWatch3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding RightEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="全部设为安装"   Click="AllInstalled_Click"   Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="全部设为未安装" Click="AllNotInstalled_Click" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="全部设为好"     Click="AllGood_Click"        Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="全部设为坏"     Click="AllBad_Click"         Padding="14,6" Margin="0,0,16,0"/>
            <Button Content="确定" Click="OK_Click" Padding="16,6" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Content="取消" Click="Cancel_Click" Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
