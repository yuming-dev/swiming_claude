<Window x:Class="SwimmingScoreboard.DeviceStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:SwimmingScoreboard"
        Title="{DynamicResource Str_Win_DeviceStatus_Title}" Width="1100" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <x:Array x:Key="StatusOptions" Type="{x:Type sys:String}">
            <sys:String>安装</sys:String>
            <sys:String>未安装</sys:String>
            <sys:String>好</sys:String>
            <sys:String>坏</sys:String>
        </x:Array>
        <!-- 2026-10-10 StatusOptions/SelectedItem 仍是安装/未安装/好/坏这 4 个中文哨兵值(协议/数据层不变),
             只用 ItemTemplate 转换 ComboBox 下拉项和收起后显示的文字——隐式 Style(不加 x:Key)
             自动套到本窗口全部 10 个状态 ComboBox 上, 不用逐个改。 -->
        <local:DeviceStatusDisplayConverter x:Key="DevStatusConv"/>
        <DataTemplate x:Key="DevStatusItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource DevStatusConv}}"/>
        </DataTemplate>
        <Style TargetType="ComboBox">
            <Setter Property="ItemTemplate" Value="{StaticResource DevStatusItemTemplate}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Str_Win_DeviceStatus_Header}" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource Str_Win_DeviceStatus_GreyNote}" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>

        <DataGrid x:Name="DeviceGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False" FontSize="13" RowHeight="36"
                  AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Width="50" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Lane}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Lane"/></DataGridTextColumn.Binding></DataGridTextColumn>

                <DataGridTemplateColumn Width="88">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Win_DeviceStatus_ColLeftTouchpad}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding LeftTouchpad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LeftEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="88">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Win_DeviceStatus_ColLeftStartBlock}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding LeftStartBlock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LeftEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Win_DeviceStatus_ColLeftBlind1}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding LeftBlindWatch1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LeftEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Win_DeviceStatus_ColLeftBlind2}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding LeftBlindWatch2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LeftEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Win_DeviceStatus_ColLeftBlind3}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding LeftBlindWatch3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding LeftEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="88">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Win_DeviceStatus_ColRightTouchpad}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding RightTouchpad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding RightEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="88">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Win_DeviceStatus_ColRightStartBlock}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding RightStartBlock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding RightEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Win_DeviceStatus_ColRightBlind1}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding RightBlindWatch1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding RightEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Win_DeviceStatus_ColRightBlind2}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding RightBlindWatch2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding RightEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Str_Win_DeviceStatus_ColRightBlind3}"/></DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{StaticResource StatusOptions}"
                                      SelectedItem="{Binding RightBlindWatch3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding RightEnabled}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Str_Win_DeviceStatus_AllInstalledBtn}"   Click="AllInstalled_Click"   Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Str_Win_DeviceStatus_AllNotInstalledBtn}" Click="AllNotInstalled_Click" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Str_Win_DeviceStatus_AllGoodBtn}"     Click="AllGood_Click"        Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Str_Win_DeviceStatus_AllBadBtn}"     Click="AllBad_Click"         Padding="14,6" Margin="0,0,16,0"/>
            <Button Content="{DynamicResource Str_Btn_OK}" Click="OK_Click" Padding="16,6" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click" Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
