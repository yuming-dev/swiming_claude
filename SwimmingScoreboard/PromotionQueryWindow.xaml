<Window x:Class="SwimmingScoreboard.PromotionQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Win_Promotion_Title}" Width="750" Height="550"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 选择条件 -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Str_Win_Promotion_AgeGroupLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="AgeGroupCombo" Width="90" SelectionChanged="AgeGroup_Changed" Margin="0,0,12,0"
                              ToolTip="{DynamicResource Str_Win_Promotion_AgeGroupTip}"/>
                    <TextBlock Text="{DynamicResource Str_Win_StaffMgmt_FilterGroupLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="GenderCombo" Width="70" SelectionChanged="Gender_Changed" Margin="0,0,12,0">
                        <!-- 2026-08-21 改由 MainWindow.FillGenderCombo 按比赛档案的性别表填 -->
                    </ComboBox>
                    <TextBlock Text="{DynamicResource Str_Win_BatchAge_EventLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="EventCombo" Width="180" SelectionChanged="Event_Changed" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Str_Win_BatchAge_StageLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="FromStageCombo" Width="80" SelectionChanged="Stage_Changed" Margin="0,0,12,0"/>
                    <Button Content="{DynamicResource Str_Win_Promotion_QueryBtn}" Click="Query_Click" Padding="16,6"
                            Background="#3B82F6" Foreground="White" BorderThickness="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Str_Win_Promotion_MethodLabel}" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Bold" Foreground="#1E40AF"/>
                    <TextBlock Text="{DynamicResource Str_Win_Promotion_CountLabel}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="CountBox" Width="50" Text="16" Padding="4" VerticalAlignment="Center"/>
                    <!-- 2026-05-23 C3: 启用 B 组决赛（仅在 预赛→决赛 阶段；勾选后晋级人数自动设 16） -->
                    <CheckBox x:Name="EnableBFinalCheck" Content="{DynamicResource Str_Win_Promotion_EnableBFinal}" Margin="20,0,0,0" VerticalAlignment="Center"
                              Checked="EnableBFinal_Changed" Unchecked="EnableBFinal_Changed"
                              ToolTip="{DynamicResource Str_Win_Promotion_EnableBFinalTip}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 信息提示 -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="InfoText" Text="" Foreground="#22C55E" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock x:Name="WarningText" Text="" Foreground="#F87171" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 晋级名单 -->
        <DataGrid x:Name="PromotionGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" AlternatingRowBackground="#F8FAFC" Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Width="45"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Results_ColRank}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Rank"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="55"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_BibNo}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="BibNumber"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="75"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Name}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Name"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_Team}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Country"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="35"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_Promotion_ColHeat}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Heat"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="85"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Col_RecordTime}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Time"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="65"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_BatchAge_ColReactionTime}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Reaction"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="75"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_Promotion_ColMethod}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="Method"/></DataGridTextColumn.Binding></DataGridTextColumn>
                <DataGridTextColumn Width="55"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Str_Win_Promotion_ColToStage}"/></DataGridTextColumn.Header><DataGridTextColumn.Binding><Binding Path="ToStage"/></DataGridTextColumn.Binding></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="ResultText" Text="" Foreground="#22C55E" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <!-- 2026-05-23 C6: 决赛弃权递补 (FINA SW: 弃权者由原排名下一名递补) -->
            <Button Content="{DynamicResource Str_Win_Promotion_CheckSubstitutesBtn}" Click="CheckSubstitutes_Click" Padding="14,8" Margin="0,0,8,0"
                    Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    ToolTip="{DynamicResource Str_Win_Promotion_CheckSubstitutesTip}"/>
            <Button Content="{DynamicResource Str_Win_Promotion_ExecuteBtn}" Click="Execute_Click" Padding="20,8"
                    Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Str_Btn_Close}" Click="Close_Click" Padding="20,8"
                    Background="#475569" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
