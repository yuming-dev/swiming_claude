<Window x:Class="SwimmingScoreboard.CertSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="证书参数设置" Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E293B">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="证书底部落款内容" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="奖状/纪录证书底部左右两侧打印的主办单位与组委会落款，修改后对之后生成的证书生效。" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="2" Text="主办单位：" Foreground="White" Margin="0,0,0,6"/>
        <TextBox x:Name="OrganizerInput" Grid.Row="3" Padding="8,6" FontSize="14" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="4" VerticalAlignment="Top">
            <TextBlock Text="组委会（盖章）：" Foreground="White" Margin="0,0,0,6"/>
            <TextBlock Text="打在证书右下角、印章直接盖上去的落款；留空则自动用「赛事名称＋组织委员会」。内容较长时会自动换行，也可以按回车手动换行。" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBox x:Name="CommitteeInput" Height="110" Padding="8,6" FontSize="14"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <TextBlock x:Name="PreviewText" Grid.Row="5" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确认保存" Click="Confirm_Click" Padding="18,8" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="取消" Click="Cancel_Click" Padding="18,8"/>
        </StackPanel>
    </Grid>
</Window>
