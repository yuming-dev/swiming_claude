<Window x:Class="ScheduleEditor.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_AppTitle_ScheduleEditor}" Height="345" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E293B" WindowStyle="SingleBorderWindow">
    <Grid Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Str_AppTitle_Main}" FontSize="16" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" Text="{DynamicResource Str_LoginWin_SubtitleScheduleEditor}" FontSize="13"
                   Foreground="#94A3B8" HorizontalAlignment="Center"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_LoginWin_Username}" Foreground="#CBD5E1" VerticalAlignment="Center"/>
            <TextBox x:Name="UsernameBox" Grid.Column="1" Padding="8,6" FontSize="14"
                     Background="#334155" Foreground="White" BorderBrush="#475569" BorderThickness="1"
                     CaretBrush="White"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Str_LoginWin_Password}" Foreground="#CBD5E1" VerticalAlignment="Center"/>
            <PasswordBox x:Name="PasswordBox" Grid.Column="1" Padding="8,6" FontSize="14"
                         Background="#334155" Foreground="White" BorderBrush="#475569" BorderThickness="1"/>
        </Grid>

        <CheckBox x:Name="RememberMe" Grid.Row="5" Content="{DynamicResource Str_LoginWin_RememberMe}" Margin="0,10,0,0"
                  Foreground="#CBD5E1" FontSize="12"/>

        <TextBlock x:Name="ErrorText" Grid.Row="6" Text="" Foreground="#F87171"
                   HorizontalAlignment="Center" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>

        <Button Grid.Row="7" Content="{DynamicResource Str_LoginWin_LoginBtn}" Click="Login_Click" Margin="0,10,0,0"
                Background="#3B82F6" Foreground="White" FontSize="15" FontWeight="Bold"
                Padding="0,10" BorderThickness="0"/>
    </Grid>
</Window>
