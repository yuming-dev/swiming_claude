<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="SwimmingTimingSystem.Setup" type="win32"/>
  <!--
    2026-10-08 装机需要管理员权限(写 Program Files、注册 netsh urlacl), 原来一直
    靠 Windows 对"Setup.exe"这类文件名的旧式"安装程序检测"启发式自动提权——这条
    启发式在不少现代 Windows 配置下其实是关着的(策略"检测应用程序安装并提示
    提升"默认就可能是禁用的), 导致 Setup.exe 实际是以普通用户权限跑的, 复制文件
    到 Program Files 能成功是因为装的目录(C:\SwimmingTimingSystem)本身不受 UAC
    虚拟化/写保护管, 但真正需要管理员权限的操作(netsh http add urlacl)会直接静默
    失败——用户实拍到: 重装之后 netsh http show urlacl 查出来还是空的。
    显式声明 requireAdministrator, 不再赌启发式会不会生效。
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 8.1 / 10 / 11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
    </application>
  </compatibility>
</assembly>
